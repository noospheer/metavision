#!/usr/bin/env bash
# metavision-guest-bundle — pack what a CI build needs of the guests, encrypted.
#
# The build runner never sees an APK (the simulator pass gets its data from
# tools/metavision-sim-data instead). It needs, per target, only the guest's
# arm64 libraries (klepton-ld translates them there, mkguest.sh wraps them as
# frameworks), its decoded AndroidManifest.xml (permissions, package), string
# resources (res/values/strings.xml) and signing certificate (META-INF's v1
# block, or the certificate itself for a title signed v2/v3 only), plus the
# generated target table. Assets, OBBs and decoded
# metadata go to the headset's app container at install time, not into the
# build. Guest code is not ours to publish, so the bundle is AES-256 encrypted
# with a passphrase that lives only here and in the repo's secrets.
#
#   tools/metavision-guest-bundle [-o FILE] TARGET...     (mv_ names; 'all' = every target)
#
# Passphrase: $MV_GUEST_KEY, else build/guest-bundle.key (created on first use).
# Inspect without the runner:  openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 \
#                                -pass file:build/guest-bundle.key -in FILE | tar -tz
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
G="$ROOT/build/guests"
OUT="$ROOT/build/guest-bundle.tar.gz.enc"
[ "${1:-}" = "-o" ] && { OUT=$2; shift 2; }
[ $# -gt 0 ] || { sed -n '2,16p' "$0"; exit 2; }
[ -f "$G/targets.json" ] || { echo "run tools/metavision-targets stage && emit first" >&2; exit 1; }

if [ "$1" = all ]; then set -- $(python3 -c "import json;print(' '.join(json.load(open('$G/targets.json'))))"); fi

KEYFILE="$ROOT/build/guest-bundle.key"
if [ -z "${MV_GUEST_KEY:-}" ]; then
    [ -f "$KEYFILE" ] || { umask 077; openssl rand -base64 48 | tr -d '\n' > "$KEYFILE"; echo "new key -> $KEYFILE (add it as the MV_GUEST_KEY secret)" >&2; }
    MV_GUEST_KEY=$(cat "$KEYFILE")
fi

STAGE=$(mktemp -d); trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$STAGE/guests"
cp "$ROOT/build/klepton-targets.py" "$G/targets.json" "$STAGE/guests/"
for t in "$@"; do
    python3 -c "import json,sys; sys.exit(0 if '$t' in json.load(open('$G/targets.json')) else 1)" ||
        { echo "unknown target: $t" >&2; exit 1; }
    [ -d "$G/$t/lib/arm64-v8a" ] || { echo "$t not staged (tools/metavision-targets stage)" >&2; exit 1; }
    mkdir -p "$STAGE/guests/$t/lib"
    cp -a "$G/$t/lib/arm64-v8a" "$STAGE/guests/$t/lib/"
    # The decoded manifest: the launcher reads the title's permissions from it
    # (RECORD_AUDIO arms the microphone) and the workflow masks its package name.
    [ -f "$G/$t/AndroidManifest.xml" ] && cp "$G/$t/AndroidManifest.xml" "$STAGE/guests/$t/"
    # Its decoded string resources: the overlay carries a fixed few of them
    # (an SDK's options baked in at build time) into the launcher catalogue.
    if [ -f "$G/$t/res/values/strings.xml" ]; then
        mkdir -p "$STAGE/guests/$t/res/values"
        cp "$G/$t/res/values/strings.xml" "$STAGE/guests/$t/res/values/"
    fi
    # Its signing certificate: the overlay carries it into the launcher
    # catalogue (PackageInfo.signatures). The v1 signature block when the APK
    # has one; else the certificate out of the APK's v2/v3 signing block, which
    # the runner cannot read itself (it never sees an APK).
    mkdir -p "$STAGE/guests/$t/original/META-INF"
    for f in "$G/$t"/original/META-INF/*.RSA "$G/$t"/original/META-INF/*.DSA "$G/$t"/original/META-INF/*.EC; do
        if [ -f "$f" ]; then cp "$f" "$STAGE/guests/$t/original/META-INF/"; fi
    done
    if ! ls "$STAGE/guests/$t/original/META-INF" | grep -q .; then
        apk=$(python3 -c "import json; print(json.load(open('$G/targets.json'))['$t'].get('apk') or '')")   # relative to $G
        "$ROOT/tools/metavision-apk-cert" -o "$STAGE/guests/$t/original/apk-cert.der" "$G/$t" "$G/$apk" ||
            echo "  ! $t: no signing certificate found" >&2
    fi
    echo "  + $t  ($(du -sh "$G/$t/lib/arm64-v8a" | cut -f1))" >&2
done
printf '%s\n' "$@" > "$STAGE/guests/BUNDLED"

tar -C "$STAGE" -czf - guests |
    openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass "pass:$MV_GUEST_KEY" -out "$OUT"
echo "$OUT ($(du -h "$OUT" | cut -f1), $# target(s))"
