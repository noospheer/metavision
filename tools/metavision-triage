#!/usr/bin/env python3
"""One line per title (and input mode) from a test pass or pulled logs.

    tools/metavision-triage                     the latest `metavision-device test` run
    tools/metavision-triage build/test/<run>    that run
    tools/metavision-triage build/logs          logs from `metavision-device logs --all`

For each run: whether frames reached the display, how it ended (the
unimplemented entry point that stopped it, the fault and where, a library it
could not load, or still running when closed), its most frequent errors, and
how far the scripted input got. verdict() is what `test` records per run:

    pass     drew, ran to the end, no crash, no errors of the kinds below
             (silence included, when the title is quiet by design: it ships
             no audio content, or only short interaction effects)
    silent   drew, no serious error, never made a sound although it ships some
    errors   ran, but logged exceptions, shader/compute failures or a failed load
    black    ran to the end without ever drawing a frame
    stopped  the runtime stopped it (an entry point it does not implement)
    quit     the title closed itself (Application.Quit); the summary names the
             scripted input just before, which is usually what asked for it
    crashed  a fault, a system crash report, or it exited on its own early
"""
import hashlib
import json
import os
import re
import sys
from pathlib import Path

PICTURE = re.compile(r"(\d+) with a picture")
ITERS = re.compile(r"\[cp\] alive: (\d+) iters")
FATAL = re.compile(r"fatal: (.*)")
FAULT = re.compile(r"fault: signal (\d+) at (0x[0-9a-f]+), pc (\S+)")
DLFAIL = re.compile(r'guest dlopen\("([^"]+)"\) FAILED')
# The load guard (overlay step 136): a library whose load killed a launch
# (an uncatchable kill, e.g. code signing) is refused from then on.
GUARDED = re.compile(r"\[dl\] (\S+) (?:killed the previous launch during load|refused: it killed an earlier launch)")
GUARD_ESSENTIAL = re.compile(r"\[dl\] (\S+) was loading when the previous launch died")
START = re.compile(r"^\[hb\] (\S+)")
SHIM = re.compile(r"\[mv-shim\] (.*)")
PLAY = re.compile(r"\[mv-autoplay\] (t=\S+ step \d+: .*)")
# The presser (overlay step 66): elements pressed / found, by family.
COVER = re.compile(r"\[mv-autoplay-ui\] coverage (\d+)/(\d+) \(([^)]*)\)")
PRESSER_ON = "[mv-autoplay-ui] on"
# Why it is not on (overlay step 120), and when it can list only Unity UI.
PRESSER_OFF = re.compile(r"\[mv-autoplay-ui\] off: ([^\n]*)")
PRESSER_NOSCAN = "[mv-autoplay-ui] no scene search"
AUTOPLAY_T = re.compile(r"\[mv-autoplay\] t=([\d.]+)s")
PRESSER_FROM = 10          # MV_AUTOPLAY_UI_FROM's default: the presser's first look, in seconds
UNITY_E = re.compile(r"^E/Unity: (.*)", re.M)
QUIT = re.compile(r"^\[guest\] the title quit:", re.M)
HANDS = "[mv-hands] the title reads hand state"
# Errors that mean something visibly does not work, not just noise.
SERIOUS = re.compile(r"Exception|GLSL compilation failed|Kernel at index|Shader error|"
                     r"Failed to (create|compile|load)|is not supported|shader compiler platform", re.I)
AUDIO = re.compile(r"guest PCM so far: peak (\d+)/")
SHOT = re.compile(r"\[mv-shot\] (shot_\d+\.png) mean (\d+) spread (\d+|nan) lit (\d+)%(?: detail ([\d.]+)%)?(?: see-through (\d+)%)?")
# The compositor's see-through mode, on while a title's passthrough layer runs.
PT_ON = re.compile(r"\[passthrough\] on\b")
# GLES compute and storage buffers (ES 3.1) are not available on the ES 3.0
# context: Unity's compute shaders come back as shader 0 ("no infolog") and its
# std430 blocks do not compile. A known limitation, reported, not an error.
GLES_COMPUTE = re.compile(r"GLSL compilation failed, no infolog provided|'std430' : invalid layout qualifier")
# A movie the runtime could not open (the player answered setDataSource false).
MEDIA_FAIL = re.compile(r"MediaPlayer14: could not open (\S+)|\[avdec\] (?:cannot open the container (\S+?):|(\S+) carries no video track)")
# A Java method the title called with no host implementation: (class, method).
NOHOST = re.compile(r"^\[jni\] no host implementation for ([\w/$]+)\.(\w+|<init>)\(", re.M)
# The title asked for passthrough, which is not available: a black background is by design.
PASSTHROUGH = re.compile(r"Failed to initialize Insight Passthrough|doesn't support XR_FB_passthrough")
# The title records (the microphone is an input it reacts to).
RECORDS = re.compile(r"\[sl\] record state -> RECORDING|openStream\(INPUT|\[aaudio\][^\n]*INPUT")


RUNTIME_LIBS = {"libvulkan.so", "libvulkan.so.1", "libEGL.so", "libGLESv2.so", "libGLESv3.so", "libOpenSLES.so",
                "libaaudio.so", "libmediandk.so", "libandroid.so", "liblog.so"}
# Unity logs a GUID mismatch for a patch OBB that does not exist ("got ''")
# after the main OBB matched: the patch is optional.
BENIGN = re.compile(r"OBB has mismatching GUID.*got ''")


def guest_dir(d: Path):
    """The title's unpacked APK (build/guests/<title>) for a run directory, or None."""
    for p in [d, *d.parents]:
        if p.name.startswith("mv_"):
            g = Path(__file__).resolve().parent.parent / "build" / "guests" / p.name
            return g if g.is_dir() else None
    return None


def shipped_libs(d: Path):
    """The title's own .so names (build/guests/<title>/lib/arm64-v8a), or None."""
    g = guest_dir(d)
    lib = g / "lib" / "arm64-v8a" if g else None
    return {x.name for x in lib.glob("*.so")} if lib and lib.is_dir() else None


# What a title can play without being asked: sound files and banks it ships
# (FMOD .bank/.fsb, Wwise .bnk/.wem/.pck, plain audio), videos (which may
# carry a soundtrack), and, for Unity, its AudioClips and the soundtracks of
# VideoClips a VideoPlayer actually sends somewhere — in the APK and in any
# expansion OBB it reads its data from.
AUDIO_FILES = (".mp3", ".ogg", ".wav", ".m4a", ".aac", ".flac", ".opus",
               ".bank", ".fsb", ".bnk", ".wem", ".pck")
VIDEO_FILES = (".mp4", ".m4v", ".mov", ".webm", ".mkv")
# A middleware sound engine the title links: its banks can hide inside Unity
# assets (FMOD's "bank as TextAsset" mode), so with no bank file seen, its
# sound content cannot be told from the data.
AUDIO_ENGINES = re.compile(r"fmodstudio|AkSoundEngine|wwise", re.I)
# Clips this short are effects (a click, a whoosh, a pinch), played on an
# interaction the scripted input may never make — not music or ambience.
SHORT_CLIP_S = 2.0
AUDIO_SCAN_V = 2


def title_obbs(g: Path):
    """The expansion OBBs pulled for this title (pull/<package>/obb/*.obb)."""
    m = re.search(r'package="([^"]+)"', (g / "AndroidManifest.xml").read_text(errors="replace")) \
        if (g / "AndroidManifest.xml").is_file() else None
    obb = g.parent.parent.parent / "pull" / m.group(1) / "obb" if m else None
    return sorted(obb.glob("*.obb")) if obb and obb.is_dir() else []


def audio_content(d: Path):
    """The audio a title ships, from its unpacked APK and OBBs: {"files":
    [...], "videos": n, "clips": n, "longest": s, "video_audio": n,
    "engines": [...]}; None when it cannot be told (no unpacked APK, not a
    Unity title, data in an OBB that was not pulled, or UnityPy missing).
    Cached next to the unpacked APK (build/guests/<title>.audio.json)."""
    import zipfile
    g = guest_dir(d)
    assets = g / "assets" if g else None
    if not assets or not (assets / "bin" / "Data").is_dir():
        return None
    entries = []
    for root, _, fs in os.walk(assets):
        for f in fs:
            st = os.stat(os.path.join(root, f))
            entries.append((os.path.relpath(os.path.join(root, f), assets), st.st_size, int(st.st_mtime)))
    obbs = title_obbs(g)
    if (assets / "unity_obb_guid").is_file() and not obbs:
        return None                                  # its data lives in an OBB we do not have
    libs = sorted(shipped_libs(d) or ())
    sig = hashlib.sha1(repr((AUDIO_SCAN_V, sorted(entries), libs,
                             [(o.name, o.stat().st_size, int(o.stat().st_mtime)) for o in obbs])).encode()).hexdigest()
    cache = g.parent / f"{g.name}.audio.json"
    try:
        c = json.loads(cache.read_text())
        if c.get("sig") == sig:
            return c["info"]
    except Exception:
        pass
    try:
        import UnityPy
    except ImportError:
        return None
    names = [e[0] for e in entries]
    try:
        env = UnityPy.Environment()
        env.load_folder(str(assets))
        for o in obbs:
            names += zipfile.ZipFile(o).namelist()
            env.load_zip_file(str(o))
    except Exception:
        return None
    info = {"files": sorted({n.rsplit("/", 1)[-1] for n in names if n.lower().endswith(AUDIO_FILES)}),
            "videos": sum(1 for n in names if n.lower().endswith(VIDEO_FILES)),
            "clips": 0, "longest": 0.0, "video_audio": 0,
            "engines": [x for x in libs if AUDIO_ENGINES.search(x)]}
    vclips_audio = players = players_audio = 0
    try:
        for o in env.objects:
            n = o.type.name
            if n == "AudioClip":
                info["clips"] += 1
                try:
                    length = float(o.read().m_Length or 0)
                except Exception:
                    length = 1e9                     # unreadable: assume it is long
                info["longest"] = max(info["longest"], length)
            elif n == "VideoClip":
                try:
                    vclips_audio += bool(o.read_typetree().get("m_AudioChannelCount"))
                except Exception:
                    vclips_audio += 1
            elif n == "VideoPlayer":
                players += 1
                try:
                    tt = o.read_typetree()
                except Exception:
                    players_audio += 1
                    continue
                mode = tt.get("m_AudioOutputMode")   # 0 none, 1 AudioSource, 2 direct, 3 API only
                muted = mode == 2 and all(tt.get("m_DirectAudioMutes") or [True])
                if mode in (1, 2, 3) and tt.get("m_ControlledAudioTrackCount") and not muted:
                    players_audio += 1
    except Exception:
        return None
    # A soundtrack counts when a placed VideoPlayer plays it, or when none is
    # placed (a script makes one, and a new VideoPlayer outputs sound).
    info["video_audio"] = vclips_audio if players_audio or not players else 0
    try:
        cache.write_text(json.dumps({"sig": sig, "info": info}))
    except OSError:
        pass
    return info


def quiet_by_design(info):
    """Why silence is what this title does on its own, or None when it ships
    sound it could be playing (or that cannot be told). Sound made at run
    time from nothing shipped (speech synthesis, a synth in code) is not
    seen here; such a title is quiet by design only until it speaks."""
    if not info or info["files"] or info["videos"] or info["video_audio"] or info.get("engines"):
        return None
    if info["clips"] == 0:
        return "it ships no audio clips, sound banks, audio files or video soundtracks it plays"
    if info["longest"] < SHORT_CLIP_S:
        return (f"its only sounds are {info['clips']} short effect clip(s) (longest "
                f"{info['longest']:.1f} s), played on an interaction")
    return None


def load_failures(text: str, shipped):
    """Libraries that failed to load and matter: the title ships them, or the
    runtime provides them (libvulkan.so). Unity probes a plugin under several
    names, and settings can name a plugin the APK does not carry — misses a
    Quest makes too."""
    failed = [n for n in sorted({m.group(1).rsplit("/", 1)[-1] for m in DLFAIL.finditer(text)})
              if n in RUNTIME_LIBS or shipped is None or n in shipped]
    # Refused by the load guard: shipped by definition (it was loading).
    return failed + [n for n in guarded(text) if n not in failed]


def guarded(text: str):
    """Libraries the load guard refuses: each killed a launch while it loaded."""
    return sorted({m.group(1) for m in GUARDED.finditer(text)})


def unity_errors(text: str, shipped):
    """Unity error lines that count, keyed with numbers folded: not benign, not
    a plugin the APK does not carry (the same on a Quest), not the GLES-compute
    limitation (reported on its own)."""
    errs = {}
    for m in UNITY_E.finditer(text):
        if BENIGN.search(m.group(1)) or GLES_COMPUTE.search(m.group(1)):
            continue
        dll = re.search(r"DllNotFoundException: Unable to load DLL '([^']+)'", m.group(1))
        if dll and shipped is not None and f"lib{dll.group(1)}.so" not in shipped and f"{dll.group(1)}.so" not in shipped:
            continue
        k = re.sub(r"\d+", "N", m.group(1))[:110]
        errs[k] = errs.get(k, 0) + 1
    return errs


def shot_has_content(m) -> bool:
    """A screenshot with a picture: lit and varied, or detailed — a starfield or
    a thin grid is dim but drawn (1.5% of pixels on a sharp edge; controller
    rays alone stay under 1%). With passthrough on, a shot where the title left
    part of the view see-through shows the room there: that is a picture too —
    but not a shot that is all room, where the title drew nothing over it.
    Additive light (particles) is drawn with alpha 0, so a shot that reads 99%
    see-through still counts when it carries detail."""
    if m.group(6) is not None and (1 <= int(m.group(6)) < 99 or float(m.group(5) or 0) >= 0.1):
        return True
    lit_ok = int(m.group(4)) >= 3 and (m.group(3) != "nan" and int(m.group(3)) >= 4)
    return lit_ok or (m.group(5) is not None and float(m.group(5)) >= 1.5)


def triage(d: Path):
    boot = d / "klepton-boot.log"
    if not boot.is_file():
        return None
    text = boot.read_text(errors="replace")
    lines = text.splitlines()
    started = next((m.group(1) for m in map(START.match, lines[:5]) if m), "?")
    pics = max((int(m.group(1)) for m in PICTURE.finditer(text)), default=0)
    # A failed load matters when the title ships that library (or it is one the
    # runtime provides, like libvulkan.so). Unity probes a plugin under several
    # names, and settings can name a plugin the APK does not carry — misses a
    # Quest makes too.
    shipped = shipped_libs(d)
    killers = guarded(text)
    notes = [f"could not load {n}" + (": refused after a killed launch (it was loading when an earlier "
                                       "launch was killed; KL_DLOPEN_GUARD_RESET=1 retries it)" if n in killers else "")
             for n in load_failures(text, shipped)]
    for m in GUARD_ESSENTIAL.finditer(text):
        notes.append(f"the previous launch was killed while loading {m.group(1)} (an engine library: not refused)")
    ending = "running when closed"
    if m := FATAL.search(text):
        ending = "stopped: " + m.group(1).strip()
    errs = unity_errors(text, shipped)
    for k, n in sorted(errs.items(), key=lambda kv: -kv[1])[:3]:
        notes.append(f"Unity error x{n}: {k}")
    shots = list(SHOT.finditer(text))
    if shots:
        dark = [sh for sh in shots if not shot_has_content(sh)]
        if all(int(sh.group(4)) == 0 and float(sh.group(5) or 0) == 0 and int(sh.group(6) or 0) == 0 for sh in shots):
            notes.append(f"BLACK CONTENT: all {len(shots)} screenshot(s) dark or flat")
        elif all(int(sh.group(6) or 0) >= 99 and float(sh.group(5) or 0) < 0.1 for sh in shots):
            notes.append(f"DARK CONTENT: room only — all {len(shots)} screenshot(s) see-through, nothing drawn over passthrough")
        elif len(shots) - len(dark) < 2:
            # Something drawn, but at most one shot with real content: a sparse or
            # dark scene, or only the controllers. Never a pass, never "black".
            notes.append(f"DARK CONTENT: {len(shots) - len(dark)}/{len(shots)} screenshot(s) show content")
        else:
            notes.append(f"screenshots: {len(shots)} ({len(dark)} dark/flat) in this folder")
    if PT_ON.search(text):
        through = [int(sh.group(6)) for sh in shots if sh.group(6) is not None]
        notes.append("passthrough on" + (f": the room shows through {sum(through) // len(through)}% of the view on average" if through else ""))
    elif PASSTHROUGH.search(text):
        notes.append("needs passthrough (not available)")
    if GLES_COMPUTE.search(text):
        notes.append("needs GLES compute (not available): its compute effects are missing")
    # A movie the title opened and the runtime could not: whatever it plays
    # on (a 360 environment, an intro) stays empty — often why a shot is dark.
    failed = sorted({next(g for g in m.groups() if g).rsplit("/", 1)[-1]
                     for m in MEDIA_FAIL.finditer(text)})
    if failed:
        notes.append(f"MEDIA: {len(failed)} movie(s) could not be opened ({', '.join(failed[:2])}"
                     + (", ..." if len(failed) > 2 else "") + ")")
    # Java the title called that the runtime does not implement, by class:
    # names the SDK a missing feature belongs to (a cloud database, a store).
    nohost = {}
    for m in NOHOST.finditer(text):
        nohost.setdefault(m.group(1), set()).add(m.group(2))
    if nohost:
        top = sorted(nohost.items(), key=lambda kv: -len(kv[1]))[:2]
        notes.append(f"unimplemented Java: {sum(len(v) for v in nohost.values())} method(s) in "
                     f"{len(nohost)} class(es), most in " + ", ".join(k for k, _ in top))
    peaks = [int(m.group(1)) for m in AUDIO.finditer(text)]
    if peaks and max(peaks) == 0:
        # Silence is a failure only when the title ships sound to play: one
        # with no audio content, or only short interaction effects, is quiet
        # by design (decided from its data, never its name).
        info = audio_content(d)
        records = RECORDS.search(text)
        if why := quiet_by_design(info):
            notes.append(f"quiet by design: no sound, and none expected — {why}"
                         + ("; it records (the microphone is an input)" if records else ""))
        else:
            ships = ""
            if info:
                parts = [f"{info['clips']} audio clip(s)"
                         + (f" (longest {info['longest']:.0f} s)" if info["clips"] else "")]
                if info["files"]:
                    parts.append(f"{len(info['files'])} sound file(s)/bank(s)")
                if info["videos"] or info["video_audio"]:
                    parts.append(f"{info['videos'] + info['video_audio']} video(s) that may carry sound")
                ships = "; it ships " + ", ".join(parts)
            notes.append("SILENT: the title produced no sound (audio peak 0)" + ships
                         + ("; it records, so sound may be only an input" if records else ""))
    if HANDS in text:
        notes.append("uses hand tracking")
    said = len(re.findall(r'\[mv-autoplay\][^\n]* say "', text))
    if said:
        heard = len(re.findall(r"\[mv\] voice: (?:select|grab|hold|release|confirm|back|menu|recenter)\b", text))
        moves = re.findall(r"\[mv\] voice: (moveForward|moveBack|strafeLeft|strafeRight|turnLeft|turnRight|keepGoing|stop)\b", text)
        left = re.findall(r"\[mv\] voice: (leftSelect|leftGrab|buttonX|buttonY|bothHold)\b", text)
        notes.append(f"speech: {said} phrase(s) said, {heard + len(moves) + len(left)} command(s) recognised"
                     f" ({len(moves)} moving: {len(set(moves))}/8 kinds; {len(left)} left-hand: {len(set(left))}/5 kinds)")
    cyc = re.findall(r"\[mv-autoplay\] t=\S+ mode cycle: (\w+)", text)
    if cyc:
        notes.append("mode cycle reached " + " > ".join(["auto (start)"] + cyc))
    if cov := coverage(text):
        n, m, detail = cov
        notes.append(f"UI coverage {n}/{'?' if m is None else m}" + (f" ({detail})" if detail else "")
                     + ("; no scene search, Unity UI only" if PRESSER_NOSCAN in text else ""))
    elif why := presser_absent(text):
        notes.append(f"UI coverage none, presser {why[0]}: {why[1]}")
    plays = PLAY.findall(text)
    if plays:
        notes.append(f"auto-play reached {plays[-1]}")
    crash = d / "klepton-crash.log"
    if crash.is_file() and (m := FAULT.search(crash.read_text(errors="replace"))):
        ending = f"crashed: signal {m.group(1)} at {m.group(2)}, pc {m.group(3)}"
    for ips in sorted(d.glob("*.ips")):
        try:
            bug = json.loads(ips.read_text(errors="replace").split("\n", 1)[0]).get("bug_type")
        except Exception:
            bug = None
        if bug == "298":                          # JetsamEvent: the system reclaimed memory
            # Only when it killed THIS run: a report pulled alongside can be an
            # earlier process's, so match the pid the log was written by.
            pid = (re.search(r"metavision\[(\d+):", text) or [None, None])[1]
            try:
                procs = json.loads(ips.read_text(errors="replace").split("\n", 1)[1]).get("processes", [])
            except Exception:
                procs = []
            if any(p.get("name") == "metavision" and (pid is None or str(p.get("pid")) == pid)
                   and p.get("reason") for p in procs):
                ending = f"killed: out of memory (jetsam, {ips.name})"
        elif bug in ("309", "109", None):         # a crash (or unreadable: assume one)
            ending = "crashed: " + ips_summary(ips)
        else:                                     # 202 cpu_resource and co.: a diagnostic
            notes.append(f"system diagnostic report ({bug}): {ips.name.split('-')[0]}")
    serious = sum(n for k, n in errs.items() if SERIOUS.search(k))
    top = max(((n, k) for k, n in errs.items() if SERIOUS.search(k)), default=None)
    if top:   # the error that decides an ERRORS verdict, named first
        notes.insert(0, f"serious x{top[0]}: {top[1][:140]}")
    return started, pics, ending, notes, serious


def coverage(text: str):
    """(pressed, found, detail) from the presser's last coverage line; None
    when it did not run. A log from before step 66 has no coverage line: the
    distinct controls it pressed, out of an unknown number found (None)."""
    if cov := COVER.findall(text):
        n, m, detail = cov[-1]
        return int(n), int(m), detail
    if PRESSER_ON not in text:
        return None
    pressed = set(re.findall(r"\[mv-autoplay-ui\] t=\S+ pressed '([^']*)' \(\S+ go=(\S+)", text))
    return (len(pressed), None, "pre-step-66 log: found count not logged") if pressed else \
           (0, 0, "nothing selectable found")


def presser_absent(text: str):
    """Why a run has no coverage line, as (kind, detail): "off" (the presser
    ran and switched itself off), "not reached" (the run ended before its
    first look), "not attached" (not a Unity IL2CPP title, or auto-play off)
    or "silent" (none of these: it never reported). None when it reported."""
    if coverage(text):
        return None
    if m := PRESSER_OFF.search(text):
        return "off", m.group(1).strip()
    if "libUE4" in text:
        return "not attached", "an Unreal title (the presser is for Unity IL2CPP)"
    if "libunity" not in text:
        return "not attached", "not a Unity title"
    if "libil2cpp" not in text:
        return "not attached", "a Unity title without IL2CPP"
    if "[mv-autoplay] on" not in text:
        return "not attached", "auto-play was off"
    end = max((float(t) for t in AUTOPLAY_T.findall(text)), default=0.0)
    if end < PRESSER_FROM:
        return "not reached", f"the run ended at {end:.0f} s, before the presser's first look ({PRESSER_FROM} s)"
    return "silent", "the presser never reported"


def healthy_so_far(text: str, shipped=None, expect_sound=True):
    """Whether a run in progress has already shown everything a pass needs, so
    `test --adaptive` can end it early: at least two screenshots with a picture,
    sound, the input-mode cycle through hands and hands-free, and nothing
    serious — no fault, no fatal stop, no failed library load, no serious Unity
    error. Sound is not waited for when the title is quiet by design
    (expect_sound=False, from quiet_by_design). Returns (ok, what is still missing)."""
    # The same tests triage() applies at the end, so a run ends early only when
    # its final verdict would be a pass.
    if FAULT.search(text) or FATAL.search(text) or load_failures(text, shipped):
        return False, "a fault, stop or failed load"
    if any(SERIOUS.search(k) for k in unity_errors(text, shipped)):
        return False, "a serious error"
    lit = [m for m in SHOT.finditer(text) if shot_has_content(m)]
    if len(lit) < 2 and not re.search(r"\[mv-shot\] eye format \d+ not captured", text):   # no shots to wait for
        return False, "two screenshots with a picture"
    if expect_sound and max((int(m.group(1)) for m in AUDIO.finditer(text)), default=0) == 0:
        return False, "sound"
    cyc = set(re.findall(r"\[mv-autoplay\] t=\S+ mode cycle: (\w+)", text))
    if not {"hands", "handsfree"} <= cyc:
        return False, "the hands and hands-free modes"
    return True, ""


def ips_summary(p: Path):
    """A system crash report (.ips: a JSON header line, then a JSON body)."""
    try:
        body = json.loads(p.read_text(errors="replace").split("\n", 1)[1])
        ex = body.get("exception", {})
        th = body.get("threads", [])[body.get("faultingThread", 0)]
        imgs = body.get("usedImages", [])
        top = []
        for f in th.get("frames", [])[:3]:
            img = imgs[f["imageIndex"]].get("name", "?") if f.get("imageIndex", -1) < len(imgs) else "?"
            top.append(f.get("symbol") or f"{img}+{f.get('imageOffset', 0):#x}")
        term = body.get("termination", {}).get("indicator", "")
        return f"{ex.get('type', '?')} {ex.get('signal', '')} {term} in {' < '.join(top)} ({p.name})".replace("  ", " ")
    except Exception as e:
        return f"system crash report {p.name} ({type(e).__name__})"


def verdict(d: Path, exited=None):
    """What `metavision-device test` records for one run."""
    r = triage(d)
    if r is None:
        return {"verdict": "crashed", "summary": "no log at all: the app did not start", "frames": 0}
    _started, pics, ending, notes, serious = r
    # The compositor ticks whenever the app is in front of a wearer, picture
    # or not: no ticks at all is a headset asleep or off, not a black title.
    log = (d / "klepton-boot.log").read_text(errors="replace")
    iters = max((int(m.group(1)) for m in ITERS.finditer(log)), default=0)
    if ending.startswith(("crashed", "killed")):
        v = "crashed"
    elif m := QUIT.search(log):
        before = [l for l in log[:m.start()].splitlines()
                  if "[mv-autoplay] t=" in l or "[mv-autoplay-ui] t=" in l][-1:]
        v, ending = "quit", "the title quit itself" + (
            " after: " + re.sub(r"^.*?\[mv-autoplay(-ui)?\] ", "", before[0])[:120] if before else "")
    elif "backgrounded — exiting" in log:
        # The app went behind something (the headset taken off, the Home view):
        # a clean exit that says nothing about the title.
        v, ending = "asleep", "sent to the background (headset off, or another app in front)"
    elif ending.startswith("stopped"):
        v = "stopped"
    elif exited is not None:
        v, ending = "crashed", f"exited by itself after {exited} s"
    elif pics == 0 or any(n.startswith("BLACK CONTENT") for n in notes):
        v = "black"
    elif serious or any(n.startswith("could not load") for n in notes):
        v = "errors"    # ahead of dark: a serious error is not hidden behind a dim picture
    elif any(n.startswith("DARK CONTENT") for n in notes):
        v = "dark"
    elif any(n.startswith("SILENT") for n in notes):
        v = "silent"   # drew, no serious error, but never made a sound
    else:
        v = "pass"
    summary = f"{pics} frames, {ending}"
    # The note that decided the verdict comes first in the summary.
    lead = {"errors": ("serious", "could not load"), "silent": ("SILENT",),
            "black": ("BLACK CONTENT",), "dark": ("DARK CONTENT",)}.get(v, ())
    first = [n for n in notes if lead and n.startswith(lead)][:1] or \
            [n for n in notes if n.startswith(("BLACK CONTENT", "SILENT", "could not load", "Unity error"))][:1]
    if first:
        summary += "; " + first[0]
    return {"verdict": v, "summary": summary, "frames": pics, "iters": iters}


def rows_under(base: Path):
    """(label, dir) for every run directory: <title>/ or <title>/<mode>/."""
    out = []
    for d in sorted(base.iterdir()):
        if not d.is_dir():
            continue
        if (d / "klepton-boot.log").is_file() or any(d.glob("*.ips")):
            out.append((d.name, d))
        for m in sorted(x for x in d.iterdir() if x.is_dir()):
            out.append((f"{d.name} ({m.name})", m))
    return out


def main():
    if len(sys.argv) > 1:
        base = Path(sys.argv[1])
    else:
        runs = sorted(p.parent for p in Path("build/test").glob("*/state.json"))
        base = runs[-1] if runs else Path("build/logs")
    state = {}
    if (base / "state.json").is_file():
        state = json.loads((base / "state.json").read_text())["items"]
        print(f"{base}")
    rows = []
    for label, d in rows_under(base):
        r = triage(d)
        if r is None and not list(d.glob("*.ips")):
            continue
        key = f"{d.parent.name}@{d.name}"
        v = verdict(d, exited=state.get(key, {}).get("exited_after"))   # early exits: what the run saw
        rows.append((label, v, r[3] if r else []))
    if not rows:
        sys.exit(f"no logs under {base}: run `metavision-device test` (or `logs --all`) first")
    w = max(len(n) for n, _, _ in rows)
    for label, v, notes in rows:
        print(f"{label:{w}}  {v['verdict'].upper():8} {v['summary']}")
        for n in notes:
            print(f"{'':{w}}  {'':8} {n}")
    texts = [b.read_text(errors="replace") for _, d in rows_under(base) if (b := d / "klepton-boot.log").is_file()]
    covs = [c for t in texts if (c := coverage(t))]
    absent = [a for t in texts if (a := presser_absent(t))]
    if covs or absent:
        known = sum(c[1] for c in covs if c[1] is not None)
        kinds = {}
        for k, _ in absent:
            kinds[k] = kinds.get(k, 0) + 1
        print(f"\nUI coverage: {sum(c[0] for c in covs)}/{known}{'+?' if any(c[1] is None for c in covs) else ''} "
              f"elements pressed; "
              f"{sum(1 for c in covs if c[0])}/{len(covs)} attached runs pressed something, "
              f"{sum(1 for c in covs if c[1] == 0)} found nothing selectable"
              + (f"; {len(absent)} runs without the presser ("
                 + ", ".join(f"{n} {k}" for k, n in sorted(kinds.items())) + ")" if absent else ""))
    counts = {}
    for _, v, _ in rows:
        counts[v["verdict"]] = counts.get(v["verdict"], 0) + 1
    print("\n" + ", ".join(f"{n} {k}" for k, n in sorted(counts.items(), key=lambda kv: -kv[1])))


if __name__ == "__main__":
    main()
