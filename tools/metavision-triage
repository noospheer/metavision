#!/usr/bin/env python3
"""One line per title from the logs pulled with `metavision-device logs --all`.

    tools/metavision-triage [build/logs]

For each title: when it last ran, whether frames reached the display, and how
the run ended — the unimplemented entry point that stopped it, the fault and
where, a library it could not load, or nothing (still running when closed).
"""
import re
import sys
from pathlib import Path

PICTURE = re.compile(r"(\d+) with a picture")
FATAL = re.compile(r"fatal: (.*)")
FAULT = re.compile(r"fault: signal (\d+) at (0x[0-9a-f]+), pc (\S+)")
DLFAIL = re.compile(r'guest dlopen\("([^"]+)"\) FAILED')
START = re.compile(r"^\[hb\] (\S+)")
SHIM = re.compile(r"\[mv-shim\] (.*)")
PLAY = re.compile(r"\[mv-autoplay\] (t=\S+ step \d+: .*)")
UNITY_E = re.compile(r"^E/Unity: (.*)", re.M)


def triage(d: Path):
    boot = d / "klepton-boot.log"
    if not boot.is_file():
        return None
    text = boot.read_text(errors="replace")
    lines = text.splitlines()
    started = next((m.group(1) for m in map(START.match, lines[:5]) if m), "?")
    pics = max((int(m.group(1)) for m in PICTURE.finditer(text)), default=0)
    notes = [f"could not load {n}" for n in sorted({m.group(1) for m in DLFAIL.finditer(text)})]
    ending = "running when closed"
    if m := FATAL.search(text):
        ending = "stopped: " + m.group(1).strip()
    errs = {}
    for m in UNITY_E.finditer(text):
        k = re.sub(r"\d+", "N", m.group(1))[:110]
        errs[k] = errs.get(k, 0) + 1
    for k, n in sorted(errs.items(), key=lambda kv: -kv[1])[:3]:
        notes.append(f"Unity error x{n}: {k}")
    plays = PLAY.findall(text)
    if plays:
        notes.append(f"auto-play reached {plays[-1]}")
    crash = d / "klepton-crash.log"
    if crash.is_file() and (m := FAULT.search(crash.read_text(errors="replace"))):
        ending = f"crashed: signal {m.group(1)} at {m.group(2)}, pc {m.group(3)}"
    return started, pics, ending, notes


def main():
    base = Path(sys.argv[1] if len(sys.argv) > 1 else "build/logs")
    rows = [(d.name, r) for d in sorted(base.iterdir()) if d.is_dir() and (r := triage(d))]
    if not rows:
        sys.exit(f"no logs under {base} — run `metavision-device logs --all` first")
    w = max(len(n) for n, _ in rows)
    for name, (started, pics, ending, notes) in rows:
        state = "picture" if pics else "BLACK  "
        print(f"{name:{w}}  {started:>8}  {state} {pics:>7} frames  {ending}")
        for n in notes:
            print(f"{'':{w}}  {'':>8}  {n}")


if __name__ == "__main__":
    main()
