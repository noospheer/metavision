#!/usr/bin/env python3
"""One line per title (and input mode) from a test pass or pulled logs.

    tools/metavision-triage                     the latest `metavision-device test` run
    tools/metavision-triage build/test/<run>    that run
    tools/metavision-triage build/logs          logs from `metavision-device logs --all`

For each run: whether frames reached the display, how it ended (the
unimplemented entry point that stopped it, the fault and where, a library it
could not load, or still running when closed), its most frequent errors, and
how far the scripted input got. verdict() is what `test` records per run:

    pass     drew, ran to the end, no crash, no errors of the kinds below
    errors   ran, but logged exceptions, shader/compute failures or a failed load
    black    ran to the end without ever drawing a frame
    stopped  the runtime stopped it (an entry point it does not implement)
    crashed  a fault, a system crash report, or it exited on its own early
"""
import json
import re
import sys
from pathlib import Path

PICTURE = re.compile(r"(\d+) with a picture")
ITERS = re.compile(r"\[cp\] alive: (\d+) iters")
FATAL = re.compile(r"fatal: (.*)")
FAULT = re.compile(r"fault: signal (\d+) at (0x[0-9a-f]+), pc (\S+)")
DLFAIL = re.compile(r'guest dlopen\("([^"]+)"\) FAILED')
START = re.compile(r"^\[hb\] (\S+)")
SHIM = re.compile(r"\[mv-shim\] (.*)")
PLAY = re.compile(r"\[mv-autoplay\] (t=\S+ step \d+: .*)")
UNITY_E = re.compile(r"^E/Unity: (.*)", re.M)
HANDS = "[mv-hands] the title reads hand state"
# Errors that mean something visibly does not work, not just noise.
SERIOUS = re.compile(r"Exception|GLSL compilation failed|Kernel at index|Shader error|"
                     r"Failed to (create|compile|load)|is not supported", re.I)


RUNTIME_LIBS = {"libvulkan.so", "libvulkan.so.1", "libEGL.so", "libGLESv2.so", "libGLESv3.so", "libOpenSLES.so",
                "libaaudio.so", "libmediandk.so", "libandroid.so", "liblog.so"}
# Unity logs a GUID mismatch for a patch OBB that does not exist ("got ''")
# after the main OBB matched: the patch is optional.
BENIGN = re.compile(r"OBB has mismatching GUID.*got ''")


def shipped_libs(d: Path):
    """The title's own .so names (build/guests/<title>/lib/arm64-v8a), or None."""
    for p in [d, *d.parents]:
        if p.name.startswith("mv_"):
            lib = Path(__file__).resolve().parent.parent / "build" / "guests" / p.name / "lib" / "arm64-v8a"
            return {x.name for x in lib.glob("*.so")} if lib.is_dir() else None
    return None


def triage(d: Path):
    boot = d / "klepton-boot.log"
    if not boot.is_file():
        return None
    text = boot.read_text(errors="replace")
    lines = text.splitlines()
    started = next((m.group(1) for m in map(START.match, lines[:5]) if m), "?")
    pics = max((int(m.group(1)) for m in PICTURE.finditer(text)), default=0)
    # A failed load matters when the title ships that library (or it is one the
    # runtime provides, like libvulkan.so). Unity probes a plugin under several
    # names, and settings can name a plugin the APK does not carry — misses a
    # Quest makes too.
    shipped = shipped_libs(d)
    notes = []
    for n in sorted({m.group(1).rsplit("/", 1)[-1] for m in DLFAIL.finditer(text)}):
        if n in RUNTIME_LIBS or shipped is None or n in shipped:
            notes.append(f"could not load {n}")
    ending = "running when closed"
    if m := FATAL.search(text):
        ending = "stopped: " + m.group(1).strip()
    errs = {}
    for m in UNITY_E.finditer(text):
        if BENIGN.search(m.group(1)):
            continue
        dll = re.search(r"DllNotFoundException: Unable to load DLL '([^']+)'", m.group(1))
        if dll and shipped is not None and f"lib{dll.group(1)}.so" not in shipped and f"{dll.group(1)}.so" not in shipped:
            continue                  # a plugin the APK does not carry: the same on a Quest
        k = re.sub(r"\d+", "N", m.group(1))[:110]
        errs[k] = errs.get(k, 0) + 1
    for k, n in sorted(errs.items(), key=lambda kv: -kv[1])[:3]:
        notes.append(f"Unity error x{n}: {k}")
    if HANDS in text:
        notes.append("uses hand tracking")
    said = len(re.findall(r'\[mv-autoplay\][^\n]* say "', text))
    if said:
        heard = len(re.findall(r"\[mv\] voice: (?:select|grab|hold|release|confirm|back|menu|recenter)\b", text))
        notes.append(f"speech: {said} phrase(s) said, {heard} command(s) recognised")
    cyc = re.findall(r"\[mv-autoplay\] t=\S+ mode cycle: (\w+)", text)
    if cyc:
        notes.append("mode cycle reached " + " > ".join(["auto (start)"] + cyc))
    plays = PLAY.findall(text)
    if plays:
        notes.append(f"auto-play reached {plays[-1]}")
    crash = d / "klepton-crash.log"
    if crash.is_file() and (m := FAULT.search(crash.read_text(errors="replace"))):
        ending = f"crashed: signal {m.group(1)} at {m.group(2)}, pc {m.group(3)}"
    for ips in sorted(d.glob("*.ips")):
        try:
            bug = json.loads(ips.read_text(errors="replace").split("\n", 1)[0]).get("bug_type")
        except Exception:
            bug = None
        if bug in ("309", "109", None):           # a crash (or unreadable: assume one)
            ending = "crashed: " + ips_summary(ips)
        else:                                     # 202 cpu_resource and co.: a diagnostic
            notes.append(f"system diagnostic report ({bug}): {ips.name.split('-')[0]}")
    serious = sum(n for k, n in errs.items() if SERIOUS.search(k))
    return started, pics, ending, notes, serious


def ips_summary(p: Path):
    """A system crash report (.ips: a JSON header line, then a JSON body)."""
    try:
        body = json.loads(p.read_text(errors="replace").split("\n", 1)[1])
        ex = body.get("exception", {})
        th = body.get("threads", [])[body.get("faultingThread", 0)]
        imgs = body.get("usedImages", [])
        top = []
        for f in th.get("frames", [])[:3]:
            img = imgs[f["imageIndex"]].get("name", "?") if f.get("imageIndex", -1) < len(imgs) else "?"
            top.append(f.get("symbol") or f"{img}+{f.get('imageOffset', 0):#x}")
        term = body.get("termination", {}).get("indicator", "")
        return f"{ex.get('type', '?')} {ex.get('signal', '')} {term} in {' < '.join(top)} ({p.name})".replace("  ", " ")
    except Exception as e:
        return f"system crash report {p.name} ({type(e).__name__})"


def verdict(d: Path, exited=None):
    """What `metavision-device test` records for one run."""
    r = triage(d)
    if r is None:
        return {"verdict": "crashed", "summary": "no log at all: the app did not start", "frames": 0}
    _started, pics, ending, notes, serious = r
    # The compositor ticks whenever the app is in front of a wearer, picture
    # or not: no ticks at all is a headset asleep or off, not a black title.
    iters = max((int(m.group(1)) for m in ITERS.finditer((d / "klepton-boot.log").read_text(errors="replace"))),
                default=0)
    if ending.startswith("crashed"):
        v = "crashed"
    elif ending.startswith("stopped"):
        v = "stopped"
    elif exited is not None:
        v, ending = "crashed", f"exited by itself after {exited} s"
    elif pics == 0:
        v = "black"
    elif serious or any(n.startswith("could not load") for n in notes):
        v = "errors"
    else:
        v = "pass"
    summary = f"{pics} frames, {ending}"
    first = [n for n in notes if n.startswith(("could not load", "Unity error"))][:1]
    if first:
        summary += "; " + first[0]
    return {"verdict": v, "summary": summary, "frames": pics, "iters": iters}


def rows_under(base: Path):
    """(label, dir) for every run directory: <title>/ or <title>/<mode>/."""
    out = []
    for d in sorted(base.iterdir()):
        if not d.is_dir():
            continue
        if (d / "klepton-boot.log").is_file() or any(d.glob("*.ips")):
            out.append((d.name, d))
        for m in sorted(x for x in d.iterdir() if x.is_dir()):
            out.append((f"{d.name} ({m.name})", m))
    return out


def main():
    if len(sys.argv) > 1:
        base = Path(sys.argv[1])
    else:
        runs = sorted(p.parent for p in Path("build/test").glob("*/state.json"))
        base = runs[-1] if runs else Path("build/logs")
    state = {}
    if (base / "state.json").is_file():
        state = json.loads((base / "state.json").read_text())["items"]
        print(f"{base}")
    rows = []
    for label, d in rows_under(base):
        r = triage(d)
        if r is None and not list(d.glob("*.ips")):
            continue
        v = verdict(d)
        key = f"{d.parent.name}@{d.name}"
        if key in state and state[key].get("verdict"):
            v["verdict"] = state[key]["verdict"]          # what the run itself saw (early exits)
            v["summary"] = state[key].get("summary", v["summary"])
        rows.append((label, v, r[3] if r else []))
    if not rows:
        sys.exit(f"no logs under {base}: run `metavision-device test` (or `logs --all`) first")
    w = max(len(n) for n, _, _ in rows)
    for label, v, notes in rows:
        print(f"{label:{w}}  {v['verdict'].upper():8} {v['summary']}")
        for n in notes:
            print(f"{'':{w}}  {'':8} {n}")
    counts = {}
    for _, v, _ in rows:
        counts[v["verdict"]] = counts.get(v["verdict"], 0) + 1
    print("\n" + ", ".join(f"{n} {k}" for k, n in sorted(counts.items(), key=lambda kv: -kv[1])))


if __name__ == "__main__":
    main()
