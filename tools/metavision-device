#!/usr/bin/env python3
"""Pair with, inspect and prepare an Apple Vision Pro from Linux.

No Mac or Xcode involved: everything goes through pymobiledevice3's RemoteXPC
support, with the workarounds visionOS currently needs (see docs/SETUP.md):

  * Manual pairing shows a 6-digit PIN on the headset. pymobiledevice3 only
    asks for a PIN on Apple TV and otherwise sends "000000", which the headset
    rejects (KeyError 'PROOF'). This tool asks for it.
  * visionOS 26+ omits peerDeviceInfo from the pairing handshake, which
    pymobiledevice3 reads for the device identifier; the identifier is taken
    from the pairing record instead.
  * Over the tunnel, lockdown services carry a `.shim.remote` suffix
    (AMFI is com.apple.amfi.lockdown.shim.remote); names are retried with it.

    metavision-device discover               headsets in pairing mode (no root)
    metavision-device pair                   pair; type the PIN the headset shows
    sudo metavision-device info              UDID, model, OS (opens a tunnel: root)
    sudo metavision-device devmode reveal    show Developer Mode in Settings
    sudo metavision-device devmode accept    confirm it after the restart
    sudo metavision-device install APP.ipa   install a signed build
    sudo metavision-device stage mv_<title>  copy its APK, assets and OBB into the app
    sudo metavision-device logs mv_<title>   pull its boot log and crash reports
    sudo metavision-device ls --launcher     what is staged, with sizes
    sudo metavision-device icons             copy staged titles' icons into the launcher
    sudo metavision-device tunnel            keep a tunnel open; other commands then
                                             run without sudo
    metavision-device test [--failed]        every title x input mode, scripted
                                             input, logs judged (see SETUP)
    sudo metavision-device env mv_<title> KL_OVRP_TRACE=1 ...
                                             runtime switches for the next launch
                                             (none: clear them)
    metavision-device register --udid U      add the headset to your Apple team
                                             (App Store Connect API key, see SETUP)

Tunnel commands need root only to create the TUN interface; pairing records
are read from the invoking user's data directory either way.
"""
import argparse
import asyncio
import glob
import json
import os
import posixpath
import pwd
import re
import sys
import time
from pathlib import Path


# ---- pairing records live in the invoking user's home, even under sudo ----
def _user_data_home():
    user = os.environ.get("SUDO_USER")
    home = Path(pwd.getpwnam(user).pw_dir) if user else Path.home()
    return home / ".local" / "share"


os.environ.setdefault("XDG_DATA_HOME", str(_user_data_home()))

try:
    from pymobiledevice3.remote import tunnel_service as ts
    from pymobiledevice3.remote.remote_service_discovery import RemoteServiceDiscoveryService
except ImportError:
    sys.exit("pymobiledevice3 is required: pip install pymobiledevice3")


def records_dir():
    for d in (Path(os.environ["XDG_DATA_HOME"]) / "pymobiledevice3",
              _user_data_home().parent.parent / ".pymobiledevice3"):
        if d.is_dir():
            return d
    return Path(os.environ["XDG_DATA_HOME"]) / "pymobiledevice3"


def paired_identifier(explicit=None):
    if explicit:
        return explicit
    ids = [Path(p).stem[len("remote_"):] for p in glob.glob(str(records_dir() / "remote_*.plist"))]
    if not ids:
        sys.exit("no pairing record found: run `metavision-device pair` first")
    if len(ids) > 1:
        sys.exit("several paired devices; pass --identifier one of: " + ", ".join(ids))
    return ids[0]


def patch_handshake(identifier):
    """visionOS 26+ handshakes carry no peerDeviceInfo."""
    orig_id = ts.RemotePairingProtocol.remote_identifier
    orig_model = ts.RemotePairingProtocol.remote_device_model

    def _id(self):
        try:
            return orig_id.fget(self)
        except (KeyError, TypeError):
            return identifier

    def _model(self):
        try:
            return orig_model.fget(self)
        except (KeyError, TypeError):
            return "RealityDevice"

    ts.RemotePairingProtocol.remote_identifier = property(_id)
    ts.RemotePairingProtocol.remote_device_model = property(_model)


def patch_shim_names():
    """Retry lockdown service names with the RSD `.shim.remote` suffix."""
    orig = RemoteServiceDiscoveryService.start_lockdown_service

    async def start(self, name, *a, **kw):
        services = self.peer_info.get("Services", {}) if self.peer_info else {}
        if name not in services and f"{name}.shim.remote" in services:
            name = f"{name}.shim.remote"
        return await orig(self, name, *a, **kw)

    RemoteServiceDiscoveryService.start_lockdown_service = start


# ---------------------------------------------------------------- discover / pair
async def manual_pairing_devices():
    from pymobiledevice3.bonjour import browse_remotepairing_manual_pairing
    seen = {}
    for answer in await browse_remotepairing_manual_pairing():
        ident = answer.properties["identifier"]
        for addr in answer.addresses:
            ip = addr.full_ip
            # one entry per device; prefer IPv4 (link-local v6 needs a scope id)
            if ident not in seen or (":" in seen[ident]["ip"] and ":" not in ip):
                seen[ident] = {"identifier": ident, "name": answer.properties["name"], "ip": ip, "port": answer.port}
    return list(seen.values())


async def cmd_discover(a):
    devs = await manual_pairing_devices()
    if not devs:
        print("none found: open Settings > General > Remote Devices on the headset, same network as this machine")
    for d in devs:
        print(f"{d['name']}  {d['ip']}:{d['port']}  {d['identifier']}")


async def cmd_pair(a):
    devs = await manual_pairing_devices()
    if a.identifier:
        devs = [d for d in devs if d["identifier"] == a.identifier]
    if not devs:
        sys.exit("no headset in pairing mode: open Settings > General > Remote Devices")
    if len(devs) > 1:
        sys.exit("several headsets in pairing mode; pass --identifier:\n" +
                 "\n".join(f"  {d['identifier']}  {d['name']}" for d in devs))
    d = devs[0]
    print(f"pairing with {d['name']} at {d['ip']}")

    orig = ts.RemotePairingProtocol._init_srp_context

    def with_pin(self, res):
        pin = res.pin
        if not pin:
            if a.pin_file:
                print(f"waiting for the PIN in {a.pin_file}", flush=True)
                while not os.path.exists(a.pin_file):
                    time.sleep(0.5)
                pin = Path(a.pin_file).read_text().strip()
            else:
                pin = input("PIN shown on the headset: ").strip()
            res = res._replace(pin=pin)
        return orig(self, res)

    ts.RemotePairingProtocol._init_srp_context = with_pin
    try:
        async with ts.RemotePairingManualPairingService(d["identifier"], d["ip"], d["port"]) as s:
            await s.connect(autopair=True)
    except Exception as e:
        if type(e).__name__ != "RemotePairingCompletedError":   # this is how success is reported
            raise
    print(f"paired: {d['identifier']}  (record in {records_dir()})")


# ---------------------------------------------------------------- tunnel commands
TUNNEL_FILE = Path(__file__).resolve().parent.parent / "build" / "tunnel.json"


def _tunnel_owner_alive(pid):
    try:
        os.kill(pid, 0)
    except PermissionError:
        return True           # root's process, alive
    except OSError:
        return False
    return True


async def _open_tunnel(a):
    ident = paired_identifier(a.identifier)
    patch_handshake(ident)
    svcs = await ts.get_remote_pairing_tunnel_services(5)
    svcs = [s for s in svcs if ":" not in str(getattr(s, "hostname", ""))] or svcs
    if not svcs:
        raise ConnectionError("headset not reachable: is it awake and on the same network?")
    return ts.start_tunnel_over_remotepairing(svcs[0], protocol=ts.TunnelProtocol.TCP)


async def with_rsd(a, fn):
    """Run fn(rsd) over a tunnel: the one `sudo metavision-device tunnel` keeps
    open (no root needed here), else a tunnel of our own (root)."""
    patch_shim_names()
    if TUNNEL_FILE.is_file():
        info = json.loads(TUNNEL_FILE.read_text())
        if _tunnel_owner_alive(info.get("pid", -1)):
            # The tunnel process re-opens a dropped tunnel and rewrites the
            # file: give it a moment rather than failing at once.
            for _ in range(30):
                info = json.loads(TUNNEL_FILE.read_text())
                rsd = RemoteServiceDiscoveryService((info["address"], info["port"]))
                try:
                    await asyncio.wait_for(rsd.connect(), 15)
                    break
                except Exception:
                    await asyncio.sleep(5)
            else:
                raise ConnectionError("the shared tunnel is not answering (headset asleep or off the network?)")
            try:
                return await fn(rsd)
            finally:
                await rsd.close()
    if os.geteuid() != 0:
        sys.exit("no tunnel: run `sudo metavision-device tunnel` in another terminal "
                 "(or run this command with sudo)")
    try:
        cm = await _open_tunnel(a)
    except ConnectionError as e:
        sys.exit(str(e))
    async with cm as t:
        rsd = RemoteServiceDiscoveryService((t.address, t.port))
        await rsd.connect()
        try:
            return await fn(rsd)
        finally:
            await rsd.close()


async def cmd_tunnel(a):
    """Keep a tunnel to the headset open for other commands, which then need no
    root. Re-opens it whenever it drops (headset asleep, network blip)."""
    if os.geteuid() != 0:
        sys.exit("the tunnel needs root to create its network interface: run it with sudo")
    TUNNEL_FILE.parent.mkdir(parents=True, exist_ok=True)
    while True:
        try:
            cm = await _open_tunnel(a)
            async with cm as t:
                TUNNEL_FILE.write_text(json.dumps({"address": t.address, "port": t.port, "pid": os.getpid()}))
                os.chmod(TUNNEL_FILE, 0o644)
                print(f"{time.strftime('%H:%M:%S')} tunnel up: {t.address} port {t.port} "
                      "(leave this running; Ctrl+C closes it)", flush=True)
                while True:          # a cheap check that it still carries traffic
                    await asyncio.sleep(20)
                    rsd = RemoteServiceDiscoveryService((t.address, t.port))
                    await asyncio.wait_for(rsd.connect(), 20)
                    await rsd.close()
        except (KeyboardInterrupt, asyncio.CancelledError):
            break
        except Exception as e:
            print(f"{time.strftime('%H:%M:%S')} tunnel down ({type(e).__name__}: {e}); "
                  "retrying in 10 s", flush=True)
            await asyncio.sleep(10)
    TUNNEL_FILE.unlink(missing_ok=True)


async def cmd_info(a):
    async def fn(rsd):
        p = rsd.peer_info.get("Properties", {})
        print(json.dumps({k: p.get(k) for k in ("UniqueDeviceID", "ProductType", "OSVersion", "BuildVersion", "DeviceClass")}, indent=2))
    await with_rsd(a, fn)


async def cmd_devmode(a):
    from pymobiledevice3.services.amfi import AmfiService
    action = {"reveal": AmfiService.DEVELOPER_MODE_REVEAL, "enable": AmfiService.DEVELOPER_MODE_ENABLE,
              "accept": AmfiService.DEVELOPER_MODE_ACCEPT}[a.action]

    async def fn(rsd):
        svc = await rsd.start_lockdown_service(AmfiService.SERVICE_NAME)
        resp = await svc.send_recv_plist({"action": action})
        print(resp)
        if a.action == "enable" and "passcode" in str(resp).lower():
            print("expected with a passcode set: use `reveal`, or attempt an install, then turn it on in Settings")
    await with_rsd(a, fn)


async def cmd_install(a):
    from pymobiledevice3.services.installation_proxy import InstallationProxyService

    async def fn(rsd):
        svc = InstallationProxyService(lockdown=rsd)
        await svc.install_from_local(a.ipa)
        print(f"installed {a.ipa}")
    await with_rsd(a, fn)


def title_icon(tree):
    """The largest PNG of the icon the manifest names (@mipmap/x or @drawable/x)."""
    import re
    m = re.search(r'<application[^>]*android:icon="@(\w+)/([\w.]+)"', (tree / "AndroidManifest.xml").read_text(errors="replace"))
    if not m:
        return None
    kind, name = m.groups()
    pngs = [p for d in (tree / "res").glob(f"{kind}*") for p in [d / f"{name}.png"] if p.exists()]
    return max(pngs, key=lambda p: p.stat().st_size) if pngs else None


async def cmd_stage(a):
    """Copy titles' data into their app's container, in the layout kl_app.c reads:
        Documents/<tree>.apk                    the APK (Unity opens it as a zip)
        Documents/<tree>/assets/                decoded assets
        Documents/<tree>/apktool.yml, AndroidManifest.xml
        Documents/android-files/<obb path>/     OBB, single-title app
        Documents/<tree>/android-files/<obb>/   OBB, inside the metavision launcher
    Re-running resumes: a finished title carries Documents/<tree>/.mv-staged (a
    fingerprint of what was copied) and is skipped with one read; an unfinished
    one skips complete files and continues part-copied ones from their last
    byte. One connection serves every title, and a dropped connection is
    re-opened and the copy carried on, up to --retries times.
    """
    import re
    from pymobiledevice3.services.house_arrest import HouseArrestService
    root = Path(__file__).resolve().parent.parent
    guests = root / "build" / "guests"
    rows = json.loads((guests / "targets.json").read_text())
    names = list(rows) if a.all else a.targets
    if a.all and a.launcher:
        # Only titles the launcher build carries: data for a title it left
        # out (it did not translate) would be copied for nothing.
        ipa = root / "build" / "ipa" / "metavision.ipa"
        if ipa.exists():
            import zipfile
            built = {m.group(1) for n in zipfile.ZipFile(ipa).namelist()
                     if (m := re.match(r"Payload/[^/]+/Frameworks/(mv_[^/]+)/", n))}
            if built:
                skipped = [n for n in names if n not in built]
                names = [n for n in names if n in built]
                if skipped:
                    print(f"not in {ipa.name}, skipped: {' '.join(skipped)}")
    if not names:
        sys.exit("stage: name titles, or --all")
    for n in names:
        if n not in rows:
            sys.exit(f"unknown target {n}; see tools/metavision-targets list")
    async def remote_size(afc, path):
        """Bytes under a remote path (file or tree); -1 when it is not there."""
        try:
            st = await afc.stat(path)
        except Exception:
            return -1
        if st.get("st_ifmt") != "S_IFDIR":
            return int(st.get("st_size", 0))
        total = 0
        async for root, _dirs, files in afc.walk(path):
            for f in files:
                try:
                    total += int((await afc.stat(f"{root}/{f}")).get("st_size", 0))
                except Exception:
                    pass
        return total

    def local_size(p):
        return p.stat().st_size if p.is_file() else sum(f.stat().st_size for f in p.rglob("*") if f.is_file())

    async def append_rest(afc, local, remote_path, have):
        """Continue a partly copied file from byte `have` (AFC append mode)."""
        total = local.stat().st_size
        chunk = 4 << 20
        h = await afc.fopen(remote_path, "a")
        try:
            with open(local, "rb") as f:
                f.seek(have)
                done, last = have, -1
                while True:
                    buf = f.read(chunk)
                    if not buf:
                        break
                    await afc.fwrite(h, buf)
                    done += len(buf)
                    pct = done * 100 // total
                    if pct != last and pct % 5 == 0:
                        print(f"    {pct:3}%  {done / 1e9:.2f} / {total / 1e9:.2f} GB", flush=True)
                        last = pct
        finally:
            await afc.fclose(h)

    async def finish_folder(afc, local, remote_path, label):
        """Bring a partly copied folder up to date: one listing per directory;
        a file present by name counts as done unless it is large (>8 MB), which
        is stat'ed and continued from its last byte when short."""
        sent = checked = 0
        total = sum(1 for p in local.rglob("*") if p.is_file())
        dirs = sorted({local} | {d for d in local.rglob("*") if d.is_dir()})
        last = time.monotonic()
        print(f"  {label:7} checking {total} files in {len(dirs)} folders -> {remote_path}", flush=True)
        for d in dirs:
            if time.monotonic() - last > 3:
                print(f"    {checked}/{total} checked, {sent} copied", flush=True)
                last = time.monotonic()
            rel = d.relative_to(local).as_posix()
            rdir = remote_path if rel == "." else f"{remote_path}/{rel}"
            try:
                there = set(await afc.listdir(rdir))
            except Exception:
                there = set()
                await afc.makedirs(rdir)
            for f in sorted(p for p in d.iterdir() if p.is_file()):
                checked += 1
                if time.monotonic() - last > 3:
                    print(f"    {checked}/{total} checked, {sent} copied", flush=True)
                    last = time.monotonic()
                rp, size = f"{rdir}/{f.name}", f.stat().st_size
                if f.name in there:
                    if size <= (8 << 20):
                        continue
                    got = await remote_size(afc, rp)
                    if got == size:
                        continue
                    if 0 < got < size:
                        await append_rest(afc, f, rp, got); sent += 1
                        continue
                if size < (64 << 20):
                    await afc.set_file_contents(rp, f.read_bytes())
                else:
                    await afc.push(str(f), rp)
                sent += 1
        print(f"  {label:7} {'already there, skipped' if not sent else f'{sent} file(s) completed'}", flush=True)

    async def push_unless_done(afc, local, remote_parent, remote_path, label):
        """Resume-friendly: skip anything already on the headset at full size,
        and finish a large file that a dropped connection left part-way."""
        if local.is_dir():
            # Folders: no size walk (thousands of round trips); finish_folder
            # compares names per directory and measures only large files.
            try:
                exists = (await afc.stat(remote_path)).get("st_ifmt") == "S_IFDIR"
            except Exception:
                exists = False
            if exists:
                await finish_folder(afc, local, remote_path, label)
                return
            print(f"  {label:7} -> {remote_path}", flush=True)
            await afc.push(str(local), remote_parent)
            return
        have, want = await remote_size(afc, remote_path), local_size(local)
        if have == want:
            print(f"  {label:7} already there, skipped", flush=True)
            return
        if local.is_file() and 0 < have < want:
            print(f"  {label:7} resuming at {have / 1e9:.2f} of {want / 1e9:.2f} GB -> {remote_path}", flush=True)
            await append_rest(afc, local, remote_path, have)
            return
        print(f"  {label:7} -> {remote_path}", flush=True)
        await afc.push(str(local), remote_parent)

    def plan(name):
        t = rows[name]
        tree, apk = guests / t["tree"], guests / t["apk"]
        if not (tree / "apktool.yml").exists() or not apk.exists():
            sys.exit(f"{name} is not staged: tools/metavision-targets stage")
        pkg = re.search(r'package="([^"]+)"', (tree / "AndroidManifest.xml").read_text()).group(1)
        obb_src = root / "pull" / pkg / "obb"
        obbs = sorted(obb_src.glob("*")) if obb_src.is_dir() and not a.skip_obb else []
        assets = tree / "assets"
        afiles = [f for f in assets.rglob("*") if f.is_file()] if assets.is_dir() else []
        # What a finished copy holds; any change to the source re-checks it.
        stamp = json.dumps({"apk": apk.stat().st_size, "assets": [len(afiles), sum(f.stat().st_size for f in afiles)],
                            "obb": {f.name: f.stat().st_size for f in obbs}}, sort_keys=True)
        return t, tree, apk, obbs, stamp

    def bundle_for(name):
        return a.bundle or ("metavision.dev.klepton.target.metavision" if a.launcher else
                            "metavision.dev.klepton.target." + name.replace("_", "-"))

    async def stage_one(afc, name):
        t, tree, apk, obbs, stamp = plan(name)
        marker = f"Documents/{t['tree']}/.mv-staged"
        try:
            if (await afc.get_file_contents(marker)).decode() == stamp:
                print(f"{name}: already complete, skipped", flush=True)
                return
        except Exception:
            pass
        print(f"{name}:", flush=True)
        files_root = f"Documents/{t['tree']}/android-files" if a.launcher else "Documents/android-files"
        await afc.makedirs(f"Documents/{t['tree']}")
        for m in ("apktool.yml", "AndroidManifest.xml"):
            await afc.set_file_contents(f"Documents/{t['tree']}/{m}", (tree / m).read_bytes())
        icon = title_icon(tree)
        if icon:   # shown on the title's tile in the launcher's library
            await afc.set_file_contents(f"Documents/{t['tree']}/icon.png", icon.read_bytes())
        await push_unless_done(afc, apk, f"Documents/{t['apk']}", f"Documents/{t['apk']}", "apk")
        if (tree / "assets").is_dir():
            await push_unless_done(afc, tree / "assets", f"Documents/{t['tree']}",
                                   f"Documents/{t['tree']}/assets", "assets")
        if obbs:
            dest = f"{files_root}/{t['obb']}"
            await afc.makedirs(dest)
            for f in obbs:
                await push_unless_done(afc, f, f"{dest}/{f.name}", f"{dest}/{f.name}",
                                       f"obb {f.stat().st_size / 1e9:.1f}G")
        await afc.set_file_contents(marker, stamp.encode())
        print(f"{name}: complete", flush=True)

    todo = list(names)

    async def fn(rsd):
        afcs = {}
        try:
            while todo:
                b = bundle_for(todo[0])
                if b not in afcs:
                    afcs[b] = await HouseArrestService.create(rsd, b)
                await stage_one(afcs[b], todo[0])
                todo.pop(0)
        finally:
            for x in afcs.values():
                try:
                    await x.close()
                except Exception:
                    pass

    for attempt in range(a.retries + 1):
        try:
            await with_rsd(a, fn)
            break
        except (ConnectionError, OSError, asyncio.TimeoutError, Exception) as e:
            if isinstance(e, SystemExit) or not todo:
                raise
            if attempt == a.retries:
                print(f"\ngave up after {a.retries} reconnects; run again to continue. Not finished: {' '.join(todo)}")
                sys.exit(1)
            print(f"\n--- connection dropped ({type(e).__name__}); reconnecting in 10 s "
                  f"({attempt + 1}/{a.retries}), continuing at {todo[0]}", flush=True)
            await asyncio.sleep(10)
    print(f"\nALL DONE: {len(names)} title(s)")


async def mount_ddi(rsd, ddi_root):
    """Mount the developer disk image (Apple's developer services: process
    launch). visionOS's comes only from Xcode: .github/workflows/ddi.yml copies it
    off a runner, encrypted; decrypt and unpack it under build/ddi/."""
    from pymobiledevice3.services.mobile_image_mounter import PersonalizedImageMounter
    from pymobiledevice3.exceptions import AlreadyMountedError
    async with PersonalizedImageMounter(lockdown=rsd) as m:
        if await m.is_image_mounted("Personalized"):
            return "already mounted"
    restores = sorted(Path(ddi_root).rglob("BuildManifest.plist"))
    if not restores:
        sys.exit(f"no DDI under {ddi_root}: run the ddi workflow, then decrypt and unpack it there")
    restore = restores[0].parent
    try:
        from pymobiledevice3.services.cryptexd import CryptexdService
        await CryptexdService(rsd).auto_install_ddi(restore_dir=restore)
        return f"installed (cryptex) from {restore}"
    except AlreadyMountedError:
        return "already mounted"
    except Exception as e:
        print(f"  cryptex install did not take ({type(e).__name__}: {e}); trying the image mounter", flush=True)
    import plistlib
    dmg = tc = None
    for bi in plistlib.loads(restores[0].read_bytes()).get("BuildIdentities", []):
        man = bi.get("Manifest", {})
        if "PersonalizedDMG" in man and "LoadableTrustCache" in man:
            dmg = restore / man["PersonalizedDMG"]["Info"]["Path"]
            tc = restore / man["LoadableTrustCache"]["Info"]["Path"]
            break
    if not dmg or not dmg.exists() or not tc.exists():
        sys.exit(f"{restore}: the manifest names no PersonalizedDMG to mount")
    await PersonalizedImageMounter(lockdown=rsd).mount(dmg, restores[0], tc)
    return f"mounted {dmg.name}"


async def cmd_ddi(a):
    """Mount the developer disk image (needed once per headset boot for `test`)."""
    async def fn(rsd):
        print(await mount_ddi(rsd, a.dir))
    await with_rsd(a, fn)


MODES = ("hands", "handsfree", "auto")


def _triage_module():
    import importlib.util
    from importlib.machinery import SourceFileLoader
    path = str(Path(__file__).resolve().parent / "metavision-triage")
    loader = SourceFileLoader("mv_triage", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("mv_triage", loader))
    sys.dont_write_bytecode = True
    loader.exec_module(mod)
    return mod


async def cmd_test(a):
    """Unattended pass: every title, in every input mode, driven by scripted
    input (MV_AUTOPLAY) through that mode's own path — synthetic controllers
    and Meta hand skeletons in hands mode, gaze selects and spoken commands in
    hands-free, the two alternating in auto. Each run's logs and any system
    crash report are pulled straight after it and judged (metavision-triage);
    progress is saved, so a dropped connection resumes where it stopped and
    `--failed` re-runs only what did not pass last time. The headset must be
    worn (or its proximity sensor covered): visionOS pauses unseen apps."""
    from pymobiledevice3.services.dvt.instruments.dvt_provider import DvtProvider
    from pymobiledevice3.services.dvt.instruments.process_control import ProcessControl
    from pymobiledevice3.services.house_arrest import HouseArrestService
    from pymobiledevice3.services.crash_reports import CrashReportsManager
    triage = _triage_module()
    root = Path(__file__).resolve().parent.parent
    rows = json.loads((root / "build" / "guests" / "targets.json").read_text())
    bundle = a.bundle or "metavision.dev.klepton.target.metavision"
    modes = [m.strip().replace("-", "") for m in a.modes.split(",") if m.strip()]
    for m in modes:
        if m not in MODES:
            sys.exit(f"unknown mode {m}: {', '.join(MODES)}")
    titles = a.targets or list(rows)
    try:   # only what the launcher build carries
        import zipfile
        with zipfile.ZipFile(root / "build" / "ipa" / "metavision.ipa") as z:
            built = {m.group(1) for n in z.namelist()
                     if (m := re.match(r"Payload/[^/]+/Frameworks/(mv_[^/]+)/", n))}
        titles = [t for t in titles if t in built] or titles
    except Exception:
        pass

    base = root / "build" / "test"
    runs = sorted(d for d in base.glob("*") if (d / "state.json").is_file()) if base.is_dir() else []
    prev = runs[-1] if runs else None
    if a.failed:
        if not prev:
            sys.exit("--failed: no earlier test run under build/test")
        st = json.loads((prev / "state.json").read_text())
        items = [k for k, v in st["items"].items() if v.get("verdict") != "pass"]
        if a.targets:
            items = [k for k in items if k.split("@")[0] in a.targets]
        if not items:
            print(f"nothing failed in {prev.name}"); return
        run = base / time.strftime("%Y%m%d-%H%M%S")
        state = {"items": {k: {} for k in items}, "seconds": a.seconds, "from": prev.name}
    elif prev and not a.new and any(not v.get("verdict") for v in
                                    json.loads((prev / "state.json").read_text())["items"].values()):
        run = prev
        state = json.loads((prev / "state.json").read_text())
        print(f"resuming {run.name}  (--new starts over)")
    else:
        run = base / time.strftime("%Y%m%d-%H%M%S")
        state = {"items": {f"{t}@{m}": {} for t in titles for m in modes}, "seconds": a.seconds}
    run.mkdir(parents=True, exist_ok=True)
    save = lambda: (run / "state.json").write_text(json.dumps(state, indent=1))
    save()
    todo = [k for k, v in state["items"].items() if not v.get("verdict")]
    total = len(state["items"])
    print(f"{run.relative_to(root)}: {len(todo)} of {total} run(s) to go, "
          f"{state['seconds']} s each (about {len(todo) * (state['seconds'] + 15) // 60} min)", flush=True)
    async def one(rsd, pc, afc, key, probe=False):
        """Run one title in one mode; a probe only asks whether it draws."""
        title, mode = key.split("@")
        tree = rows.get(title, {}).get("tree", f"mv_{title}")
        out = run / ".probe" if probe else run / tree / mode
        out.mkdir(parents=True, exist_ok=True)
        for f in ("klepton-boot.log", "klepton-crash.log"):     # nothing stale
            try:
                await afc.rm(f"Documents/{f}", force=True)
            except Exception:
                pass
        async with CrashReportsManager(rsd) as cr:
            before = set(await cr.ls("/", depth=1))
        env = {"MV_AUTOSTART": title, "MV_INPUT_MODE": mode}
        if not a.no_play:
            env["MV_AUTOPLAY"] = "1"
        t0 = time.time()
        pid = await pc.launch(bundle, environment=env, kill_existing=True)
        if not probe:
            print(f"[{total - len(todo) + 1}/{total}] {title} ({mode}): pid {pid}", end="", flush=True)
        exited = None
        while time.time() - t0 < (25 if probe else state["seconds"]):
            await asyncio.sleep(5)
            if await pc.process_identifier_for_bundle_identifier(bundle) != pid:
                exited = round(time.time() - t0)
                break
        if exited is None:
            try:
                await pc.kill(pid)
            except Exception:
                pass
        await asyncio.sleep(3)
        got = []
        for f in ("klepton-boot.log", "klepton-crash.log"):
            try:
                (out / f).write_bytes(await afc.get_file_contents(f"Documents/{f}"))
                got.append(f)
            except Exception:
                pass
        if probe:
            return triage.verdict(out)
        async with CrashReportsManager(rsd) as cr:
            try:
                await cr.flush()
            except Exception:
                pass
            for n in sorted(set(await cr.ls("/", depth=1)) - before):
                if n.endswith(".ips") and ("metavision" in n.lower() or "klepton" in n.lower()):
                    (out / posixpath.basename(n)).write_bytes(await cr.afc.get_file_contents(n))
                    got.append(posixpath.basename(n))
        v = triage.verdict(out, exited=exited)
        state["items"][key] = {"verdict": v["verdict"], "summary": v["summary"], "exited_after": exited}
        save()
        print(f"  -> {v['verdict'].upper()}: {v['summary']}", flush=True)
        return v

    async def wait_awake(rsd, pc, afc, good):
        """The headset has stopped drawing (asleep, taken off): re-launch a
        title that drew before until it draws again."""
        since = time.time()
        print(f"  !! no picture twice running: the headset looks asleep. Pausing; put it on "
              f"(or wake it) and the pass carries on. Checking every 30 s with {good}.", flush=True)
        state.setdefault("sleeps", []).append(time.strftime("%H:%M:%S"))
        save()
        while True:
            v = await one(rsd, pc, afc, good, probe=True)
            if v["frames"] > 0:
                print(f"  awake again after {round(time.time() - since)} s: resuming", flush=True)
                return
            await asyncio.sleep(30)

    async def fn(rsd):
        print(await mount_ddi(rsd, a.ddi), flush=True)
        afc = await HouseArrestService.create(rsd, bundle)
        try:
            async with DvtProvider(rsd) as dvt, ProcessControl(dvt) as pc:
                good, dark = None, []
                while todo:
                    key = todo[0]                 # popped once done: a drop re-runs it
                    v = await one(rsd, pc, afc, key)
                    todo.pop(0)
                    if v["frames"] > 0:
                        good, dark = key, []
                    elif v["verdict"] == "black":
                        dark.append(key)
                    # Two different titles in a row without a picture, after one
                    # that drew: the headset, not the titles. Run them again.
                    if len(dark) >= 2 and good:
                        for k in dark:
                            state["items"][k] = {}
                        todo[0:0] = dark
                        save()
                        await wait_awake(rsd, pc, afc, good)
                        dark = []
        finally:
            await afc.close()

    for attempt in range(a.retries + 1):
        try:
            await with_rsd(a, fn)
            break
        except Exception as e:
            if not todo:
                break
            if attempt == a.retries:
                sys.exit(f"\ngave up after {a.retries} reconnects; run `test` again to resume")
            print(f"\n--- connection dropped ({type(e).__name__}: {e}); reconnecting in 10 s "
                  f"({attempt + 1}/{a.retries}), resuming at {todo[0]}", flush=True)
            await asyncio.sleep(10)
    v = [x.get("verdict") for x in state["items"].values()]
    print(f"\n{run.relative_to(root)}: {v.count('pass')} passed, {len(v) - v.count('pass')} not  "
          f"(report: tools/metavision-triage {run.relative_to(root)}; again for just those: test --failed)")


async def cmd_logs(a):
    """Pull the runtime's boot log and crash reports out of a title's container."""
    if a.all:
        a.launcher = True
    elif not a.target:
        sys.exit("logs: name a title, or --all")
    from pymobiledevice3.services.house_arrest import HouseArrestService
    bundle = a.bundle or ("metavision.dev.klepton.target.metavision" if a.launcher else
                          "metavision.dev.klepton.target." + a.target.replace("_", "-"))
    out = Path(a.out or f"build/logs/{a.target}")

    async def pull(afc, src, dst):
        dst.mkdir(parents=True, exist_ok=True)
        for old in dst.glob("klepton-*.log"):
            old.unlink()                      # a stale crash must not look current
        try:
            names = await afc.listdir(src)
        except Exception:
            return []
        got = [n for n in names if n.endswith((".log", ".crash", ".ips"))]
        for n in got:
            (dst / n).write_bytes(await afc.get_file_contents(f"{src}/{n}"))
        return got

    async def fn(rsd):
        afc = await HouseArrestService.create(rsd, bundle)
        try:
            if a.all:
                # The launcher files each run under Documents/logs/<title>/; the
                # newest run is still at the top, written by current-title.txt.
                base = Path(a.out or "build/logs")
                try:
                    titles = [n for n in await afc.listdir("Documents/logs")
                              if not n.endswith(".txt")]
                except Exception:
                    titles = []
                for t in titles:
                    got = await pull(afc, f"Documents/logs/{t}", base / t)
                    print(f"{t:40} {', '.join(got) or '(none)'}")
                try:
                    cur = (await afc.get_file_contents("Documents/logs/current-title.txt")).decode().strip()
                except Exception:
                    cur = ""
                if cur:
                    got = await pull(afc, "Documents", base / cur)
                    print(f"{cur:40} {', '.join(got) or '(none)'}  (latest run)")
                return
            out.mkdir(parents=True, exist_ok=True)
            got = await pull(afc, "Documents", out)
            print(f"{len(got)} file(s) -> {out}: {', '.join(got) or '(none)'}")
        finally:
            await afc.close()
    await with_rsd(a, fn)


