async def cmd_ls(a):
    """What is staged in an app's container: each title's APK, assets and OBB, with sizes."""
    from pymobiledevice3.services.house_arrest import HouseArrestService
    bundle = a.bundle or ("metavision.dev.klepton.target.metavision" if a.launcher else
                          "metavision.dev.klepton.target." + a.target.replace("_", "-"))

    async def size_of(afc, path):
        total = 0
        try:
            for root, _dirs, files in [x async for x in afc.walk(path)]:
                for f in files:
                    try:
                        total += int((await afc.stat(f"{root}/{f}")).get("st_size", 0))
                    except Exception:
                        pass
        except Exception:
            try:
                total = int((await afc.stat(path)).get("st_size", 0))
            except Exception:
                pass
        return total

    async def fn(rsd):
        afc = await HouseArrestService.create(rsd, bundle)
        try:
            names = sorted(await afc.listdir("Documents"))
            for n in names:
                if n in (".", ".."):
                    continue
                gb = await size_of(afc, f"Documents/{n}") / 1e9
                print(f"  {gb:8.2f} GB  {n}")
        finally:
            await afc.close()
    await with_rsd(a, fn)


async def cmd_env(a):
