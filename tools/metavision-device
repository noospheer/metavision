def asc_token():
    try:
        import jwt
    except ImportError:
        sys.exit("pip install pyjwt cryptography")
    key = Path(os.environ["MV_ASC_KEY_P8"]).read_text()
    now = int(time.time())
    return jwt.encode({"iss": os.environ["MV_ASC_ISSUER_ID"], "iat": now, "exp": now + 600, "aud": "appstoreconnect-v1"},
                      key, algorithm="ES256", headers={"kid": os.environ["MV_ASC_KEY_ID"], "typ": "JWT"})


def cmd_register(a):
    import urllib.request
    for v in ("MV_ASC_KEY_P8", "MV_ASC_KEY_ID", "MV_ASC_ISSUER_ID"):
        if v not in os.environ:
            sys.exit(f"set {v} (see docs/SETUP.md, App Store Connect API key)")
    # The API has no visionOS platform value: a Vision Pro registers as IOS and
    # comes back with deviceClass APPLE_VISION_PRO.
    body = json.dumps({"data": {"type": "devices", "attributes": {"name": a.name, "platform": "IOS", "udid": a.udid}}}).encode()
    req = urllib.request.Request("https://api.appstoreconnect.apple.com/v1/devices", data=body, method="POST",
                                 headers={"Authorization": f"Bearer {asc_token()}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req) as r:
            d = json.load(r)["data"]["attributes"]
            print(f"registered {d['name']}: {d['deviceClass']} {d['status']}")
    except urllib.error.HTTPError as e:
        msg = e.read().decode()
        if "already exists" in msg or e.code == 409:
            print("already registered (or rejected):", msg[:300])
        else:
            raise


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--identifier", help="pairing identifier, when more than one device is paired")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("discover")
    p = sub.add_parser("pair"); p.add_argument("--pin-file", help="read the PIN from this file instead of a prompt")
    sub.add_parser("info")
    p = sub.add_parser("devmode"); p.add_argument("action", choices=["reveal", "enable", "accept"])
    p = sub.add_parser("install"); p.add_argument("ipa")
    p = sub.add_parser("stage"); p.add_argument("targets", nargs="*")
    p.add_argument("--all", action="store_true", help="every generated title")
    p.add_argument("--retries", type=int, default=20, help="reconnects after a dropped connection")
    p.add_argument("--bundle", help="app bundle id (default: the title's own app)")
    p.add_argument("--launcher", action="store_true", help="stage into the metavision launcher's layout")
    p.add_argument("--skip-obb", action="store_true", help="leave OBBs alone (already copied)")
    p = sub.add_parser("icons"); p.add_argument("targets", nargs="*"); p.add_argument("--bundle")
    p = sub.add_parser("ls"); p.add_argument("target", nargs="?", default="")
    p.add_argument("--bundle"); p.add_argument("--launcher", action="store_true")
    p = sub.add_parser("env"); p.add_argument("target"); p.add_argument("vars", nargs="*", metavar="KEY=VALUE")
    p.add_argument("--bundle"); p.add_argument("--launcher", action="store_true")
    p = sub.add_parser("logs"); p.add_argument("target", nargs="?", default="")
    p.add_argument("--all", action="store_true",
                   help="every title's last run, filed by the launcher (implies --launcher)")
    p.add_argument("--bundle"); p.add_argument("--launcher", action="store_true"); p.add_argument("--out")
    p = sub.add_parser("ddi"); p.add_argument("--dir", default="build/ddi")
    sub.add_parser("tunnel")
    p = sub.add_parser("test"); p.add_argument("targets", nargs="*")
    p.add_argument("--seconds", type=int, default=75, help="how long each run lasts")
    p.add_argument("--modes", default=",".join(MODES), help="input modes to run each title in (default: all)")
    p.add_argument("--failed", action="store_true", help="only what did not pass in the last run")
    p.add_argument("--new", action="store_true", help="start over instead of resuming an unfinished run")
    p.add_argument("--retries", type=int, default=20, help="reconnects after a dropped connection")
    p.add_argument("--no-play", action="store_true", help="no scripted input: just open each title")
    p.add_argument("--ddi", default="build/ddi"); p.add_argument("--bundle")
    p = sub.add_parser("register"); p.add_argument("--udid", required=True); p.add_argument("--name", default="Vision Pro")
    a = ap.parse_args()
    if a.cmd == "register":
        return cmd_register(a)
    asyncio.run({"discover": cmd_discover, "pair": cmd_pair, "info": cmd_info,
                 "devmode": cmd_devmode, "install": cmd_install, "stage": cmd_stage, "logs": cmd_logs, "env": cmd_env, "ls": cmd_ls, "icons": cmd_icons, "ddi": cmd_ddi, "test": cmd_test, "tunnel": cmd_tunnel}[a.cmd](a))


if __name__ == "__main__":
    main()
