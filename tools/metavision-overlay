static uint32_t avp_texture_locked(avp *p) {
    if (p->state < ST_PREPARED || !p->latched) return 0;
    return p->fast_oes ? p->oes_tex : p->rgba_tex;
}
static int avp_canplay_locked(avp *p) {
    return p->state == ST_STOPPED || p->state == ST_PAUSED || p->state == ST_PLAYING || p->state == ST_FINISHED;
}
