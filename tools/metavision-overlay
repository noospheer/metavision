    klj_val m = { .l = p->mtx };
    klj_call_binding(p->st, "getTransformMatrix", "([F)V", &m, 1);
    klj_array *src = klj_arr(p->mtx);
    void *out = klj_new_array('F', NULL, 6);
    klj_array *dst = klj_arr(out);
    if (!src || !src->data || src->len < 16 || !dst || !dst->data) return (klj_val){.l = out};
    const float *s = src->data;
    float *d = dst->data;
    d[0] = s[0]; d[1] = s[1]; d[2] = -s[4]; d[3] = -s[5]; d[4] = 0; d[5] = 0;
