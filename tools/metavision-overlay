static klj_list *fs_list_of(void *obj) {   // ours, or the runtime's fixed java/util/List
    klj_object *o = klj_as_object(obj);
    if (!o || !o->data) return NULL;
    if (o->destroy == fs_list_free) return o->data;
    if (!strcmp(o->cls, "java/util/List")) return o->data;
