    static struct { void *a, *pc; uint8_t inter, touch, own; } act[1024];
    unsigned na = 0, nact_click = 0;
    unsigned np = mvu_all(C_PRIM, buf, MVU_BUF);
    for (unsigned i = 0; i < np; i++) {
