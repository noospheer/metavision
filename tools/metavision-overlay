                "%u skipped%s%s%s; %u trigger-only)\n", t, found[MVF_UI], found[MVF_ISDK], found[MVF_XRI],
                found[MVF_XRI] && !ior ? " but no interactor" : "", found[MVF_CLICK], found[MVF_EVENT],
                nskip, skip[0] ? " e.g. '" : "", skip, skip[0] ? "'" : "", trig);
