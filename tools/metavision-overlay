static klj_val avp_open(void *env, void *self, const klj_val *a, int n) {
    (void)env;
    avp *p = avp_of(self);
    const char *url = n > 0 ? klj_str(a[0].l) : NULL;
    int64_t extra = n > 1 ? (int64_t)a[1].j : 0;
    if (!p || !url) return (klj_val){.j = 0};
    avp_close(p);                      // the Java's CloseVideo first
    char path[1024];
    int64_t off = 0, len = 0;
    if (avp_resolve(url, extra, path, sizeof path, &off, &len) != 0) {
        pthread_mutex_lock(&p->lk);
        p->last_error = ERR_LOAD;
        pthread_mutex_unlock(&p->lk);
        return (klj_val){.j = 0};
    }
    pthread_mutex_lock(&p->lk);
    snprintf(p->src, sizeof p->src, "%s", path);
    p->src_off = off;
    p->src_len = len;
    p->state = ST_OPENING;
    p->vthr_on = pthread_create(&p->vthr, NULL, avp_video_main, p) == 0;
    if (!p->vthr_on) { p->state = ST_IDLE; p->last_error = ERR_LOAD; }
    int ok = p->vthr_on;
    pthread_mutex_unlock(&p->lk);
    KLJ_LOG("video plugin player %d: OpenVideoFromFile(%s) -> %s [%lld+%lld]", p->index, url, path,
            (long long)off, (long long)len);
    return (klj_val){.j = (uint64_t)ok};
}
