// Which actor events a class's Blueprint implements: its own UFunction, not AActor's.
static uint8_t mvu_aclass(void *k) {
    static struct { void *k; uint8_t f; } kc[512];
    static unsigned n;
    for (unsigned i = 0; i < n; i++) if (kc[i].k == k) return kc[i].f;
    uint8_t f = 0;
    for (int e = 0; e < 4; e++) {
        if (!ue.fn_ev[e]) continue;
        void *fn = ue.find_fn(k, ue.fn_ev[e], 1 /* IncludeSuper */);
        if (fn && MVU_OUTER(fn) != ue.cls[C_ACTOR]) f |= (uint8_t)(1u << e);
    }
    if (n < 512) { kc[n].k = k; kc[n].f = f; n++; }
    return f;
}

// ---- a press in two halves: now, and _HOLD_MS later (a weak pointer in between) ----
enum { K_BUTTON, K_CHECK, K_SLIDER, K_COMBO, K_ACTOR };
static struct { uint64_t w; uint8_t fam, kind, touch, live; double at; char what[64]; } mvuh;
static void mvu_release(double now, double t0, int force) {
    if (!mvuh.live || (!force && now < mvuh.at)) return;
    mvuh.live = 0;
    void *o = ue.weak_get(&mvuh.w);
    const char *how;
    if (!o) how = "nothing: it is gone";
    else if (mvuh.kind == K_BUTTON) {
        ue.b_release(o); (void)ue.b_click(o); ue.b_unhover(o);
        how = "SlateHandleReleased+Clicked+Unhovered";
    } else {
        if (mvuh.touch) ue.touch_end(o, 0);
        ue.over(o, NULL);
        how = mvuh.touch ? "DispatchOnInputTouchEnd+MouseOverEvents(end)" : "DispatchMouseOverEvents(end)";
    }
    fprintf(stderr, "[mv-autoplay-ui] t=%.1fs released '%s' (%s via %s)\n", now - t0, mvuh.what, mvu_fam[mvuh.fam], how);
}

typedef struct { void *o, *press; uint8_t fam, kind, lang, touch; int16_t di; char lab[64], nm[64], kn[48]; } mvu_cand;
static int mvu_before(const mvu_cand *a, const mvu_cand *b) {
    const mvu_disc *x = &mvud[a->di], *y = &mvud[b->di];
    if (x->tries != y->tries) return x->tries < y->tries;
    if (x->last != y->last) return x->last < y->last;
    if (a->lang != b->lang) return a->lang < b->lang;
    if (a->fam != b->fam) return a->fam < b->fam;
    int c = strcmp(a->nm, b->nm);
    if (c) return c < 0;
    c = strcmp(a->lab, b->lab);
    if (c) return c < 0;
    return a->di < b->di;
}

// A candidate's name (its object name), label (the text on it or beside it) and,
// in ev, why it reads like leaving when neither of those says so: a function its
// delegates call ("BndEvt__QuitButton_..."), the instance name of the user widget
// wrapping it ("ExitButton"), or the dialog a "Yes" in it agrees to ("QuitConfirm").
static void mvu_names(mvu_cand *x, char *ev, size_t cap) {
    ev[0] = 0;
    mvu_fname(MVU_NAME(x->o), x->nm, sizeof x->nm);
    if (x->fam != MVU_UMG) return;
    if ((x->kind == K_BUTTON || x->kind == K_CHECK) && !mvu_text(ue.content(x->o), x->lab, sizeof x->lab, 0)) {
        void *pa = ue.parent(x->o);   // a label beside it: an overlay of a button and its text
        int32_t n = pa ? ue.nkids(pa) : 0;
        for (int32_t i = 0; i < n && i < 8; i++) {
            void *s = ue.kid(pa, i);
            if (s != x->o && mvu_text(s, x->lab, sizeof x->lab, 1)) break;
        }
    }
    static const int ps[4][3] = { { P_B_CLICK, P_B_PRESS, P_B_REL }, { P_CHECK, -1, -1 },
                                  { P_SLIDE, -1, -1 }, { P_COMBO, -1, -1 } };
    for (int j = 0; x->kind < 4 && j < 3; j++)
        if (ps[x->kind][j] >= 0 && mvu_bound_unsafe(x->o, ps[x->kind][j], ev, cap)) return;
    void *u = ue.typed_outer(x->o, ue.cls[C_USERW]);
    if (u) {
        char un[64];
        mvu_fname(MVU_NAME(u), un, sizeof un);
        if ((ue.parent(u) || mvu_confirm(x->lab) || mvu_confirm(x->nm)) && mv_unsafe(un)) snprintf(ev, cap, "%s", un);
