// ------------------------------------------------------------- paths
static int fs_segments(const char *path) {   // -1 when not a valid path
    if (!path || !*path) return -1;
    int n = 1;
    for (const char *p = path; *p; p++)
        if (*p == '/') { if (p[1] == '/' || p[1] == 0 || p == path) return -1; n++; }
    return n;
}
static char *fs_join(const char *a, const char *b) {
    size_t la = strlen(a), lb = strlen(b);
    char *r = malloc(la + lb + 2);
    memcpy(r, a, la); r[la] = '/'; memcpy(r + la + 1, b, lb + 1);
    return r;
}
static const char *fs_last(const char *path) {
    const char *s = strrchr(path, '/');
    return s ? s + 1 : path;
}
static char *fs_parent(const char *path) {   // NULL at the root
    const char *s = strrchr(path, '/');
    return s ? strndup(path, (size_t)(s - path)) : NULL;
}
static fs_dbinfo *fs_dbi(void *db) {
    mvfs *f = fs_of(db, FS_DB);
    return f ? f->dbi : NULL;
}
static void sb_docname(sb *b, void *db, const char *path) {
    fs_dbinfo *d = fs_dbi(db);
    sb_add(b, "projects/");
    sb_add(b, d && d->project ? d->project : "");
    sb_add(b, "/databases/");
    sb_add(b, d ? d->db : "(default)");
    sb_add(b, "/documents");
    if (path && *path) { sb_add(b, "/"); sb_add(b, path); }
}
static void *fs_ref(void *db, const char *path, int doc) {
    mvfs *f;
    void *obj = fs_new(doc ? C_DOC : C_COLL, doc ? FS_DOC : FS_COLL, &f);
    f->db = db;
    f->path = strdup(path);
    if (!doc) f->q.coll = strdup(path);
    return obj;
}
static void *fs_bad_path(const char *what, const char *path) {
    KLJ_LOG("Firestore: invalid %s path \"%s\" -> IllegalArgumentException", what, path ? path : "(null)");
    kl_jni_throw("java/lang/IllegalArgumentException");
    return NULL;
}

// Field paths: segments, and their encoded form (`quoted` where not a plain identifier).
static void sb_fieldseg(sb *b, const char *s) {
    int plain = *s && !(*s >= '0' && *s <= '9');
    for (const char *p = s; *p && plain; p++)
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9') || *p == '_')) plain = 0;
    if (plain) { sb_add(b, s); return; }
    sb_put(b, "`", 1);
    for (const char *p = s; *p; p++) {
        if (*p == '`' || *p == '\\') sb_put(b, "\\", 1);
        sb_put(b, p, 1);
    }
    sb_put(b, "`", 1);
}
static char *fs_encode_segs(char **segs, int n) {
    sb b = {0};
    sb_put(&b, "", 0);
    for (int i = 0; i < n; i++) { if (i) sb_put(&b, ".", 1); sb_fieldseg(&b, segs[i]); }
    return sb_take(&b);
}
static void *fs_path_new(char **segs, int n, int docid) {
    mvfs *f;
    void *obj = fs_new(C_PATH, FS_PATH, &f);
    f->i = docid;
    f->k = n;
    size_t len = 0;
    for (int i = 0; i < n; i++) len += strlen(segs[i]) + 1;
    f->bytes = malloc(len ? len : 1);
    f->nbytes = len;
    char *w = (char *)f->bytes;
    for (int i = 0; i < n; i++) { size_t l = strlen(segs[i]) + 1; memcpy(w, segs[i], l); w += l; }
    f->s = docid ? strdup("__name__") : fs_encode_segs(segs, n);
    return obj;
}
static char **fs_path_segs(mvfs *f) {   // array of k pointers into f->bytes (free the array only)
    char **v = calloc((size_t)f->k + 1, sizeof *v);
    char *p = (char *)f->bytes;
    for (int i = 0; i < f->k; i++) { v[i] = p; p += strlen(p) + 1; }
    return v;
}

// ------------------------------------------------------------- Java -> Firestore JSON
static int fs_val_json(sb *b, void *obj, void *db);
static int fs_list_json(sb *b, void *obj, void *db) {   // "values":[...] contents
    klj_list *l = fs_list_of(obj);
    klj_array *arr = l ? NULL : fs_arr(obj, 'L');
    int n = l ? l->count : (arr ? arr->len : -1);
    if (n < 0) return -1;
    for (int i = 0; i < n; i++) {
        if (i) sb_put(b, ",", 1);
        void *e = l ? l->items[i] : ((void **)arr->data)[i];
        if (fs_val_json(b, e, db) < 0) return -1;
    }
    return 0;
}
static int fs_val_json(sb *b, void *obj, void *db) {
    if (!obj) { sb_add(b, "{\"nullValue\":null}"); return 0; }
    klj_object *o = klj_as_object(obj);
    if (!o) return -1;
    const char *cls = o->cls;
    if (!strcmp(cls, KLJ_CLASS_STRING)) { sb_add(b, "{\"stringValue\":"); sb_jstr(b, o->data); sb_add(b, "}"); return 0; }
    if (!strcmp(cls, "java/lang/Boolean")) {
        klj_pref *e = o->data;
        sb_add(b, e && e->ival ? "{\"booleanValue\":true}" : "{\"booleanValue\":false}");
        return 0;
    }
    if (!strcmp(cls, "java/lang/Long") || !strcmp(cls, "java/lang/Integer") ||
        !strcmp(cls, "java/lang/Short") || !strcmp(cls, "java/lang/Byte")) {
        klj_pref *e = o->data;
        sb_addf(b, "{\"integerValue\":\"%lld\"}", (long long)(e ? e->ival : 0));
        return 0;
    }
    mvfs *f = fs_of(obj, 0);
    double d;
    if (!strcmp(cls, "java/lang/Float")) { klj_pref *e = o->data; d = e ? e->fval : 0; goto dbl; }
    if (f && f->kind == FS_DOUBLE) { d = f->x; goto dbl; }
    if (f && f->kind == FS_TS) { sb_add(b, "{\"timestampValue\":"); sb_ts(b, f->a, (int32_t)f->b); sb_add(b, "}"); return 0; }
    if (f && f->kind == FS_BLOB) { sb_add(b, "{\"bytesValue\":\""); sb_b64(b, f->bytes, f->nbytes); sb_add(b, "\"}"); return 0; }
    if (f && f->kind == FS_GEO) { sb_addf(b, "{\"geoPointValue\":{\"latitude\":%.17g,\"longitude\":%.17g}}", f->x, f->y); return 0; }
    if (f && f->kind == FS_DOC) {
        sb_add(b, "{\"referenceValue\":\"");
        sb_docname(b, f->db ? f->db : db, f->path);
        sb_add(b, "\"}");
        return 0;
    }
    if (f && f->kind == FS_FV) return -2;   // a sentinel: only a write places these
    if (mv_is_hashmap(obj)) {
        sb_add(b, "{\"mapValue\":{\"fields\":{");
        void *k, *v;
        for (unsigned i = 0; mv_hashmap_at(obj, i, &k, &v) > 0; i++) {
            const char *ks = klj_str(k);
            if (!ks) return -1;
            if (i) sb_put(b, ",", 1);
            sb_jstr(b, ks);
            sb_put(b, ":", 1);
            if (fs_val_json(b, v, db) < 0) return -1;
        }
        sb_add(b, "}}}");
        return 0;
    }
    if (fs_list_of(obj) || fs_arr(obj, 'L')) {
        sb_add(b, "{\"arrayValue\":{\"values\":[");
        if (fs_list_json(b, obj, db) < 0) return -1;
        sb_add(b, "]}}");
        return 0;
    }
    KLJ_LOG("Firestore: a %s is not a value Firestore stores", cls);
    return -1;
dbl:
    if (isnan(d)) sb_add(b, "{\"doubleValue\":\"NaN\"}");
    else if (isinf(d)) sb_add(b, d > 0 ? "{\"doubleValue\":\"Infinity\"}" : "{\"doubleValue\":\"-Infinity\"}");
    else sb_addf(b, "{\"doubleValue\":%.17g}", d);
    return 0;
}

// ------------------------------------------------------------- Firestore JSON -> Java
static void *fs_from_fields(void *db, const jv *fields);
static void *fs_from_value(void *db, const jv *v) {
    if (!v || v->t != 'o' || v->len < 1) return NULL;
    const char *k = v->k[0];
    const jv *x = v->v[0];
    if (!strcmp(k, "nullValue")) return NULL;
    if (!strcmp(k, "booleanValue")) return fs_box("java/lang/Boolean", 'Z', x->t == 'b' && x->n != 0);
    if (!strcmp(k, "integerValue"))
        return fs_box("java/lang/Long", 'J', x->s ? strtoll(x->s, NULL, 10) : (int64_t)x->n);
    if (!strcmp(k, "doubleValue")) {
        double d = x->n;
        if (x->t == 's') d = !strcmp(x->s, "NaN") ? NAN : !strcmp(x->s, "Infinity") ? INFINITY
                           : !strcmp(x->s, "-Infinity") ? -INFINITY : strtod(x->s, NULL);
        return fs_double(d);
    }
    if (!strcmp(k, "timestampValue")) {
        int64_t sec = 0; int32_t ns = 0;
        ts_parse(x->s, &sec, &ns);
        mvfs *f;
        void *obj = fs_new(C_TS, FS_TS, &f);
        f->a = sec; f->b = ns;
        return obj;
    }
    if (!strcmp(k, "stringValue")) return kl_jni_new_string(x->s ? x->s : "");
    if (!strcmp(k, "bytesValue")) {
        mvfs *f;
        void *obj = fs_new(C_BLOB, FS_BLOB, &f);
        f->bytes = unb64(x->s ? x->s : "", &f->nbytes);
        return obj;
    }
    if (!strcmp(k, "referenceValue")) {
        const char *p = x->s ? strstr(x->s, "/documents/") : NULL;
        return fs_ref(db, p ? p + 11 : "", 1);
    }
    if (!strcmp(k, "geoPointValue")) {
        mvfs *f;
        void *obj = fs_new(C_GEO, FS_GEO, &f);
        jv *la = jget(x, "latitude"), *lo = jget(x, "longitude");
        f->x = la ? la->n : 0; f->y = lo ? lo->n : 0;
        return obj;
    }
    if (!strcmp(k, "arrayValue")) {
        void *list = fs_list_new();
        jv *vals = jget(x, "values");
        for (int i = 0; vals && vals->t == 'a' && i < vals->len; i++) {
            void *e = fs_from_value(db, vals->v[i]);
            fs_list_add(list, e);
        }
        return list;
    }
    if (!strcmp(k, "mapValue")) return fs_from_fields(db, jget(x, "fields"));
    return NULL;
}
static void *fs_from_fields(void *db, const jv *fields) {
    void *map = mv_hashmap_new();
    for (int i = 0; fields && fields->t == 'o' && i < fields->len; i++)
        mv_hashmap_put(map, kl_jni_new_string(fields->k[i]), fs_from_value(db, fields->v[i]));
    return map;
}

// ------------------------------------------------------------- snapshots
static void *fs_snapshot(void *db, const char *path, const jv *doc, int from_query) {
    mvfs *f;
    void *obj = fs_new(from_query ? C_QDSNAP : C_DSNAP, FS_DSNAP, &f);
    f->db = db;
    f->path = strdup(path);
    f->i = doc != NULL;   // exists
    if (doc) {
        void *data = fs_from_fields(db, jget(doc, "fields"));
        fs_hold_in(f, data);
        f->o1 = data;
    }
    return obj;
}
static const char *fs_rel_name(const char *name) {
    const char *p = name ? strstr(name, "/documents/") : NULL;
    return p ? p + 11 : "";
}
// A field of a snapshot's data by path segments (found: 0 none, 1 yes).
static void *fs_walk(mvfs *s, char **segs, int n, int *found) {
    *found = 0;
    void *cur = s->o1;
    for (int i = 0; i < n; i++) {
        if (!cur || !mv_is_hashmap(cur)) return NULL;
        int f = 0;
        cur = mv_hashmap_get_utf(cur, segs[i], &f);
        if (!f) return NULL;
    }
    *found = 1;
    return cur;
}

// ------------------------------------------------------------- tasks
// A task holds itself until it has told a callback its outcome (j: that hold is
// still on): the SDK registers its JniResultCallback only after the call that
// made the task returned, and a task that failed at once must still be there.
static void *fs_task_new(const char *cls) {
    mvfs *f;
    void *t = fs_new(cls ? cls : C_TASK, FS_TASK, &f);
    klj_hold(t);
    f->j = 1;
    return t;
}
static void fs_task_deliver(void *task);
static void fs_continue(void *dep, void *src);

static void fs_task_finish(void *task, int state, void *result, void *exc, const char *msg) {
    mvfs *t = fs_of(task, FS_TASK);
    if (!t) return;
    pthread_mutex_lock(&fs_lock);
    if (t->state) { pthread_mutex_unlock(&fs_lock); return; }
    t->state = state;
    if (result) { fs_hold_in(t, result); t->o1 = result; }
    if (exc) { fs_hold_in(t, exc); t->o2 = exc; }
    t->s = fs_strdup(msg);
    void **deps = t->deps; int ndeps = t->ndeps;
    t->deps = NULL; t->ndeps = 0;
    pthread_cond_broadcast(&fs_cond);
    pthread_mutex_unlock(&fs_lock);
    for (int i = 0; i < ndeps; i++) { fs_continue(deps[i], task); klj_release(deps[i]); }
    free(deps);
    klj_hold(task);
    kl_mv_ui_later(fs_task_deliver, task);
}
static void fs_task_fail(void *task, int code, const char *msg) {
    fs_task_finish(task, 2, NULL, fs_exc(code, msg), msg);
}
static void *fs_failed_task(int code, const char *msg) {
    void *t = fs_task_new(NULL);
    KLJ_LOG("Firestore: %s", msg);
    fs_task_fail(t, code, msg);
    return t;
}
static void *fs_done_task(void *result) {
    void *t = fs_task_new(NULL);
    fs_task_finish(t, 1, result, NULL, NULL);
    return t;
}

typedef void (*fs_on_result_fn)(void *env, void *thiz, void *result, uint8_t success,
                                uint8_t cancelled, void *msg, int64_t fn, int64_t data);
static void fs_cb_call(void *cb, int state, void *result, void *exc, const char *msg) {
    mvfs *c = fs_of(cb, FS_CB);
    if (!c) return;
    pthread_mutex_lock(&fs_lock);
    int was = c->i;
    c->i = 1;   // delivered (once, whichever of completion and cancel() comes first)
    pthread_mutex_unlock(&fs_lock);
    if (was) return;
    fs_on_result_fn fn = (fs_on_result_fn)kl_jni_native(C_CB, "nativeOnResult",
                                                        "(Ljava/lang/Object;ZZLjava/lang/String;JJ)V");
    if (!fn) { KLJ_LOG("Firestore: JniResultCallback.nativeOnResult is not registered"); return; }
    void *env = kl_jni_env();
    void *jmsg = state == 2 ? kl_jni_new_string(msg ? msg : "") : state == 3 ? kl_jni_new_string("cancelled") : NULL;
    fn(env, cb, state == 1 ? result : state == 2 ? exc : NULL, state == 1, state == 3, jmsg, c->a, c->b);
    if (jmsg) klj_release(jmsg);
}
// On the UI drain: every callback registered so far hears the outcome.
static void fs_task_deliver(void *task) {
    mvfs *t = fs_of(task, FS_TASK);
    if (t) {
        pthread_mutex_lock(&fs_lock);
        void **cbs = t->cbs; int n = t->ncbs;
        t->cbs = NULL; t->ncbs = 0;
        int state = t->state; void *res = t->o1, *exc = t->o2;
        char *msg = fs_strdup(t->s);
        pthread_mutex_unlock(&fs_lock);
        for (int i = 0; i < n; i++) { fs_cb_call(cbs[i], state, res, exc, msg); klj_release(cbs[i]); }
        free(cbs);
        free(msg);
        pthread_mutex_lock(&fs_lock);
        int self_hold = n > 0 && t->j;
        if (self_hold) t->j = 0;
        pthread_mutex_unlock(&fs_lock);
        if (self_hold) klj_release(task);
    }
    klj_release(task);
}
// failTaskWhenResultIsNull's continuation: `dep` takes `src`'s outcome.
static void fs_continue(void *dep, void *src) {
    mvfs *s = fs_of(src, FS_TASK), *d = fs_of(dep, FS_TASK);
    if (!s || !d) return;
    if (s->state == 1 && s->o1) fs_task_finish(dep, 1, s->o1, NULL, NULL);
    else if (s->state == 1) fs_task_fail(dep, E_NOT_FOUND, d->s2 ? d->s2 : "not found");
    else if (s->state == 2) fs_task_finish(dep, 2, NULL, s->o2, s->s);
    else fs_task_finish(dep, 3, NULL, NULL, NULL);
}

// ------------------------------------------------------------- requests
enum { OP_GET_DOC, OP_QUERY, OP_COMMIT, OP_COUNT, OP_LISTEN_DOC, OP_LISTEN_QUERY };
typedef struct {
    int   what;
    void *db, *task, *reg, *subject, *result;   // held while the request runs
    char *path;        // OP_GET_DOC, OP_LISTEN_DOC: the document
    int   last;        // limitToLast: results come back reversed
    char *touched;     // OP_COMMIT: "\n"-joined document paths written
} fs_op;

static void fs_op_free(fs_op *op) {
    if (op->task) klj_release(op->task);
    if (op->reg) klj_release(op->reg);
    if (op->subject) klj_release(op->subject);
    if (op->result) klj_release(op->result);
    free(op->path);
    free(op->touched);
    free(op);
}
static fs_op *fs_op_new(int what, void *db, void *task, void *subject) {
    fs_op *op = calloc(1, sizeof *op);
    op->what = what;
    op->db = db;
    if (task) { op->task = task; klj_hold(task); }
    if (subject) { op->subject = subject; klj_hold(subject); }
    return op;
}

static void fs_net_done(void *ctx, int status, const char *body, long len, const char *err);
static void fs_op_error(fs_op *op, int code, const char *msg);

static const char *fs_offline_msg(int what) {
    return what == OP_COMMIT ? "Failed to commit the write because the client is offline."
         : what == OP_GET_DOC || what == OP_LISTEN_DOC ? "Failed to get document because the client is offline."
         : "Failed to get documents because the client is offline.";
}
// POST <base><suffix> with `body`. The op is finished (and freed) by fs_net_done.
static void fs_send(fs_op *op, const char *suffix, const char *body) {
    fs_dbinfo *d = fs_dbi(op->db);
    if (!d || !d->project || !*d->project) {
        fs_op_error(op, E_FAILED_PRECONDITION, "No Firebase project id: the title's FirebaseOptions carry none.");
        return;
    }
    if (!d->net) { fs_op_error(op, E_UNAVAILABLE, fs_offline_msg(op->what)); return; }
    sb url = {0};
    sb_add(&url, d->ssl ? "https://" : "http://");
    sb_add(&url, d->host);
    sb_add(&url, "/v1/projects/");
    sb_urlseg(&url, d->project);
    sb_add(&url, "/databases/");
    sb_add(&url, d->db);
    sb_add(&url, "/documents");
    sb_urlseg(&url, suffix);
    sb hdr = {0};
    sb_add(&hdr, "Content-Type: application/json\n");
    sb_addf(&hdr, "google-cloud-resource-prefix: projects/%s/databases/%s\n", d->project, d->db);
    if (d->appid) sb_addf(&hdr, "x-firebase-gmpid: %s\n", d->appid);
    mv_net_fetch("POST", url.p, hdr.p, body, (long)strlen(body), 30.0, fs_net_done, op);
    free(url.p);
    free(hdr.p);
}

// ---- listeners
static void **fs_regs; static int fs_nregs;   // active registrations (held)
typedef struct { void *reg, *value, *exc; } fs_event;
typedef void (*fs_on_event_fn)(void *env, void *clazz, int64_t fs, int64_t listener, void *value, void *exc);
static void fs_event_deliver(void *p) {
    fs_event *ev = p;
    mvfs *r = fs_of(ev->reg, FS_REG);
    mvfs *l = r ? fs_of(r->o1, FS_LISTENER) : NULL;
    if (r && l && !r->k && l->a && l->b) {
        const char *cls = fs_cls(r->o1);
        fs_on_event_fn fn = (fs_on_event_fn)kl_jni_native(cls, "nativeOnEvent",
            "(JJLjava/lang/Object;Lcom/google/firebase/firestore/FirebaseFirestoreException;)V");
        if (fn) fn(kl_jni_env(), kl_jni_class(cls), l->a, l->b, ev->value, ev->exc);
        else KLJ_LOG("Firestore: %s.nativeOnEvent is not registered", cls);
    }
    if (ev->value) klj_release(ev->value);
    if (ev->exc) klj_release(ev->exc);
    klj_release(ev->reg);
    free(ev);
}
static void fs_event_post(void *reg, void *value, void *exc) {
    fs_event *ev = calloc(1, sizeof *ev);
    ev->reg = reg; klj_hold(reg);
    if (value) { ev->value = value; klj_hold(value); }
    if (exc) { ev->exc = exc; klj_hold(exc); }
    kl_mv_ui_later(fs_event_deliver, ev);
}

static void fs_op_error(fs_op *op, int code, const char *msg) {
    KLJ_LOG("Firestore: request failed: %s (code %d)", msg, code);
    void *exc = fs_exc(code, msg);
    if (op->task) fs_task_finish(op->task, 2, NULL, exc, msg);
    else if (op->reg) fs_event_post(op->reg, NULL, exc);
    else klj_release(exc);
    fs_op_free(op);
}

static void fs_query_send(fs_op *op, fs_query *q, int count);
static void fs_doc_send(fs_op *op);

// Re-read what a registration watches.
static void fs_reg_fetch(void *reg) {
    mvfs *r = fs_of(reg, FS_REG);
    if (!r || r->k) return;
    mvfs *s = fs_of(r->o2, 0);
    if (!s) return;
    fs_op *op = fs_op_new(r->i ? OP_LISTEN_QUERY : OP_LISTEN_DOC, s->db, NULL, r->o2);
    op->reg = reg; klj_hold(reg);
    if (r->i) fs_query_send(op, &s->q, 0);
    else { op->path = strdup(s->path); fs_doc_send(op); }
}
// After this client's commit: the listeners on what it wrote hear again.
static void fs_refresh_after(const char *touched) {
    pthread_mutex_lock(&fs_lock);
    int n = fs_nregs;
    void **regs = malloc((size_t)(n ? n : 1) * sizeof *regs);
    for (int i = 0; i < n; i++) { regs[i] = fs_regs[i]; klj_hold(regs[i]); }
    pthread_mutex_unlock(&fs_lock);
    for (int i = 0; i < n; i++) {
        mvfs *r = fs_of(regs[i], FS_REG);
        mvfs *s = r ? fs_of(r->o2, 0) : NULL;
        int hit = 0;
        for (const char *t = touched; s && t && *t && !hit; ) {
            const char *e = strchr(t, '\n');
            size_t l = e ? (size_t)(e - t) : strlen(t);
            char *doc = strndup(t, l);
            if (!r->i) hit = s->path && !strcmp(doc, s->path);
            else {
                char *parent = fs_parent(doc);
                if (s->q.group) hit = parent && !strcmp(fs_last(parent), s->q.coll);
                else hit = parent && s->q.coll && !strcmp(parent, s->q.coll);
                free(parent);
            }
            free(doc);
            t = e ? e + 1 : NULL;
        }
        if (hit) fs_reg_fetch(regs[i]);
        klj_release(regs[i]);
    }
    free(regs);
}

// ---- building requests
static void fs_doc_send(fs_op *op) {
    sb b = {0};
    sb_add(&b, "{\"documents\":[\"");
    sb_docname(&b, op->db, op->path);
    sb_add(&b, "\"]}");
    fs_send(op, ":batchGet", b.p);
    free(b.p);
}
static void sb_order(sb *b, const char *path, size_t len, int desc) {
    char *p = strndup(path, len);
    sb_add(b, "{\"field\":{\"fieldPath\":");
    sb_jstr(b, p);
    sb_add(b, desc ? "},\"direction\":\"DESCENDING\"}" : "},\"direction\":\"ASCENDING\"}");
    free(p);
}
static void sb_cursor(sb *b, const char *key, const char *values, int before) {
    sb_add(b, key);
    sb_add(b, "{\"values\":[");
    sb_add(b, values);
    sb_add(b, before ? "],\"before\":true}" : "],\"before\":false}");
}
// The structuredQuery object for q. limitToLast runs turned around — every
// order reversed, the cursors swapped (an inclusive end becomes an inclusive
// start, so "before" flips) — and its results are reversed back on arrival.
static void sb_query(sb *b, fs_query *q) {
    int last = q->last && q->limit > 0;
    sb_add(b, "{\"from\":[{\"collectionId\":");
    sb_jstr(b, q->group ? q->coll : fs_last(q->coll));
    sb_add(b, q->group ? ",\"allDescendants\":true}]" : "}]");
    if (q->filters) {
        if (q->nfilters > 1) {
            sb_add(b, ",\"where\":{\"compositeFilter\":{\"op\":\"AND\",\"filters\":[");
            sb_add(b, q->filters);
            sb_add(b, "]}}");
        } else {
            sb_add(b, ",\"where\":");
            sb_add(b, q->filters);
        }
    }
    int norders = q->order_dirs ? (int)strlen(q->order_dirs) : 0;
    if (norders || q->name_order || last) {
        sb_add(b, ",\"orderBy\":[");
        const char *p = q->order_paths ? q->order_paths : "";
        int has_name = 0;
        for (int i = 0; i < norders; i++) {
            const char *e = strchr(p, '\n');
            size_t l = e ? (size_t)(e - p) : strlen(p);
            if (l == 8 && !strncmp(p, "__name__", 8)) has_name = 1;
            if (i) sb_put(b, ",", 1);
            sb_order(b, p, l, (q->order_dirs[i] == 'D') != last);
            p = e ? e + 1 : p + l;
        }
        if (!has_name && (q->name_order || last)) {
            if (norders) sb_put(b, ",", 1);
            sb_order(b, "__name__", 8, (norders && q->order_dirs[norders - 1] == 'D') != last);
        }
        sb_add(b, "]");
    }
    if (!last) {
        if (q->start) sb_cursor(b, ",\"startAt\":", q->start, q->start_before);
        if (q->end) sb_cursor(b, ",\"endAt\":", q->end, q->end_before);
    } else {
        if (q->end) sb_cursor(b, ",\"startAt\":", q->end, !q->end_before);
        if (q->start) sb_cursor(b, ",\"endAt\":", q->start, !q->start_before);
    }
    if (q->limit > 0) sb_addf(b, ",\"limit\":%lld", q->limit);
    sb_add(b, "}");
}
static void fs_query_send(fs_op *op, fs_query *q, int count) {
    op->last = q->last && q->limit > 0;
    sb b = {0};
    if (count) sb_add(&b, "{\"structuredAggregationQuery\":{\"structuredQuery\":");
    else sb_add(&b, "{\"structuredQuery\":");
    sb_query(&b, q);
    if (count) sb_add(&b, ",\"aggregations\":[{\"alias\":\"count\",\"count\":{}}]}}");
    else sb_add(&b, "}");
    sb suffix = {0};
    sb_put(&suffix, "", 0);
    char *parent = q->group ? NULL : fs_parent(q->coll);
    if (parent) { sb_add(&suffix, "/"); sb_add(&suffix, parent); free(parent); }
    sb_add(&suffix, count ? ":runAggregationQuery" : ":runQuery");
    fs_send(op, suffix.p, b.p);
    free(suffix.p);
    free(b.p);
}

// ---- answers
static int fs_status_code(const char *status, int http) {
    static const char *const names[E_N] = {"OK", "CANCELLED", "UNKNOWN", "INVALID_ARGUMENT",
        "DEADLINE_EXCEEDED", "NOT_FOUND", "ALREADY_EXISTS", "PERMISSION_DENIED", "RESOURCE_EXHAUSTED",
        "FAILED_PRECONDITION", "ABORTED", "OUT_OF_RANGE", "UNIMPLEMENTED", "INTERNAL", "UNAVAILABLE",
        "DATA_LOSS", "UNAUTHENTICATED"};
    for (int i = 0; status && i < E_N; i++) if (!strcmp(status, names[i])) return i;
    switch (http) {
    case 400: return E_INVALID_ARGUMENT;   case 401: return E_UNAUTHENTICATED;
    case 403: return E_PERMISSION_DENIED;  case 404: return E_NOT_FOUND;
    case 409: return E_ABORTED;            case 412: return E_FAILED_PRECONDITION;
    case 429: return E_RESOURCE_EXHAUSTED; case 499: return E_CANCELLED;
    case 501: return E_UNIMPLEMENTED;      case 503: return E_UNAVAILABLE;
    case 504: return E_DEADLINE_EXCEEDED;  default: return http >= 500 ? E_INTERNAL : E_UNKNOWN;
    }
}
// An {"error":{...}} anywhere at the top (an object, or the first element of a stream).
static const jv *fs_error_of(const jv *r) {
    if (!r) return NULL;
    if (r->t == 'o') return jget(r, "error");
    for (int i = 0; r->t == 'a' && i < r->len; i++) { const jv *e = jget(r->v[i], "error"); if (e) return e; }
    return NULL;
}

static void fs_net_done(void *ctx, int status, const char *body, long len, const char *err) {
    (void)len;
    fs_op *op = ctx;
    if (status == 0) {
        KLJ_LOG("Firestore: no response (%s)", err ? err : "offline");
        fs_op_error(op, E_UNAVAILABLE, fs_offline_msg(op->what));
        return;
    }
    jv *r = jparse_all(body);
    const jv *e = fs_error_of(r);
    if (status >= 300 || e) {
        const char *m = e ? jgets(e, "message") : NULL;
        int code = fs_status_code(e ? jgets(e, "status") : NULL, status);
        char msg[512];
        snprintf(msg, sizeof msg, "%s", m ? m : "The Firestore request failed.");
        KLJ_LOG("Firestore: HTTP %d", status);
        jfree(r);
        fs_op_error(op, code, msg);
        return;
    }
    if (!r) { fs_op_error(op, E_INTERNAL, "The Firestore response was not JSON."); return; }
    void *value = NULL;
    switch (op->what) {
    case OP_GET_DOC: case OP_LISTEN_DOC: {
        const jv *found = NULL;
        for (int i = 0; r->t == 'a' && i < r->len; i++)
            if ((found = jget(r->v[i], "found"))) break;
        value = fs_snapshot(op->db, op->path, found, 0);
        KLJ_LOG("Firestore: get \"%s\" -> %s", op->path, found ? "exists" : "does not exist");
        break;
    }
    case OP_QUERY: case OP_LISTEN_QUERY: {
        mvfs *qs;
        value = fs_new(C_QSNAP, FS_QSNAP, &qs);
        qs->db = op->db;
        fs_hold_in(qs, op->subject);
        qs->o1 = op->subject;
        void *docs = fs_list_new();
        fs_hold_in(qs, docs);
        qs->o2 = docs;
        int n = 0;
        for (int i = 0; r->t == 'a' && i < r->len; i++) {
            int k = op->last ? r->len - 1 - i : i;
            const jv *doc = jget(r->v[k], "document");
            if (!doc) continue;
            fs_list_add(docs, fs_snapshot(op->db, fs_rel_name(jgets(doc, "name")), doc, 1));
            n++;
        }
        KLJ_LOG("Firestore: query -> %d document%s", n, n == 1 ? "" : "s");
        break;
    }
    case OP_COUNT: {
        int64_t count = 0;
        for (int i = 0; r->t == 'a' && i < r->len; i++) {
            const jv *v = jget(jget(jget(r->v[i], "result"), "aggregateFields"), "count");
            const char *s = jgets(v, "integerValue");
            if (s) count = strtoll(s, NULL, 10);
        }
        mvfs *a;
        value = fs_new(C_AGGS, FS_AGGS, &a);
        a->a = count;
        fs_hold_in(a, op->subject);
        a->o1 = op->subject;
        break;
    }
    case OP_COMMIT:
        value = op->result;   // add(): the new document's reference; else null
        KLJ_LOG("Firestore: commit -> ok");
        break;
    }
    jfree(r);
    if (op->task) fs_task_finish(op->task, 1, value, NULL, NULL);   // the task holds the value
    else if (op->reg) fs_event_post(op->reg, value, NULL);          // ...or the event does
    char *touched = op->what == OP_COMMIT ? fs_strdup(op->touched) : NULL;
    fs_op_free(op);
    if (touched) { fs_refresh_after(touched); free(touched); }
}

// ------------------------------------------------------------- writes
// A write's fields as a tree, so dotted update keys and nested maps merge.
typedef struct wn { char *name; char *json; struct wn **kids; int nk; } wn;
static void wn_clear(wn *n) {   // its value and children go; its name stays
    for (int i = 0; i < n->nk; i++) { wn_clear(n->kids[i]); free(n->kids[i]->name); free(n->kids[i]); }
    free(n->kids); free(n->json);
    n->kids = NULL; n->nk = 0; n->json = NULL;
}
static wn *wn_child(wn *n, const char *name) {
    for (int i = 0; i < n->nk; i++) if (!strcmp(n->kids[i]->name, name)) return n->kids[i];
    wn *c = calloc(1, sizeof *c);
    c->name = strdup(name);
    n->kids = realloc(n->kids, (size_t)(n->nk + 1) * sizeof *n->kids);
    n->kids[n->nk++] = c;
    return c;
}
static void wn_set(wn *root, char **segs, int n, const char *json) {
    wn *cur = root;
    for (int i = 0; i < n; i++) {
        if (cur->json) { free(cur->json); cur->json = NULL; }
        cur = wn_child(cur, segs[i]);
    }
    wn_clear(cur);
    cur->json = strdup(json);
}
static void wn_emit(sb *b, wn *n) {
    sb_put(b, "{", 1);
    for (int i = 0; i < n->nk; i++) {
        if (i) sb_put(b, ",", 1);
        sb_jstr(b, n->kids[i]->name);
        sb_put(b, ":", 1);
        if (n->kids[i]->json) sb_add(b, n->kids[i]->json);
        else { sb_add(b, "{\"mapValue\":{\"fields\":"); wn_emit(b, n->kids[i]); sb_add(b, "}}"); }
    }
    sb_put(b, "}", 1);
}

enum { W_SET, W_MERGE, W_MERGE_FIELDS, W_UPDATE };
typedef struct {
    int mode;
    void *db;
    wn root;
    sb transforms; int ntransforms;
    sb mask; int nmask;
    int err;
} fs_w;

static void fs_w_mask(fs_w *w, char **segs, int n) {
    char *p = fs_encode_segs(segs, n);
    if (w->nmask++) sb_put(&w->mask, ",", 1);
    sb_jstr(&w->mask, p);
    free(p);
}
// One value at a field path: sentinels become transforms or masked deletes,
// maps are walked, everything else is a leaf.
static void fs_w_value(fs_w *w, char **segs, int n, void *v, int depth) {
    if (w->err || depth > 64) { w->err = 1; return; }
    mvfs *f = fs_of(v, FS_FV);
    if (f) {
        if (f->i == 1) {   // delete: masked, with no value (an update masks its keys itself)
            if (w->mode == W_SET || (w->mode == W_UPDATE && depth > 0)) { w->err = 1; return; }
            if (w->mode == W_MERGE) fs_w_mask(w, segs, n);
            return;
        }
        char *p = fs_encode_segs(segs, n);
        if (w->ntransforms++) sb_put(&w->transforms, ",", 1);
        sb_add(&w->transforms, "{\"fieldPath\":");
        sb_jstr(&w->transforms, p);
        free(p);
        switch (f->i) {
        case 2: sb_add(&w->transforms, ",\"setToServerValue\":\"REQUEST_TIME\"}"); break;
        case 3: case 4: sb_add(&w->transforms, ",\"increment\":"); sb_add(&w->transforms, f->s); sb_add(&w->transforms, "}"); break;
        case 5: sb_add(&w->transforms, ",\"appendMissingElements\":{\"values\":["); sb_add(&w->transforms, f->s); sb_add(&w->transforms, "]}}"); break;
        default: sb_add(&w->transforms, ",\"removeAllFromArray\":{\"values\":["); sb_add(&w->transforms, f->s); sb_add(&w->transforms, "]}}"); break;
        }
        return;
    }
    if (mv_is_hashmap(v)) {
        void *k, *x;
        int any = 0;
        for (unsigned i = 0; mv_hashmap_at(v, i, &k, &x) > 0; i++) {
            const char *ks = klj_str(k);
            if (!ks) { w->err = 1; return; }
            char **s2 = malloc((size_t)(n + 1) * sizeof *s2);
            if (n) memcpy(s2, segs, (size_t)n * sizeof *s2);
            s2[n] = (char *)ks;
            fs_w_value(w, s2, n + 1, x, depth + 1);
            free(s2);
            any = 1;
        }
        if (any || n == 0) return;
        // an empty map is a value of its own
    }
    sb b = {0};
    if (fs_val_json(&b, v, w->db) < 0) { free(b.p); w->err = 1; return; }
    if (n == 0) { free(b.p); w->err = 1; return; }   // the document itself must be a map
    wn_set(&w->root, segs, n, b.p);
    if (w->mode == W_MERGE) fs_w_mask(w, segs, n);
    free(b.p);
}
// The write object for one document; NULL (and *code) when the data cannot be written.
static char *fs_write_json(fs_w *w, const char *path, int exists_precondition) {
    if (w->err) return NULL;
    sb b = {0};
    sb_add(&b, "{\"update\":{\"name\":\"");
    sb_docname(&b, w->db, path);
    sb_add(&b, "\",\"fields\":");
    wn_emit(&b, &w->root);
    sb_add(&b, "}");
    if (w->mode != W_SET) {
        sb_add(&b, ",\"updateMask\":{\"fieldPaths\":[");
        if (w->mask.p) sb_add(&b, w->mask.p);
        sb_add(&b, "]}");
    }
    if (w->ntransforms) { sb_add(&b, ",\"updateTransforms\":["); sb_add(&b, w->transforms.p); sb_add(&b, "]"); }
    if (exists_precondition) sb_add(&b, ",\"currentDocument\":{\"exists\":true}");
    sb_add(&b, "}");
    return sb_take(&b);
}
static void fs_w_done(fs_w *w) { wn_clear(&w->root); free(w->transforms.p); free(w->mask.p); }

// set(data, options): NULL when the data cannot be written.
static char *fs_set_write(void *db, const char *path, void *data, void *options) {
    fs_w w = {0};
    w.db = db;
    mvfs *o = fs_of(options, FS_SETOPT);
    w.mode = !o || o->i == 0 ? W_SET : o->i == 1 ? W_MERGE : W_MERGE_FIELDS;
    if (w.mode == W_MERGE_FIELDS && o->s) { sb_add(&w.mask, o->s); w.nmask = 1; }
    if (!mv_is_hashmap(data)) w.err = 1;
    else fs_w_value(&w, NULL, 0, data, 0);
    char *r = fs_write_json(&w, path, 0);
    fs_w_done(&w);
    return r;
}
// update(Map): the keys are dotted field paths.
static char *fs_update_map_write(void *db, const char *path, void *data) {
    fs_w w = {0};
    w.db = db;
    w.mode = W_UPDATE;
    void *k, *v;
    if (!mv_is_hashmap(data)) w.err = 1;
    for (unsigned i = 0; !w.err && mv_hashmap_at(data, i, &k, &v) > 0; i++) {
        const char *ks = klj_str(k);
        if (!ks || !*ks) { w.err = 1; break; }
        char *copy = strdup(ks), *segs[64];
        int n = 0;
        for (char *save = NULL, *t = strtok_r(copy, ".", &save); t && n < 64; t = strtok_r(NULL, ".", &save)) segs[n++] = t;
        mvfs *fv = fs_of(v, FS_FV);
        if (!fv || fv->i == 1) fs_w_mask(&w, segs, n);
        fs_w_value(&w, segs, n, v, 0);
        free(copy);
    }
    char *r = fs_write_json(&w, path, 1);
    fs_w_done(&w);
    return r;
}
// update(FieldPath, value, Object... moreFieldsAndValues)
static char *fs_update_pairs_write(void *db, const char *path, void *fp, void *val, void *more) {
    fs_w w = {0};
    w.db = db;
    w.mode = W_UPDATE;
    klj_array *arr = fs_arr(more, 'L');
    int extra = arr ? arr->len : 0;
    if (extra % 2) w.err = 1;
    for (int i = -1; !w.err && i < extra / 2; i++) {
        void *p = i < 0 ? fp : ((void **)arr->data)[2 * i];
        void *v = i < 0 ? val : ((void **)arr->data)[2 * i + 1];
        mvfs *pf = fs_of(p, FS_PATH);
        if (!pf || pf->i) { w.err = 1; break; }
        char **segs = fs_path_segs(pf);
        mvfs *fv = fs_of(v, FS_FV);
        if (!fv || fv->i == 1) fs_w_mask(&w, segs, pf->k);
        fs_w_value(&w, segs, pf->k, v, 0);
        free(segs);
    }
    char *r = fs_write_json(&w, path, 1);
    fs_w_done(&w);
    return r;
}
static char *fs_delete_write(void *db, const char *path) {
    sb b = {0};
    sb_add(&b, "{\"delete\":\"");
    sb_docname(&b, db, path);
    sb_add(&b, "\"}");
    return sb_take(&b);
}
// One :commit of `writes` ("," joined); `result` is what the task succeeds with.
static void *fs_commit(void *db, const char *writes, const char *touched, void *result) {
    void *task = fs_task_new(NULL);
    fs_op *op = fs_op_new(OP_COMMIT, db, task, NULL);
    if (result) { op->result = result; klj_hold(result); }
    op->touched = fs_strdup(touched);
    sb b = {0};
    sb_add(&b, "{\"writes\":[");
    sb_add(&b, writes);
    sb_add(&b, "]}");
    fs_send(op, ":commit", b.p);
    free(b.p);
    return task;
}
static void *fs_write_task(void *db, char *write, const char *path, void *result) {
    if (!write) return fs_failed_task(E_INVALID_ARGUMENT, "Invalid data: a value Firestore cannot store, "
                                      "or FieldValue.delete() where it is not allowed.");
    void *t = fs_commit(db, write, path, result);
    free(write);
    return t;
}

// ------------------------------------------------------------- bindings: FirebaseFirestore
#define B(name) static klj_val name(void *env, void *self, const klj_val *a, int n)
#define ARG(i) (n > (i) ? a[i].l : NULL)
#define RET(x) return (klj_val){.l = (x)}
#define RETJ(x) return (klj_val){.j = (uint64_t)(int64_t)(x)}

#define FS_DB_MAX 8
static void *fs_dbs[FS_DB_MAX];
static void *fs_dbs_app[FS_DB_MAX];

B(fs_FF_getInstance) {
    (void)env; (void)self;
    void *app = ARG(0);
    const char *dbid = ARG(1) ? klj_str(ARG(1)) : NULL;
    if (!dbid || !*dbid) dbid = "(default)";
    if (!app) { KLJ_LOG("FirebaseFirestore.getInstance: no FirebaseApp"); RET(NULL); }
    pthread_mutex_lock(&fs_lock);
    for (int i = 0; i < FS_DB_MAX; i++)
        if (fs_dbs[i] && fs_dbs_app[i] == app && !strcmp(fs_dbi(fs_dbs[i])->db, dbid)) {
            void *found = fs_dbs[i];
            pthread_mutex_unlock(&fs_lock);
            RET(found);
        }
    pthread_mutex_unlock(&fs_lock);
    void *opts = klj_call_binding(app, "getOptions", "()Lcom/google/firebase/FirebaseOptions;", NULL, 0).l;
    void *proj = opts ? klj_call_binding(opts, "getProjectId", "()Ljava/lang/String;", NULL, 0).l : NULL;
    void *appid = opts ? klj_call_binding(opts, "getApplicationId", "()Ljava/lang/String;", NULL, 0).l : NULL;
    fs_dbinfo *d = calloc(1, sizeof *d);
    d->db = strdup(dbid);
    d->project = proj && klj_str(proj) && *klj_str(proj) ? strdup(klj_str(proj)) : NULL;
    d->appid = appid && klj_str(appid) ? strdup(klj_str(appid)) : NULL;
    d->host = strdup("firestore.googleapis.com");
    d->ssl = 1; d->persist = 1; d->net = 1; d->cache = 100 * 1024 * 1024;
    if (proj) klj_release(proj);
    if (appid) klj_release(appid);
    mvfs *f;
    void *db = fs_new(C_FF, FS_DB, &f);
    f->dbi = d;
    f->db = db;
    kl_jni_pin_object(db);
    pthread_mutex_lock(&fs_lock);
    for (int i = 0; i < FS_DB_MAX; i++) if (!fs_dbs[i]) { fs_dbs[i] = db; fs_dbs_app[i] = app; break; }
    pthread_mutex_unlock(&fs_lock);
    KLJ_LOG("FirebaseFirestore.getInstance(\"%s\") -> an instance on the Firestore REST API%s", dbid,
            d->project ? "" : " (no project id among the app's options: every request will fail)");
    RET(db);
}
B(fs_noop) { (void)env; (void)self; (void)a; (void)n; return (klj_val){0}; }
B(fs_FF_collection) {
    (void)env;
    mvfs *f = fs_of(self, FS_DB);
    const char *p = ARG(0) ? klj_str(ARG(0)) : NULL;
    if (!f || fs_segments(p) < 0 || fs_segments(p) % 2 == 0) RET(fs_bad_path("collection", p));
    RET(fs_ref(self, p, 0));
}
B(fs_FF_document) {
