    s = open(path).read()
    if marker in s:
        return
    if s.count(old) != 1:
        sys.exit(f"overlay: anchor moved upstream in {path}: {old[:60]!r}")
    open(path, "w").write(s.replace(old, new))

J = f"{rt}/kl_jni.c"
patch(J,
      "static void *klj_ExceptionOccurred(void *env) { (void)env; return NULL; }\n"
      "static void  klj_ExceptionDescribe(void *env) { (void)env; }\n"
      "static void  klj_ExceptionClear(void *env)    { (void)env; }\n"
      " kl_jint klj_ExceptionCheck(void *env)  { (void)env; return 0; }\n",
      "// metavision: Java exceptions — one pending throwable per thread.\n"
      "static __thread void *klj_pending;\n"
      "void kl_jni_throw(const char *cls) {\n"
      "    klj_pending = kl_jni_new_object(cls);\n"
      "    KLJ_LOG(\"throw %s\", cls);\n"
      "}\n"
      "static void *klj_ExceptionOccurred(void *env) { (void)env; return klj_pending; }\n"
      "static void  klj_ExceptionDescribe(void *env) {\n"
      "    (void)env;\n"
      "    if (klj_pending) KLJ_LOG(\"ExceptionDescribe: %s\", klj_as_object(klj_pending) ? klj_as_object(klj_pending)->cls : \"?\");\n"
      "}\n"
      "static void  klj_ExceptionClear(void *env)    { (void)env; klj_pending = NULL; }\n"
      " kl_jint klj_ExceptionCheck(void *env)  { (void)env; return klj_pending != NULL; }\n"
      "static kl_jint klj_Throw(void *env, void *obj) { (void)env; klj_pending = obj; return 0; }\n"
      "static kl_jint klj_ThrowNew(void *env, void *clazz, const char *msg) {\n"
      "    (void)env; (void)msg;\n"
