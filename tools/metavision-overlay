    char buf[2048], killed[256] = "";
    ssize_t n = pread(fd, buf, sizeof buf - 1, 0);
    if (n > 0) {
        buf[n] = '\0';
        while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r')) buf[--n] = '\0';
        const char *last = strrchr(buf, '\n');
        snprintf(killed, sizeof killed, "%.255s", last ? last + 1 : buf);
    }
