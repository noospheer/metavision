static void *fs_setopt_overwrite(void);
// Static object fields of Firestore's classes (the enum constants,
// SetOptions.OVERWRITE), answered from kl_jni.c's field lookup (step 146).
int mv_fs_static_field(const char *cls, const char *name, klj_val *out) {
    if (!cls || strncmp(cls, FS_PKG, sizeof FS_PKG - 1) != 0) return 0;
    if (!strcmp(cls, C_SETOPT) && !strcmp(name, "OVERWRITE")) { out->l = fs_setopt_overwrite(); return 1; }
    for (int e = 0; e < EN_N; e++) {
        if (strcmp(cls, fs_enums[e].cls)) continue;
        for (int i = 0; i < 18 && fs_enums[e].names[i]; i++)
            if (!strcmp(name, fs_enums[e].names[i])) { out->l = fs_enum(e, i); return 1; }
    }
    return 0;
}

