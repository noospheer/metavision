        ue.gt_ok = kl_sym(im, "GIsGameThreadIdInitialized");
        if (!ue.gt || !ue.gt_ok) {
            fprintf(stderr, "[mv-autoplay-ui] off: libUE4 lacks an export (GGameThreadId)\n");
            on = 0; return;
