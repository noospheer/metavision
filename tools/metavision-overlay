// [m0, m1, -m4, -m5, 0, 0] of the SurfaceTexture's matrix on the fast-OES
// path, null otherwise — exactly what the Java returns.
static klj_val avp_transform(void *env, void *self, const klj_val *a, int n) {
    (void)env; (void)a; (void)n;
    avp *p = avp_of(self);
