#define MV_CAND 192
static void mv_press_tick(void) {
    static int on = -1, bound;
    static double t0, next, every, hold, gap;
    static unsigned maxt;
    if (on < 0) {
        on = kl_env_on("MV_AUTOPLAY_UI", kl_env_on("MV_AUTOPLAY", 0));
        every = kl_env_uint("MV_AUTOPLAY_UI_EVERY", 4); if (!every) every = 4;
        hold  = kl_env_uint("MV_AUTOPLAY_UI_HOLD_MS", 300) / 1000.0;
        gap   = kl_env_uint("MV_AUTOPLAY_UI_GAP", 12);
        maxt  = kl_env_uint("MV_AUTOPLAY_UI_MAX", 3);
