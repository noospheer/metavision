// A push id: 8 characters of time (ms), 12 random, in an order-preserving alphabet.
static const char db_push_chars[] = "-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz";
static int db_rand64(void) {
#if defined(__APPLE__)
    return (int)arc4random_uniform(64);
#else
    return (int)(random() & 63);
#endif
}
static char *db_push_id(void) {
    static int64_t last_ms;
    static int last_rand[12];
    struct timespec ts;
    clock_gettime(CLOCK_REALTIME, &ts);
    int64_t now = (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
    char id[21];
    pthread_mutex_lock(&db_lock);
    int dup = now == last_ms;
    last_ms = now;
    for (int i = 7; i >= 0; i--) { id[i] = db_push_chars[now % 64]; now /= 64; }
    if (!dup) {
        for (int i = 0; i < 12; i++) last_rand[i] = db_rand64();
    } else {   // the same millisecond: the previous random part plus one, so ids stay ordered
        int i = 11;
        for (; i >= 0 && last_rand[i] == 63; i--) last_rand[i] = 0;
        if (i >= 0) last_rand[i]++;
    }
    for (int i = 0; i < 12; i++) id[8 + i] = db_push_chars[last_rand[i]];
    pthread_mutex_unlock(&db_lock);
    id[20] = 0;
    return strdup(id);
}
