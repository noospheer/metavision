        mvu_fname(MVU_NAME(MVU_CLASS(act[j].a)), kn, sizeof kn);
        ADD(act[j].a, act[j].pc, MVU_ACTOR, K_ACTOR, kn);
        if (nc && c[nc - 1].o == act[j].a) c[nc - 1].touch = act[j].touch;
    }
    #undef ADD
    if (guard_only) return;
    mvu_trig_seen = trig;
    {   // what the scan saw, whenever that changes
        static unsigned l[8] = { ~0u, ~0u, ~0u, ~0u, ~0u, ~0u, ~0u, ~0u };
        unsigned v[8] = { nw[0], nw[1], nw[2], nw[3], na, nact_click, nwc, nwi };
        if (memcmp(l, v, sizeof v)) {
            memcpy(l, v, sizeof v);
            fprintf(stderr, "[mv-autoplay-ui] scan at %.1fs: %u buttons, %u check boxes, %u sliders, %u combo boxes "
                            "(%u shown with a listener); %u interactive actors (%u clickable, %u overlap-only); "
                            "%u widget components, %u widget interaction components\n",
                    now - t0, nw[0], nw[1], nw[2], nw[3], found[MVU_UMG], na, nact_click, trig, nwc, nwi);
        }
    }
    double t = now - t0;
    int pick = -1;
    for (unsigned i = 0; i < nc; i++) if (pick < 0 || mvu_before(&c[i], &c[pick])) pick = (int)i;
    if (pick < 0) {
        fprintf(stderr, "[mv-autoplay-ui] t=%.1fs nothing to press (umg %u, actor %u found; %u skipped%s%s%s; %u trigger-only)\n",
                t, found[MVU_UMG], found[MVU_ACTOR], nskip, skip[0] ? " e.g. '" : "", skip, skip[0] ? "'" : "", trig);
        mvu_coverage(t);
        return;
    }
    mvu_cand *p = &c[pick];
    const char *how = "none"; int held = 0;
    char hb[64];
    switch (p->kind) {
    case K_BUTTON:
        ue.b_hover(p->o); ue.b_press(p->o);
        how = "SlateHandleHovered+Pressed"; held = 1;
        break;
    case K_CHECK: {
        uint32_t st = !(ue.c_is(p->o) & 1);
        ue.c_set(p->o, st); ue.c_changed(p->o, st);   // ECheckBoxState: Unchecked 0, Checked 1
        how = st ? "SetIsChecked(true)+SlateOnCheckStateChanged" : "SetIsChecked(false)+SlateOnCheckStateChanged";
        break;
    }
    case K_SLIDER: {
        float lo = *(const float *)((const uint8_t *)p->o + mvu_poff[P_SMIN]);
        float hi = *(const float *)((const uint8_t *)p->o + mvu_poff[P_SMAX]);
        if (!(hi > lo)) { lo = 0; hi = 1; }
        float v = ue.s_get(p->o), f = (v - lo) / (hi - lo);
        f = f < 0.5f ? f + 0.25f : f - 0.25f;
        v = lo + f * (hi - lo);
        ue.s_cap_begin(p->o); ue.s_set(p->o, v); ue.s_changed(p->o, v); ue.s_cap_end(p->o);
        snprintf(hb, sizeof hb, "SetValue(%.3g)+HandleOnValueChanged", (double)v); how = hb;
        break;
    }
    case K_COMBO: {
        int32_t n = ue.o_count(p->o), s = ue.o_sel(p->o);
        if (n > 1) {
            int32_t to = s < 0 ? 0 : (s + 1) % n;
            ue.o_set(p->o, to);
            snprintf(hb, sizeof hb, "SetSelectedIndex(%d of %d)", to, n); how = hb;
        } else how = "one option: nothing to choose";
