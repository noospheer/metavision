#define MV_SYM(x) "_" #x
#else
#define MV_SYM(x) #x
#endif
// TLSDESC ABI: x0 = &descriptor {resolver, arg}; return x0 = address - TP; every
// other register (general and SIMD) preserved.
__attribute__((naked)) static void mv_tlsdesc_resolve(void) {
    __asm__ volatile(
        "stp x29, x30, [sp, #-16]!\n"
        "mov x29, sp\n"
