# 11 — socket()/socketpair() with Linux's SOCK_NONBLOCK|SOCK_CLOEXEC in the type.
# Darwin has no such type bits and refuses the call, so a library that opens
# sockets the modern Linux way (Rust's std/tokio always does) gets an error it
# treats as fatal. Strip them and apply them with fcntl, as accept4/pipe2 do.
python3 - "$K/runtime/libc/kl_shim.c" <<'EOF'
import sys
path = sys.argv[1]
s = open(path).read()
if "metavision: Linux socket type flags" not in s:
    def rep(old, new):
        global s
        if s.count(old) != 1:
            sys.exit(f"overlay: anchor moved upstream in {path}: {old[:60]!r}")
        s = s.replace(old, new)
    rep("static int kl_socket(int domain, int type, int protocol) {\n",
        "// metavision: Linux socket type flags — SOCK_NONBLOCK (0x800) and\n"
        "// SOCK_CLOEXEC (0x80000) ride in `type` on Linux; Darwin refuses them there.\n"
        "static int mv_sock_flags(int *type) {\n"
        "    int f = *type & (0x800 | 0x80000);\n"
        "    *type &= ~(0x800 | 0x80000);\n"
        "    return f;\n"
        "}\n"
        "static int mv_apply_sock_flags(int fd, int f) {\n"
        "    if (fd < 0 || !f) return fd;\n"
        "    if (f & 0x80000) fcntl(fd, F_SETFD, FD_CLOEXEC);\n"
        "    if (f & 0x800)   fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);\n"
        "    return fd;\n"
        "}\n"
        "static int kl_socketpair(int domain, int type, int protocol, int sv[2]) {\n"
        "    int f = mv_sock_flags(&type);\n"
        "    if (domain == 10) domain = AF_INET6;\n"
        "    int r = socketpair(domain, type, protocol, sv);\n"
        "    if (r == 0) { mv_apply_sock_flags(sv[0], f); mv_apply_sock_flags(sv[1], f); }\n"
        "    return r;\n"
        "}\n\n"
        "static int kl_socket(int domain, int type, int protocol) {\n"
        "    int mv_flags = mv_sock_flags(&type);   // applied to the fd at the end\n")
    rep("        return fd;\n    }\n    int fd = socket(domain, type, protocol);\n",
        "        return mv_apply_sock_flags(fd, mv_flags);\n    }\n    int fd = socket(domain, type, protocol);\n"
        "    mv_apply_sock_flags(fd, mv_flags);\n")
    rep("    E(\"socket\", kl_socket),\n",
        "    E(\"socket\", kl_socket), E(\"socketpair\", kl_socketpair),   // metavision: socketpair flags\n")
