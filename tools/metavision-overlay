        int touch = mvu_bound(pc, P_PC_TOUCH) || mvu_bound(a, P_A_TOUCH) || (af & 4);
        int inter = own || (af & 7) || mvu_bound(a, P_A_CLICK) || mvu_bound(a, P_A_OVER) || mvu_bound(a, P_A_TOUCH);
        int overlap = (af & 8) || mvu_bound(a, P_A_OVERLAP) || mvu_bound(pc, P_PC_OVERLAP);
        if (!inter && !overlap) continue;
        unsigned j = 0;
        while (j < na && act[j].a != a) j++;
