    const char *how = "none"; int threw = 0, held = 0;
    Il2CppObject *exc = NULL;
    switch (p->fam) {
    case MVF_UI: {
        const MethodInfo *m = mv_kind(il.object_get_class(p->o)) ? mv_m(il.object_get_class(p->o), "OnSubmit", 1) : NULL;
        void *nul[1] = { 0 };
        if (m) { il.runtime_invoke(m, p->o, nul, &exc); how = "OnSubmit"; }
        if (!m || exc) {   // step 52's fallbacks, then the pointer path for a title's own control
            exc = NULL;
            how = !strcmp(p->kind, "Button") ? "Press" : !strcmp(p->kind, "Toggle") ? "InternalToggle" :
                  !strcmp(p->kind, "Dropdown") ? "Show" : NULL;
            if (how && (m = mv_m(il.object_get_class(p->o), how, 0))) il.runtime_invoke(m, p->o, NULL, &exc);
            else {
                Il2CppObject *pd = mv_ped(p->o);
                mv_iface(p->o, k_enter, mi_enter, pd, &threw);
                how = mv_iface(p->o, k_down, mi_down, pd, &threw) ? "Down" : "Enter";
                held = 1;
            }
        }
        threw += exc != NULL;
        break;
    }
    case MVF_ISDK:
        if (!strcmp(p->kind, "PointableUnityEventWrapper")) {
            threw += mv_uevent(p->o, "get_WhenHover", pet_hover) < 0;
            threw += mv_uevent(p->o, "get_WhenSelect", pet_select) < 0;
        } else {
            threw += mv_uevent(p->o, "get_WhenHover", -1) < 0;
            threw += mv_uevent(p->o, "get_WhenSelect", -1) < 0;
        }
        how = "When{Hover,Select}"; held = 1;
        break;
    case MVF_XRI: {
        Il2CppObject *mgr = mv_xri_mgr(p->o, ior);
        const MethodInfo *m = mgr ? mv_m(il.object_get_class(mgr), "SelectEnter", 2) : NULL;
        if (m) {
            void *a[2] = { ior, p->o };
            il.runtime_invoke(m, mgr, a, &exc);
            threw += exc != NULL; how = "SelectEnter"; held = 1;
        } else how = "no interaction manager";
        break;
    }
    case MVF_CLICK: {
        Il2CppObject *pd = mv_ped(p->o);
        mv_iface(p->o, k_enter, mi_enter, pd, &threw);
        how = mv_iface(p->o, k_down, mi_down, pd, &threw) ? "Enter+Down" : "Enter";
        held = 1;
        break;
    }
    case MVF_EVENT: {
        const mv_kinfo *ki = mv_class(il.object_get_class(p->o));
        static char evs[96]; size_t o = 0;
        for (int e = 0; e < ki->nev; e++) {
            Il2CppObject *ev = *(Il2CppObject **)((uint8_t *)p->o + ki->off[e]);
            if (!ev || !m_ue_inv) continue;
            exc = NULL;
            il.runtime_invoke(m_ue_inv, ev, NULL, &exc);
            threw += exc != NULL;
            o += (size_t)snprintf(evs + o, sizeof evs - o, "%s%s.Invoke", o ? "+" : "", ki->ev[e]);
            if (o >= sizeof evs) break;
        }
        how = o ? evs : "no event set";
        break;
    }
    }
    mvd[p->di].tries++; mvd[p->di].last = now;
    fprintf(stderr, "[mv-autoplay-ui] t=%.1fs pressed '%s' (%s %s go=%s via %s%s, try %u, %u candidates, %u skipped)\n",
            t, p->lab[0] ? p->lab : p->go, mvf_name[p->fam], p->kind, p->go, how, threw ? " THREW" : "",
            mvd[p->di].tries, nc, nskip);
    if (held) mv_hold(p->o, p->fam == MVF_XRI ? ior : NULL, p->fam, p->kind, p->lab[0] ? p->lab : p->go, now + hold);
    mv_coverage(t);
}

