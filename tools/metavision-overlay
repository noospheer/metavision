static klj_val avp_s_wait(void *env, void *self, const klj_val *a, int n) {
    (void)env; (void)self;
    avp *p = n > 0 ? avp_at((int)(int32_t)a[0].j) : NULL;
    if (!p) return (klj_val){0};
    pthread_mutex_lock(&p->lk);
    int before = p->frame_count;
    pthread_mutex_unlock(&p->lk);
    for (int i = 0; i < 50; i++) {     // the Java: RenderPlayer and 10 ms naps, 50 times at most
        avp_render(p);
        pthread_mutex_lock(&p->lk);
        int now = p->frame_count;
        pthread_mutex_unlock(&p->lk);
        if (now > before) break;
        usleep(10000);
    }
    pthread_mutex_lock(&p->lk);
    p->extracting = 0;
    pthread_mutex_unlock(&p->lk);
    return (klj_val){0};
}
