# 54 — a wake written to a full eventfd is not an error. eventfd is emulated
# with a self-connected AF_UNIX datagram socket (kl_libc_slink.c). A busy
# guest I/O reactor (Rust's mio/tokio) writes its 8-byte wake far more often
# than it reads, the socket queue fills, and Darwin refuses the next datagram
# with ENOBUFS, which the reactor treats as fatal ("failed to wake I/O driver")
# and panics. A real eventfd only adds to its counter. A failed 8-byte write to
# one of these sockets is answered as written: a wake already pending keeps the
# fd readable, which is all the write promises.
python3 - "$K/runtime/libc/kl_shim.c" <<'PYEOF'
import sys
p = sys.argv[1]
s = open(p).read()
marker = "metavision: a full eventfd still takes a wake (step 54)"
def sub(s, old, new):
    if s.count(old) != 1:
        sys.exit(f"overlay: anchor moved upstream in {p}: {old[:60]!r}")
    return s.replace(old, new)
if marker not in s:
    if "metavision: socketpair ahead of the generated forward" not in s:
        sys.exit("overlay: step 54 needs step 32")
    s = sub(s, "static const kl_entry g_shim[] = {\n",
        "// " + marker + "\n"
        "#include <sys/un.h>\n"
        "static int mv_is_efd(int fd) {   // the emulated eventfd's socket name\n"
        "    struct sockaddr_un a; socklen_t l = sizeof a;\n"
        "    memset(&a, 0, sizeof a);\n"
        "    if (getsockname(fd, (struct sockaddr *)&a, &l) != 0 || a.sun_family != AF_UNIX) return 0;\n"
        "    return strstr(a.sun_path, \"/kl-efd-\") != NULL;\n"
