//
// "audio/mp4a-latm": AudioConverter, AAC -> 16-bit interleaved PCM. Each queued
// access unit is decoded on the spot into one output slot; dequeueOutputBuffer
// hands slots out oldest first (after one OUTPUT_FORMAT_CHANGED), and their
// bytes are CPU-visible through getOutputBuffer. Input is refused (TRY_AGAIN)
// while fewer than two slots are free, which is the back-pressure a hardware
// decoder applies too.
#include <AudioToolbox/AudioToolbox.h>

#define MV_PCM_FRAMES 4096                 // per slot; an AAC packet is 1024 (2048 with SBR)
#define MV_PCM_CAP    (MV_PCM_FRAMES * 8 * 2)
#define MV_AAC_DRY    ((OSStatus)0x6d76646eu)   /* 'mvdn': this call's packet is used up */

static int mv_video_audio_on(void) {
    static int on = -1;
    if (on < 0) on = kl_env_on("MV_VIDEO_AUDIO", 1);
    return on;
}

typedef struct {
    AudioConverterRef conv;
    int      rate, ch;
    int      fmt_said;
    const uint8_t *pkt;
    uint32_t pkt_len;
    int      pkt_given;
    AudioStreamPacketDescription desc;
    struct { uint8_t *pcm; size_t len; int64_t pts; uint32_t flags; int state; unsigned seq; }
             o[KLM_OUT_SLOTS];         // state: 0 free, 1 decoded, 2 with the guest, 3 filling
    unsigned seq;
    unsigned n_err;
} mv_aac;

static void *mv_aac_codec_new(const char *mime) {
    klm_codec *c = calloc(1, sizeof *c);
    mv_aac *a = calloc(1, sizeof *a);
    if (!c || !a) { free(c); free(a); return NULL; }
    c->magic = KLM_CODEC_MAGIC;
    snprintf(c->mime, sizeof c->mime, "%s", mime);
    pthread_mutex_init(&c->lock, NULL);
    c->mv_aac = a;
    g_ever_created = 1;
    fprintf(stderr, "  [media] AMediaCodec_createDecoderByType(\"%s\") — AAC to 16-bit PCM\n", mime);
    return c;
}

static void mv_esds_descr(uint8_t *p, size_t *o, int tag, size_t size) {
    p[(*o)++] = (uint8_t)tag;
    for (int i = 3; i > 0; i--) p[(*o)++] = (uint8_t)((size >> (7 * i)) | 0x80);
    p[(*o)++] = (uint8_t)(size & 0x7f);
}

static int mv_aac_configure(klm_codec *c, const void *format) {
    mv_aac *a = c->mv_aac;
    klm_format *f = (klm_format *)format;
    int32_t rate = 0, ch = 0;
    klm_AMediaFormat_getInt32(f, g_key_sample_rate, &rate);
    klm_AMediaFormat_getInt32(f, g_key_channel_count, &ch);
    const uint8_t *asc = NULL;
    size_t asc_len = 0;
    uint8_t synth[2];
    if (!mv_fmt_blob(f, "csd-0", &asc, &asc_len) || !asc_len || asc_len > 64) {
        // No csd-0: AAC-LC at the format's own rate and channel count.
        static const int rates[13] = { 96000, 88200, 64000, 48000, 44100, 32000, 24000,
                                       22050, 16000, 12000, 11025, 8000, 7350 };
        int idx = 4;
        for (int i = 0; i < 13; i++) if (rates[i] == rate) idx = i;
        synth[0] = (uint8_t)((2 << 3) | (idx >> 1));
        synth[1] = (uint8_t)(((idx & 1) << 7) | ((ch & 0xf) << 3));
        asc = synth; asc_len = 2;
    }
    // The decoder's magic cookie is an esds ES_Descriptor wrapped round csd-0.
    uint8_t cookie[128];
    size_t o = 0;
    mv_esds_descr(cookie, &o, 0x03, 3 + 5 + 13 + 5 + asc_len);
    cookie[o++] = 0; cookie[o++] = 0; cookie[o++] = 0;        // ES_ID, flags
    mv_esds_descr(cookie, &o, 0x04, 13 + 5 + asc_len);
    cookie[o++] = 0x40;                                       // MPEG-4 audio
    cookie[o++] = 0x15;                                       // audio stream
    memset(cookie + o, 0, 11); o += 11;                       // buffer size, bitrates
    mv_esds_descr(cookie, &o, 0x05, asc_len);
    memcpy(cookie + o, asc, asc_len); o += asc_len;

    AudioStreamBasicDescription in = { 0 };
    in.mFormatID = kAudioFormatMPEG4AAC;
    UInt32 sz = sizeof in;
    if (AudioFormatGetProperty(kAudioFormatProperty_FormatInfo, (UInt32)o, cookie, &sz, &in) != noErr
        || in.mSampleRate <= 0 || !in.mChannelsPerFrame) {
        memset(&in, 0, sizeof in);
        in.mFormatID = kAudioFormatMPEG4AAC;
        in.mSampleRate = rate > 0 ? rate : 44100;
        in.mChannelsPerFrame = ch > 0 ? (UInt32)ch : 2;
        in.mFramesPerPacket = 1024;
    }
    if (in.mChannelsPerFrame > 8) return AMEDIA_ERROR_UNSUPPORTED;
    AudioStreamBasicDescription out = { 0 };
    out.mFormatID = kAudioFormatLinearPCM;
    out.mFormatFlags = kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked;
    out.mSampleRate = in.mSampleRate;
    out.mChannelsPerFrame = in.mChannelsPerFrame;
    out.mBitsPerChannel = 16;
    out.mBytesPerFrame = 2 * in.mChannelsPerFrame;
    out.mFramesPerPacket = 1;
    out.mBytesPerPacket = out.mBytesPerFrame;
    if (a->conv) { AudioConverterDispose(a->conv); a->conv = NULL; }
    OSStatus st = AudioConverterNew(&in, &out, &a->conv);
    if (st != noErr) {
        a->conv = NULL;
        fprintf(stderr, "  [media] AAC decoder: AudioConverterNew failed (%d)\n", (int)st);
        return AMEDIA_ERROR_UNSUPPORTED;
    }
    st = AudioConverterSetProperty(a->conv, kAudioConverterDecompressionMagicCookie, (UInt32)o, cookie);
    a->rate = (int)(in.mSampleRate + 0.5);
    a->ch = (int)in.mChannelsPerFrame;
    a->fmt_said = 0;
    fprintf(stderr, "  [media] AMediaCodec_configure: mime=%s -> AAC decoder %d Hz, %d ch "
                    "(csd-0 %zu bytes%s)\n", c->mime, a->rate, a->ch, asc_len,
            st == noErr ? "" : ", cookie refused");
    return AMEDIA_OK;
}

static OSStatus mv_aac_input(AudioConverterRef conv, UInt32 *n, AudioBufferList *bl,
                             AudioStreamPacketDescription **desc, void *ud) {
    (void)conv;
    mv_aac *a = ud;
    if (a->pkt_given || !a->pkt_len) { *n = 0; return MV_AAC_DRY; }
    bl->mNumberBuffers = 1;
    bl->mBuffers[0].mData = (void *)a->pkt;
    bl->mBuffers[0].mDataByteSize = a->pkt_len;
    bl->mBuffers[0].mNumberChannels = (UInt32)a->ch;
    a->desc.mStartOffset = 0;
    a->desc.mVariableFramesInPacket = 0;
    a->desc.mDataByteSize = a->pkt_len;
    if (desc) *desc = &a->desc;
    *n = 1;
    a->pkt_given = 1;
    return noErr;
}

// Lock held. Two free slots: one for the decode, one for a following EOS.
static int mv_aac_room_locked(klm_codec *c) {
    mv_aac *a = c->mv_aac;
    int free_slots = 0;
    for (int i = 0; i < KLM_OUT_SLOTS; i++) free_slots += a->o[i].state == 0;
    return free_slots >= 2;
}

static int mv_aac_take(klm_codec *c) {
    mv_aac *a = c->mv_aac;
    pthread_mutex_lock(&c->lock);
    for (int i = 0; i < KLM_OUT_SLOTS; i++)
        if (a->o[i].state == 0) {
            if (!a->o[i].pcm) a->o[i].pcm = malloc(MV_PCM_CAP);
            if (!a->o[i].pcm) break;
            a->o[i].state = 3;
            pthread_mutex_unlock(&c->lock);
            return i;
        }
    pthread_mutex_unlock(&c->lock);
    return -1;
}

static void mv_aac_post(klm_codec *c, int i, size_t len, int64_t pts, uint32_t flags) {
    mv_aac *a = c->mv_aac;
    pthread_mutex_lock(&c->lock);
    a->o[i].len = len;
    a->o[i].pts = pts;
    a->o[i].flags = flags;
    a->o[i].seq = a->seq++;
    a->o[i].state = 1;
    pthread_mutex_unlock(&c->lock);
}

static int mv_aac_queue(klm_codec *c, const uint8_t *p, size_t size, int64_t pts, uint32_t flags) {
    mv_aac *a = c->mv_aac;
    if (!a->conv) return AMEDIA_ERROR_INVALID_OBJECT;
    if (flags & AMEDIACODEC_BUFFER_FLAG_CODEC_CONFIG) return AMEDIA_OK;   // csd-0 came with configure
    if (size) {
        int i = mv_aac_take(c);
        if (i < 0) {
            KLM_FIRST(said_aac_full, "AAC decoder: every output slot is held — an access "
                                     "unit is dropped\n");
        } else {
            a->pkt = p; a->pkt_len = (uint32_t)size; a->pkt_given = 0;
            UInt32 frames = MV_PCM_FRAMES;
            AudioBufferList bl;
            bl.mNumberBuffers = 1;
            bl.mBuffers[0].mNumberChannels = (UInt32)a->ch;
            bl.mBuffers[0].mDataByteSize = frames * 2u * (UInt32)a->ch;
            bl.mBuffers[0].mData = a->o[i].pcm;
            OSStatus st = AudioConverterFillComplexBuffer(a->conv, mv_aac_input, a, &frames, &bl, NULL);
            if (st != noErr && st != MV_AAC_DRY) {
                if (a->n_err++ < 3)
                    fprintf(stderr, "  [media] AAC decoder: %zu-byte access unit at %lld us "
                                    "not decoded (%d)\n", size, (long long)pts, (int)st);
                frames = 0;
            }
            if (frames) {
                mv_aac_post(c, i, (size_t)frames * 2u * (size_t)a->ch, pts, 0);
            } else {
                pthread_mutex_lock(&c->lock);
                a->o[i].state = 0;
                pthread_mutex_unlock(&c->lock);
            }
        }
    }
    if (flags & AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM) {
        int i = mv_aac_take(c);
        if (i >= 0) mv_aac_post(c, i, 0, pts, AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM);
    }
    return AMEDIA_OK;
}

static ssize_t mv_aac_dequeue(klm_codec *c, AMediaCodecBufferInfo *info, int64_t timeoutUs) {
    mv_aac *a = c->mv_aac;
    int64_t waited = 0;
    for (;;) {
        pthread_mutex_lock(&c->lock);
        int best = -1;
        for (int i = 0; i < KLM_OUT_SLOTS; i++)
            if (a->o[i].state == 1 && (best < 0 || (int)(a->o[i].seq - a->o[best].seq) < 0))
                best = i;
        if (best >= 0 && !a->fmt_said) {
            a->fmt_said = 1;
            pthread_mutex_unlock(&c->lock);
            return AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED;
        }
        if (best >= 0) {
            a->o[best].state = 2;
            if (info) {
                info->offset = 0;
                info->size = (int32_t)a->o[best].len;
                info->presentationTimeUs = a->o[best].pts;
                info->flags = a->o[best].flags;
            }
            c->n_out++;
            int64_t pts = a->o[best].pts;
            size_t len = a->o[best].len;
            pthread_mutex_unlock(&c->lock);
            KLM_FIRST(said_pcm, "first PCM buffer dequeued (slot %d, %zu bytes, pts %lld us)\n",
                      best, len, (long long)pts);
            return best;
        }
        pthread_mutex_unlock(&c->lock);
        if (timeoutUs == 0 || (timeoutUs > 0 && waited >= timeoutUs))
            return AMEDIACODEC_INFO_TRY_AGAIN_LATER;
        usleep(1000);
        waited += 1000;
    }
}

static uint8_t *mv_aac_outbuf(klm_codec *c, size_t idx, size_t *out_size) {
    mv_aac *a = c->mv_aac;
    if (idx >= KLM_OUT_SLOTS) return NULL;
    pthread_mutex_lock(&c->lock);
    uint8_t *p = a->o[idx].state == 2 ? a->o[idx].pcm : NULL;
    pthread_mutex_unlock(&c->lock);
    if (out_size) *out_size = p ? MV_PCM_CAP : 0;
    return p;
}

static int mv_aac_release(klm_codec *c, size_t idx) {
    mv_aac *a = c->mv_aac;
    pthread_mutex_lock(&c->lock);
    int ok = a->o[idx].state == 2;
    if (ok) { a->o[idx].state = 0; a->o[idx].len = 0; }
    pthread_mutex_unlock(&c->lock);
    return ok ? AMEDIA_OK : AMEDIA_ERROR_INVALID_PARAMETER;
}

static void mv_aac_fill_format(klm_codec *c, klm_format *f) {
    mv_aac *a = c->mv_aac;
    klm_AMediaFormat_setString(f, g_key_mime, "audio/raw");
    if (a->rate > 0 && a->ch > 0) {
        klm_AMediaFormat_setInt32(f, g_key_sample_rate, a->rate);
        klm_AMediaFormat_setInt32(f, g_key_channel_count, a->ch);
        klm_AMediaFormat_setInt32(f, "pcm-encoding", 2);      // ENCODING_PCM_16BIT
    }
}

static void mv_aac_flush(klm_codec *c) {
    mv_aac *a = c->mv_aac;
    if (!a) return;
    pthread_mutex_lock(&c->lock);
    for (int i = 0; i < KLM_OUT_SLOTS; i++) { a->o[i].state = 0; a->o[i].len = 0; }
    pthread_mutex_unlock(&c->lock);
    if (a->conv) AudioConverterReset(a->conv);
}

static void mv_aac_destroy(klm_codec *c) {
    mv_aac *a = c->mv_aac;
    if (!a) return;
    if (a->conv) AudioConverterDispose(a->conv);
    for (int i = 0; i < KLM_OUT_SLOTS; i++) free(a->o[i].pcm);
    free(a);
    c->mv_aac = NULL;
}

