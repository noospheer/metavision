    if (!fs_of(self, FS_DB) || !id || !*id || strchr(id, '/')) RET(fs_bad_path("collection group", id));
    mvfs *q;
    void *obj = fs_new(C_QUERY, FS_QUERY, &q);
    q->db = self;
    q->q.coll = strdup(id);
