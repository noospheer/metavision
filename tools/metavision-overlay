        "static pthread_mutex_t mv_rt_lock = PTHREAD_MUTEX_INITIALIZER;\n"
        "static VkImage mv_rt[1024];\n"
        "static unsigned mv_rt_live, mv_rt_made, mv_rt_gone, mv_rt_said;\n"
        "static void mv_rt_add(VkImage img, const VkImageCreateInfo *ci) {\n"
