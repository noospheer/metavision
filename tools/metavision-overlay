# 38 — Application SpaceWarp eye layers get real motion-vector storage. A Unity
# title built with SpaceWarp on asks ovrp_GetLayerTextureSpaceWarp for each
# stage's motion-vector colour and depth textures, and its display provider
# treats a refusal as "eye textures could not be created": one frame, then no
# XR frame ever begins again (main loop alive, picture black). Three parts:
#   - the eye-layer desc reports a motion-vector size (it stayed zero, and the
#     provider sizes that storage from it alone);
#   - the entry point has the real seven-argument shape (layer, stage, eye, then
#     four NULL-checked out pointers: x3 = motion colour, x5 = motion depth);
#   - kl_vulkan allocates the two images (RGBA16F colour, D32S8 depth) per stage.
# Nothing consumes motion vectors here: the visionOS compositor reprojects on its
# own, so the guest renders into storage nobody reads. GL guests keep the refusal.
python3 - "$K/runtime" <<'PYEOF'
import sys
root = sys.argv[1]
def patch(path, old, new, marker):
    s = open(path).read()
    if marker in s:
        return
    if s.count(old) != 1:
        sys.exit(f"overlay: anchor moved upstream in {path}: {old[:70]!r}")
    open(path, "w").write(s.replace(old, new))

V = f"{root}/gfx/kl_vulkan.c"
patch(V,
      "unsigned long long kl_vulkan_eye_image_layers(int stage, int eye, unsigned w, unsigned h,\n",
      "// metavision: SpaceWarp storage (step 38). Images the guest renders into and\n"
      "// nothing reads: kind 0 = motion-vector colour, kind 1 = its depth. Cached per\n"
      "// (kind, stage, eye); a different shape allocates afresh and keeps the old one,\n"
      "// as kl_vulkan_layer_image does. Called from the guest's render thread at setup.\n"
      "struct mv_aux_img { VkImage img; unsigned w, h; int fmt, layers; };\n"
      "unsigned long long kl_vulkan_aux_image(int kind, int stage, int eye, unsigned w,\n"
      "                                       unsigned h, int vk_format, int layers) {\n"
      "    static struct mv_aux_img aux[2][KLVK_EYE_STAGES][2];\n"
      "    if (!kl_vulkan_guest_active() || !g_devs[0]) return 0;\n"
      "    if (kind < 0 || kind > 1 || stage < 0 || stage >= KLVK_EYE_STAGES ||\n"
      "        eye < 0 || eye > 1 || !w || !h) return 0;\n"
      "    if (layers < 1) layers = 1;\n"
      "    if (layers > 2) layers = 2;\n"
      "    if (layers > 1) eye = 0;            // Array layout: one image, a layer per eye\n"
      "    struct mv_aux_img *s = &aux[kind][stage][eye];\n"
      "    if (s->img && s->w == w && s->h == h && s->fmt == vk_format && s->layers == layers)\n"
      "        return (uint64_t)(uintptr_t)s->img;\n"
      "    VkImageUsageFlags u = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |\n"
      "                          VK_IMAGE_USAGE_TRANSFER_DST_BIT |\n"
      "                          (kind ? VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT\n"
      "                                : VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT);\n"
      "    VkDeviceMemory mem = VK_NULL_HANDLE;\n"
      "    VkImage img = klvk_image_alloc(g_devs[0], (VkFormat)vk_format, w, h,\n"
      "                                   (uint32_t)layers, 1, u, &mem);\n"
      "    if (img == VK_NULL_HANDLE) return 0;\n"
      "    *s = (struct mv_aux_img){ img, w, h, vk_format, layers };\n"
      "    VKI(\"spacewarp %s stage %d = VkImage %p (%ux%u, format %d, %d layer(s))\\n\",\n"
      "        kind ? \"depth\" : \"motion\", stage, (void *)img, w, h, vk_format, layers);\n"
      "    return (uint64_t)(uintptr_t)img;\n"
      "}\n\n"
      "unsigned long long kl_vulkan_eye_image_layers(int stage, int eye, unsigned w, unsigned h,\n",
      "metavision: SpaceWarp storage (step 38)")

O = f"{root}/xr/kl_ovrp.c"
patch(O,
      "    d->mv_depth_format = mv_depth_format;\n}\n",
      "    d->mv_depth_format = mv_depth_format;\n"
      "    // metavision: SpaceWarp motion-vector size (step 38). A layer flagged\n"
      "    // SpaceWarpDataAllocation (0x100) sizes its motion-vector storage from this\n"
      "    // field alone; zero made a 0x0 texture. A quarter of the eye in each axis:\n"
      "    // nothing reads the vectors, so the smallest honest size is the cheapest.\n"
      "    if (layer_flags & 0x100)\n"
      "        d->mv_texture_size = (ovrp_sizei){ (w + 3) / 4, (h + 3) / 4 };\n"
      "}\n",
      "metavision: SpaceWarp motion-vector size (step 38)")

old_fn = (
    "static uint64_t klovrp_GetLayerTextureSpaceWarp(int layer_id, int stage, int eye,\n"
    "                                                uint64_t *motion, uint64_t *depth) {\n"
    "    ovrp_hit(\"ovrp_GetLayerTextureSpaceWarp\");\n"
    "    (void)layer_id; (void)stage; (void)eye;\n"
    "    if (!motion || !depth) return OVRP_FAIL_INVALID_PARAM;\n"
    "    *motion = 0;\n"
    "    *depth = 0;\n"
    "    return OVRP_FAIL_UNSUPPORTED;\n"
    "}\n")
new_fn = (
    "// metavision: SpaceWarp textures served (step 38). The real entry point takes\n"
    "// seven arguments and NULL-checks all four out pointers; the Unity provider\n"
    "// reads x3 (motion colour) and x5 (motion depth, on Vulkan) as 64-bit handles\n"
    "// and leaves x4/x6 alone, so those are not written (their width is unmeasured).\n"
    "// Refusing here stops a SpaceWarp title's frame loop after one frame.\n"
    "unsigned long long kl_vulkan_aux_image(int kind, int stage, int eye, unsigned w,\n"
    "                                       unsigned h, int vk_format, int layers);\n"
    "static uint64_t klovrp_GetLayerTextureSpaceWarp(int layer_id, int stage, int eye,\n"
    "                                                uint64_t *motion, void *motion_aux,\n"
    "                                                uint64_t *depth, void *depth_aux) {\n"
    "    ovrp_hit(\"ovrp_GetLayerTextureSpaceWarp\");\n"
    "    if (!motion || !motion_aux || !depth || !depth_aux) return OVRP_FAIL_INVALID_PARAM;\n"
    "    *motion = 0;\n"
    "    *depth = 0;\n"
    "    if ((unsigned)stage >= KLOVRP_MAX_STAGES || (unsigned)eye > 1)\n"
    "        return OVRP_FAIL_INVALID_PARAM;\n"
    "    struct klovrp_layer *l = klovrp_layer(layer_id);\n"
    "    if (!l || !l->is_eye || !kl_vulkan_guest_active()) return OVRP_FAIL_UNSUPPORTED;\n"
    "    int w = l->desc.mv_texture_size.w, h = l->desc.mv_texture_size.h;\n"
    "    if (w < 1 || h < 1) return OVRP_FAIL_UNSUPPORTED;\n"
    "    int layers = l->desc.layout == KLOVRP_LAYOUT_ARRAY ? 2 : 1;\n"
    "    unsigned long long m = kl_vulkan_aux_image(0, stage, eye, (unsigned)w, (unsigned)h,\n"
    "                                               97 /* R16G16B16A16_SFLOAT */, layers);\n"
    "    unsigned long long dp = kl_vulkan_aux_image(1, stage, eye, (unsigned)w, (unsigned)h,\n"
    "                                                130 /* D32_SFLOAT_S8_UINT */, layers);\n"
    "    if (!m || !dp) return OVRP_FAIL_UNSUPPORTED;\n"
    "    *motion = m;\n"
    "    *depth = dp;\n"
    "    static int said;\n"
    "    if (!said++)\n"
    "        fprintf(stderr, \"  [ovrp] GetLayerTextureSpaceWarp: layer %d stage %d -> motion %#llx, \"\n"
    "                        \"depth %#llx (%dx%d, %d layer(s)); nothing consumes them\\n\",\n"
    "                layer_id, stage, m, dp, w, h, layers);\n"
    "    return OVRP_SUCCESS;\n"
    "}\n")
patch(O, old_fn, new_fn, "metavision: SpaceWarp textures served (step 38)")
print("overlay: Application SpaceWarp layers get motion-vector storage")
PYEOF

# 39 — diagnostic: live large render targets on the Vulkan path. A title was
# killed for memory a few seconds in while creating a full-size two-layer depth
# target every frame; whether they are never destroyed or destroyed but still
# backed is the question. Every large attachment image (1024x1024 or more) is
# tracked from create to destroy, and the live count is logged as it grows.
# The first eight large depth targets also log the library that made them.
python3 - "$K/runtime" <<'PYEOF'
import sys
p = f"{sys.argv[1]}/gfx/kl_vulkan.c"
s = open(p).read()
marker = "metavision: large render-target census"
def sub(s, old, new):
    if s.count(old) != 1:
        sys.exit(f"overlay: anchor moved upstream in {p}: {old[:60]!r}")
    return s.replace(old, new)
if marker not in s:
    s = sub(s, "static VkResult VKAPI_CALL klvk_CreateImage(VkDevice dev, const VkImageCreateInfo *ci,\n",
        "// metavision: large render-target census (step 39) — diagnostic.\n"
        "const char *kl_addr_image(const void *addr, size_t *offset);   // kl_dl.c\n"
        "static pthread_mutex_t mv_rt_lock = PTHREAD_MUTEX_INITIALIZER;\n"
        "static VkImage mv_rt[1024];\n"
        "static unsigned mv_rt_live, mv_rt_made, mv_rt_gone, mv_rt_said;\n"
        "static void mv_rt_add(VkImage img, const VkImageCreateInfo *ci, const void *caller) {\n"
        "    if (!img || !ci || !(ci->usage & 0x30u)) return;   // colour or depth attachment\n"
        "    if ((uint64_t)ci->extent.width * ci->extent.height < 1024u * 1024u) return;\n"
        "    pthread_mutex_lock(&mv_rt_lock);\n"
        "    for (unsigned i = 0; i < 1024; i++) if (!mv_rt[i]) { mv_rt[i] = img; break; }\n"
        "    mv_rt_live++; mv_rt_made++;\n"
        "    if (mv_rt_live > mv_rt_said + 7 || mv_rt_made <= 4) {\n"
        "        mv_rt_said = mv_rt_live;\n"
        "        fprintf(stderr, \"  [vk-rt] large render targets live %u (made %u, destroyed %u); last %ux%u fmt %d layers %u usage %#x\\n\",\n"
        "                mv_rt_live, mv_rt_made, mv_rt_gone, ci->extent.width, ci->extent.height,\n"
        "                (int)ci->format, ci->arrayLayers, ci->usage);\n"
        "    }\n"
        "    pthread_mutex_unlock(&mv_rt_lock);\n"
        "    static int mv_rt_who;   // who makes the large depth targets (the first eight)\n"
        "    if (ci->format >= 124 && ci->format <= 130 && mv_rt_who < 8) {\n"
        "        mv_rt_who++;\n"
        "        size_t off = 0; const char *who = kl_addr_image(caller, &off);\n"
        "        fprintf(stderr, \"  [vk-rt] depth %ux%u x%u made by %s+%#zx\\n\",\n"
        "                ci->extent.width, ci->extent.height, ci->arrayLayers, who ? who : \"?\", off);\n"
        "    }\n"
        "}\n"
        "static void mv_rt_del(VkImage img) {\n"
        "    if (!img) return;\n"
        "    pthread_mutex_lock(&mv_rt_lock);\n"
        "    for (unsigned i = 0; i < 1024; i++) if (mv_rt[i] == img) { mv_rt[i] = 0; mv_rt_live--; mv_rt_gone++; break; }\n"
        "    pthread_mutex_unlock(&mv_rt_lock);\n"
        "}\n\n"
        "static VkResult VKAPI_CALL klvk_CreateImage(VkDevice dev, const VkImageCreateInfo *ci,\n")
    s = sub(s, "    if (r == VK_SUCCESS && out) klvk_img_reg_add(*out);\n",
               "    if (r == VK_SUCCESS && out) klvk_img_reg_add(*out);\n"
               "    if (r == VK_SUCCESS && out) mv_rt_add(*out, ci, __builtin_return_address(0));   // metavision (step 39)\n")
    s = sub(s, "    klvk_img_reg_del(img);\n",
               "    klvk_img_reg_del(img);\n    mv_rt_del(img);   // metavision (step 39)\n")
    open(p, "w").write(s)
print("overlay: Vulkan large render-target census (diagnostic)")
