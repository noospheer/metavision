static void mvu_u16(const uint16_t *c, int32_t n, char *o, size_t cap) {   // UTF-16 to UTF-8
    size_t j = 0;
    for (int32_t i = 0; c && i < n && c[i] && j + 4 < cap; i++) {
        unsigned u = c[i];
        if (u < 0x20) u = ' ';
        if (u < 0x80) o[j++] = (char)u;
        else if (u < 0x800) { o[j++] = (char)(0xC0 | u >> 6); o[j++] = (char)(0x80 | (u & 63)); }
        else { o[j++] = (char)(0xE0 | u >> 12); o[j++] = (char)(0x80 | ((u >> 6) & 63)); o[j++] = (char)(0x80 | (u & 63)); }
    }
    o[j] = 0;
}
static void mvu_fname(const void *fn, char *o, size_t cap) {   // an FName, as text
    uint16_t b[1100];   // FName::ToString(TCHAR*, uint32) writes the whole name (at most 1023) and its number
    uint32_t n = ue.name_str(fn, b, 1100);
    mvu_u16(b, n < 1100 ? (int32_t)n : 1099, o, cap);
}
static int mvu_isa(const void *o, int c) { return o && ue.cls[c] && (ue.child_of(MVU_CLASS(o), ue.cls[c]) & 1); }
static unsigned mvu_all(int c, void **out, unsigned cap) {   // every live object of a class and its subclasses
    mvu_tarray a = { 0, 0, 0 };
    ue.objs_of(ue.cls[c], &a, 1, MVU_RF_SKIP, MVU_IF_SKIP);
    unsigned n = a.num > 0 ? (unsigned)a.num : 0;
    if (n > cap) n = cap;
    if (a.data) { memcpy(out, a.data, n * sizeof *out); ue.mfree(a.data); }
    return n;
}
static int mvu_bound(const void *o, int p) {   // a multicast delegate with a listener
    const uint8_t *d = (const uint8_t *)o + mvu_poff[p];
    return mvu_pgen[p] == 0x1c ? d[0] != 0                      // sparse: bIsBound
                               : *(const int32_t *)(d + 8) > 0; // inline: InvocationList.Num
}
// The functions an inline delegate calls (FScriptDelegate: FWeakObjectPtr, FName),
// e.g. "BndEvt__QuitButton_K2Node_ComponentBoundEvent_0_OnButtonClickedEvent__DelegateSignature".
static int mvu_bound_unsafe(const void *o, int p, char *ev, size_t cap) {
    if (mvu_pgen[p] != 0x1b) return 0;
    const uint8_t *d = (const uint8_t *)o + mvu_poff[p];
    const uint8_t *l = *(const uint8_t *const *)d;
    int32_t n = *(const int32_t *)(d + 8);
    for (int32_t i = 0; l && i < n && i < 16; i++) {
        char nm[128];
        mvu_fname(l + 16 * i + 8, nm, sizeof nm);
        if (mv_unsafe(nm)) { snprintf(ev, cap, "%s", nm); return 1; }
    }
    return 0;
}
static int mvu_text(void *w, char *o, size_t cap, int depth) {   // the first text block's text at or under w
    if (!w || depth > 3) return 0;
    if (mvu_isa(w, C_TEXT)) {
        const mvu_tarray *s = ue.text_str((const uint8_t *)w + mvu_poff[P_TEXT]);
        if (s && s->data && s->num > 1) { mvu_u16((const uint16_t *)s->data, s->num - 1, o, cap); return o[0] != 0; }
        return 0;
    }
    if (mvu_isa(w, C_CONTENT)) return mvu_text(ue.content(w), o, cap, depth + 1);
    if (mvu_isa(w, C_PANEL)) {
        int32_t n = ue.nkids(w);
        for (int32_t i = 0; i < n && i < 8; i++) if (mvu_text(ue.kid(w, i), o, cap, depth + 1)) return 1;
    }
    return 0;
}
// Shown: constructed, Visible, enabled, every ancestor enabled and not hiding or
// hit-test-blocking it, up to a user widget in the viewport or in a visible
// widget component.
static int mvu_shown(void *w, void *const *roots, unsigned nr) {
    if (!(ue.constructed(w) & 1) || (ue.vis(w) & 0xff) != 0) return 0;
    void *x = w;
    for (int d = 0; x && d < 48; d++) {
        if (!(ue.enabled(x) & 1)) return 0;
        unsigned v = ue.vis(x) & 0xff;
        if (x != w && v != 0 && v != 4) return 0;   // Visible, SelfHitTestInvisible
        void *p = ue.parent(x);
        if (!p) {
            if (mvu_isa(x, C_USERW)) {
                if (ue.in_viewport(x) & 1) return 1;
                for (unsigned i = 0; i < nr; i++) if (roots[i] == x) return 1;
            }
            p = ue.typed_outer(x, ue.cls[C_USERW]);   // a tree's root: on to the user widget that owns it
        }
        x = p;
    }
    return 0;
}
static int mvu_confirm(const char *s) {   // a label that agrees to whatever the dialog asks
    static const char *const ok[] = { "yes", "ok", "confirm", "accept", "sure", 0 };
    char l[64]; size_t i = 0;
    for (; s[i] && i < 63; i++) l[i] = (char)tolower((unsigned char)s[i]);
    l[i] = 0;
    for (int k = 0; ok[k]; k++) if (!strcmp(l, ok[k])) return 1;
    return 0;
}
static uint8_t mvu_lang(const char *lab, const char *nm) {   // as step 107: 0 the host's language, 1 none, 2 English, 3 another
    static char host[16];
    if (!host[0]) { char country[16]; kl_jni_locale_parts(host, sizeof host, country, sizeof country); if (!host[0]) host[0] = '?'; }
    int g = mv_lang_of(lab);
    if (g < 0) g = mv_lang_of(nm);
    if (g < 0) return 1;
    return !strcmp(mv_langs[g].code, host) ? 0 : !strcmp(mv_langs[g].code, "en") ? 2 : 3;
}

// ---- everything ever found: coverage, as the Unity presser counts it ----
#define MVU_DISC 4096
typedef struct { const void *o; int32_t idx; uint8_t fam, unsafe_, tries; double last; } mvu_disc;
static mvu_disc mvud[MVU_DISC];
static unsigned mvud_n, mvu_trig_seen;
static int mvud_get(const void *o, int fam) {
    int32_t idx = MVU_INDEX(o);
    for (unsigned i = 0; i < mvud_n; i++) if (mvud[i].o == o && mvud[i].idx == idx && mvud[i].fam == fam) return (int)i;
    if (mvud_n == MVU_DISC) return -1;
    memset(&mvud[mvud_n], 0, sizeof mvud[0]);
    mvud[mvud_n].o = o; mvud[mvud_n].idx = idx; mvud[mvud_n].fam = (uint8_t)fam;
    return (int)mvud_n++;
}
static void mvu_coverage(double t) {
    unsigned tot[MVU_NF] = { 0 }, hit[MVU_NF] = { 0 }, uns = 0, T = 0, H = 0;
    for (unsigned i = 0; i < mvud_n; i++) {
        if (mvud[i].unsafe_) { uns++; continue; }
        tot[mvud[i].fam]++; T++;
        if (mvud[i].tries) { hit[mvud[i].fam]++; H++; }
    }
    static unsigned lt = ~0u, lh = ~0u, lu = ~0u, ltr = ~0u;
    if (T == lt && H == lh && uns == lu && mvu_trig_seen == ltr) return;
    lt = T; lh = H; lu = uns; ltr = mvu_trig_seen;
    char d[200]; size_t o = 0;
    for (int f = 0; f < MVU_NF; f++)
        if (tot[f]) o += (size_t)snprintf(d + o, sizeof d - o, "%s%s %u/%u", o ? ", " : "", mvu_fam[f], hit[f], tot[f]);
    fprintf(stderr, "[mv-autoplay-ui] coverage %u/%u (%s%s%u unsafe skipped, %u trigger-only) at %.1fs\n",
            H, T, d, o ? "; " : "", uns, mvu_trig_seen, t);
}

