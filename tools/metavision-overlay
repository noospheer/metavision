#define MV_FBAPP_CLASS "com/google/firebase/FirebaseApp"
#define MV_FBAPP_MAX 8
typedef struct { char *name; void *options; int collect; } mv_fbapp;
static void *mv_fbapps[MV_FBAPP_MAX];
static pthread_mutex_t mv_fbapps_lock = PTHREAD_MUTEX_INITIALIZER;
static mv_fbapp *mv_fbapp_of(void *self) {
    klj_object *o = klj_as_object(self);
    return o && strcmp(o->cls, MV_FBAPP_CLASS) == 0 ? o->data : NULL;
