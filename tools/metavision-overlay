static void *fs_reg_new(void *listener, void *subject, int query) {
    mvfs *r;
    void *reg = fs_new(C_REG, FS_REG, &r);
    fs_hold_in(r, listener); r->o1 = listener;
    fs_hold_in(r, subject); r->o2 = subject;
    r->i = query;
    pthread_mutex_lock(&fs_lock);
    fs_regs = realloc(fs_regs, (size_t)(fs_nregs + 1) * sizeof *fs_regs);
    fs_regs[fs_nregs++] = reg;
    pthread_mutex_unlock(&fs_lock);
    klj_hold(reg);   // the active list's
    return reg;
}
typedef void (*fs_on_void_fn)(void *env, void *clazz, int64_t listener);
static void fs_sync_deliver(void *reg) {
    mvfs *r = fs_of(reg, FS_REG);
    mvfs *l = r ? fs_of(r->o1, FS_LISTENER) : NULL;
    if (r && l && !r->k && l->b) {
        const char *cls = fs_cls(r->o1);
        fs_on_void_fn fn = (fs_on_void_fn)kl_jni_native(cls, "nativeOnEvent", "(J)V");
        if (fn) fn(kl_jni_env(), kl_jni_class(cls), l->b);
    }
    klj_release(reg);
}
B(fs_FF_addSnapshotsInSyncListener) {
    (void)env; (void)n;
    mvfs *r;
    void *reg = fs_new(C_REG, FS_REG, &r);   // not in the active list: nothing re-fires it
    fs_hold_in(r, ARG(1)); r->o1 = ARG(1);
    r->i = 2;
    (void)self;
    klj_hold(reg);
    kl_mv_ui_later(fs_sync_deliver, reg);   // every (one-shot) listener is in sync at once
    RET(reg);
}

