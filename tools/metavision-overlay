#!/usr/bin/env bash
# metavision-overlay — apply metavision's build-time changes to a Klepton tree.
#
# Run on a THROWAWAY checkout (the CI runner's, or a copy): it edits files in
# vendor/klepton so that its own build picks up what metavision adds. The
# submodule in the repo is never committed with these changes.
#
#   1. targets.py   <- build/klepton-targets.py (upstream table + generated rows),
#                   and runtime/kl_target_table.h regenerated from it
#   2. Makefile     RUNTIME_SHIP gains shims/mv_shims.c, so the shim layer is
#                   compiled into libklepton.a with the runtime's own flags
#   3. gen_xcodeproj.py  the app links with -u _mv_shims_install: the shims are
#                   reached only through a constructor, and a static archive's
#                   member that nothing references is otherwise not linked
#   4. kl_app.c     multi-guest bundles: titles load from Frameworks/<target>/
#   5. launcher     generated library screen (root only with MV_LAUNCHER=1);
#                   guest framework IDs carry the target
#   6. hands-free   eyes-and-voice pointer for titles (klepton-overlay/)
#   7. guests       staged guest trees symlinked in (metavision-targets link)
#
# Idempotent; each step checks its anchor and fails loudly if upstream moved it.
#
# usage: tools/metavision-overlay [KLEPTON_DIR]     (default: vendor/klepton)
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
K=$(cd "${1:-$ROOT/vendor/klepton}" && pwd)
SHIMS_REL=$(python3 -c "import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))" "$ROOT/shims" "$K")

die() { echo "overlay: $*" >&2; exit 1; }

# 1 — target table
[ -f "$ROOT/build/klepton-targets.py" ] || die "build/klepton-targets.py missing: run tools/metavision-targets emit"
cp "$ROOT/build/klepton-targets.py" "$K/visionos/targets.py"
echo "overlay: targets.py <- generated table ($(python3 "$K/visionos/targets.py" --list | grep -c '^mv_') mv_ targets)"
# ...and the runtime's own copy of it. kl_target_table.h is committed upstream,
# so without this the app knows no mv_ target and stops at "missing guest target".
(cd "$K" && python3 visionos/targets.py --c-table > runtime/kl_target_table.h)
echo "overlay: runtime/kl_target_table.h regenerated ($(grep -c 'KL_TARGET_ROW("mv_' "$K/runtime/kl_target_table.h") mv_ rows)"

# 2 — shims into the shipping runtime
if ! grep -q 'mv_shims.c' "$K/Makefile"; then
    grep -q '^RUNTIME_SHIP := ' "$K/Makefile" || die "RUNTIME_SHIP not found in Makefile"
    # After the (possibly multi-line) RUNTIME_SHIP definition: the first line
    # that does not end in a backslash closes it.
    awk -v add="RUNTIME_SHIP += $SHIMS_REL/mv_shims.c $SHIMS_REL/mv_hands.c" '
        { print }
        /^RUNTIME_SHIP := / { inside = 1 }
        inside && !/\\$/ { print add; inside = 0 }
    ' "$K/Makefile" > "$K/Makefile.mv" && mv "$K/Makefile.mv" "$K/Makefile"
    grep -q '^RUNTIME_INC' "$K/Makefile" || die "RUNTIME_INC not found in Makefile"
    sed -i.bak "s|^RUNTIME_INC \(:\?=\) |RUNTIME_INC \1 -I$SHIMS_REL |" "$K/Makefile" && rm -f "$K/Makefile.bak"
fi
echo "overlay: Makefile RUNTIME_SHIP += $SHIMS_REL/mv_shims.c mv_hands.c"

# 3 — keep the constructor-only shim object in the link
G="$K/visionos/gen_xcodeproj.py"
if ! grep -q '_mv_shims_install' "$G"; then
    grep -q 'OTHER_LDFLAGS = "-lz ' "$G" || die "OTHER_LDFLAGS anchor not found in gen_xcodeproj.py"
    sed -i.bak 's|OTHER_LDFLAGS = "-lz |OTHER_LDFLAGS = "-Wl,-u,_mv_shims_install -lz |' "$G" && rm -f "$G.bak"
fi
echo "overlay: app links with -u _mv_shims_install"

# 4 — multi-guest bundles (the metavision launcher)
#
# A launcher embeds many titles, and two Unity titles both ship libunity, so
# each title's translations live in Frameworks/<target>/ instead of flat in
# Frameworks/. When that folder exists, kl_app.c loads the title from it,
# keeps ANGLE and MoltenVK on the shared Frameworks/, and gives the title its
# own Android files directory (otherwise every title would share one, and
# with it each other's saves). A single-title app has no such folder and is
# unchanged.
A="$K/visionos/Sources/kl_app.c"
if ! grep -q 'metavision: multi-guest' "$A"; then
    python3 - "$A" <<'EOF'
import sys
p = sys.argv[1]; s = open(p).read()
def rep(old, new):
    global s
    if s.count(old) != 1:
        sys.exit(f"overlay: kl_app.c anchor moved upstream: {old[:60]!r}")
    s = s.replace(old, new)
rep('static char g_dylibs[1024];',
    'static char g_dylibs[1024];\nstatic char g_shared_fw[1024];   // metavision: multi-guest — ANGLE/MoltenVK stay here')
rep('    snprintf(g_dylibs, sizeof g_dylibs, "%s/Frameworks", resources);\n',
    '    snprintf(g_dylibs, sizeof g_dylibs, "%s/Frameworks", resources);\n'
    '    snprintf(g_shared_fw, sizeof g_shared_fw, "%s", g_dylibs);\n'
    '    {   // metavision: multi-guest — a launcher keeps each title in Frameworks/<target>/\n'
    '        char per[1100];\n'
    '        snprintf(per, sizeof per, "%s/%s", g_shared_fw, g_target->name);\n'
    '        if (have(per)) snprintf(g_dylibs, sizeof g_dylibs, "%s", per);\n'
    '    }\n')
rep('    snprintf(g_files,  sizeof g_files,  "%s/android-files", container);\n',
    '    if (strcmp(g_dylibs, g_shared_fw) != 0)   // metavision: multi-guest — per-title files\n'
    '    {   snprintf(g_files, sizeof g_files, "%s/%s", container, g_target->tree);\n'
    '        mkdir(g_files, 0755);   /* the title folder may not exist before its assets do */\n'
    '        snprintf(g_files, sizeof g_files, "%s/%s/android-files", container, g_target->tree); }\n'
    '    else\n'
    '        snprintf(g_files, sizeof g_files, "%s/android-files", container);\n')
rep('    setenv("KL_ANGLE_DIR", g_dylibs, 0);', '    setenv("KL_ANGLE_DIR", g_shared_fw, 0);')
rep('    setenv("KL_MVK_DIR", g_dylibs, 0);', '    setenv("KL_MVK_DIR", g_shared_fw, 0);')
# A hand-launched app has no environment, and Klepton's diagnostics are all
# environment switches. Documents/klepton.env (KEY=VALUE lines, # comments)
# is read before anything else in configure; metavision-device env writes it.
rep('int kl_app_configure(const char *resources, const char *container) {\n'
    '    if (!resources || !container) return missing("path", "(null)");\n',
    'int kl_app_configure(const char *resources, const char *container) {\n'
    '    if (!resources || !container) return missing("path", "(null)");\n'
    '    {   // metavision: Documents/klepton.env\n'
    '        char ep[1200], line[1024];\n'
    '        snprintf(ep, sizeof ep, "%s/klepton.env", container);\n'
    '        FILE *ef = fopen(ep, "r");\n'
    '        while (ef && fgets(line, sizeof line, ef)) {\n'
    '            char *nl = strchr(line, \'\\n\'); if (nl) *nl = 0;\n'
    '            char *eq = strchr(line, \'=\');\n'
    '            if (line[0] == \'#\' || !eq) continue;\n'
    '            *eq = 0; setenv(line, eq + 1, 1);\n'
    '        }\n'
    '        if (ef) fclose(ef);\n'
    '    }\n')
open(p, "w").write(s)
EOF
fi
echo "overlay: kl_app.c loads a launcher's titles from Frameworks/<target>/"

# 5 — the launcher's library screen
#
# MetavisionLibrary.swift is generated from the target table: one tile per
# title this bundle actually embeds (Frameworks/<target>/ present). Picking a
# tile sets KL_TARGET and shows Klepton's BootView, which boots that title.
# The file is compiled into every app; only MV_LAUNCHER=1 makes it the root
# window, so single-title apps keep Klepton's own root.
#
# Guest framework bundle IDs also gain the target name: they were
# dev.klepton.guest.<lib>, identical for every Unity title, and one bundle may
# not embed two frameworks with the same identifier.
S="$K/visionos/Sources/MetavisionLibrary.swift"
if [ -f "$ROOT/build/guests/targets.json" ]; then
    python3 - "$ROOT/build/guests/targets.json" "$S" <<'EOF'
import json, sys
rows = json.load(open(sys.argv[1]))
engine = {"unity": "Unity", "ue4": "Unreal Engine 4"}
def lit(s):   # a Swift string literal; JSON's escapes are Swift's apart from \u, avoided here
    return json.dumps(s, ensure_ascii=False)
import os
def wants_mic(k, v):   # the title's manifest asks for RECORD_AUDIO
    m = os.path.join(os.path.dirname(sys.argv[1]), v.get("tree", k), "AndroidManifest.xml")
    return os.path.isfile(m) and "android.permission.RECORD_AUDIO" in open(m, errors="replace").read()
entries = ",\n".join(f'        MetavisionTitle(id: {lit(k)}, name: {lit(v.get("display") or k)}, engine: {lit(engine.get(v["kind"], v["kind"]))}, mic: {"true" if wants_mic(k, v) else "false"})'
                     for k, v in sorted(rows.items(), key=lambda kv: (kv[1].get("display") or kv[0]).lower()))
open(sys.argv[2], "w").write(f'''// GENERATED by tools/metavision-overlay from the target table. Do not edit.
//
// The metavision launcher's root: a library of the titles this bundle embeds.
// A process boots one title (its libraries stay mapped), so choosing another
// means closing the app and opening it again.
import SwiftUI
import UIKit
import Foundation

struct MetavisionTitle: Identifiable, Hashable {{
    let id: String
    let name: String
    let engine: String
    let mic: Bool          // its manifest asks for RECORD_AUDIO
}}

enum MetavisionCatalog {{
    static let all: [MetavisionTitle] = [
{entries}
    ]

    /// The guest microphone, set for the title about to boot: on when its
    /// manifest asks for RECORD_AUDIO (as a Quest grants it), off otherwise —
    /// set on every pick, so one title's choice never carries into the next.
    static func armMic(for id: String) {{
        KleptonMic.shared.settings.enabled = all.first(where: {{ $0.id == id }})?.mic ?? false
    }}

    /// Documents/<target>/icon.png in this app's container.
    static func iconPath(_ id: String) -> String {{
        FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
            .appendingPathComponent(id).appendingPathComponent("icon.png").path
    }}

    /// The runtime writes one Documents/klepton-boot.log (and klepton-crash.log
    /// on a fault) and truncates it at every boot. Before a title boots, file
    /// the previous run's logs under Documents/logs/<the title that wrote them>/,
    /// so a pass through several titles leaves one log set per title.
    static func fileLastRunLogs(next id: String) {{
        let fm = FileManager.default
        let docs = fm.urls(for: .documentDirectory, in: .userDomainMask)[0]
        let logs = docs.appendingPathComponent("logs")
        let marker = logs.appendingPathComponent("current-title.txt")
        if let prev = try? String(contentsOf: marker, encoding: .utf8)
                .trimmingCharacters(in: .whitespacesAndNewlines), !prev.isEmpty {{
            let dir = logs.appendingPathComponent(prev)
            try? fm.createDirectory(at: dir, withIntermediateDirectories: true)
            for name in ["klepton-boot.log", "klepton-crash.log"] {{
                let dst = dir.appendingPathComponent(name)
                try? fm.removeItem(at: dst)     // a stale crash must not outlive a clean run
                try? fm.moveItem(at: docs.appendingPathComponent(name), to: dst)
            }}
        }}
        try? fm.createDirectory(at: logs, withIntermediateDirectories: true)
        try? id.write(to: marker, atomically: true, encoding: .utf8)
    }}

    /// Only the titles whose translations this bundle carries.
    static var embedded: [MetavisionTitle] {{
        let fw = Bundle.main.bundleURL.appendingPathComponent("Frameworks")
        return all.filter {{ FileManager.default.fileExists(atPath: fw.appendingPathComponent($0.id).path) }}
    }}
}}

/// Set by the compositor on the first frame that reaches the display.
enum MetavisionShell {{
    nonisolated(unsafe) static var drawing = false
    static let windowID = "metavision-main"
}}

struct MetavisionRoot: View {{
    @State private var chosen: String? = MetavisionRoot.autostart()
    @Environment(\\.dismissWindow) private var dismissWindow

    /// MV_AUTOSTART=<target> — from the launch environment or Documents/klepton.env
    /// — opens that title directly, for unattended test passes.
    static func autostart() -> String? {{
        var id = ProcessInfo.processInfo.environment["MV_AUTOSTART"]
        if id == nil {{
            let env = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
                .appendingPathComponent("klepton.env")
            for line in ((try? String(contentsOf: env, encoding: .utf8)) ?? "").split(separator: "\\n") {{
                let kv = line.split(separator: "=", maxSplits: 1).map {{ $0.trimmingCharacters(in: .whitespaces) }}
                if kv.count == 2, kv[0] == "MV_AUTOSTART" {{ id = kv[1] }}
            }}
        }}
        guard let id, !id.isEmpty, MetavisionCatalog.embedded.contains(where: {{ $0.id == id }}) else {{ return nil }}
        MetavisionCatalog.fileLastRunLogs(next: id)
        setenv("KL_TARGET", id, 1)
        MetavisionCatalog.armMic(for: id)
        return id
    }}

    var body: some View {{
        if chosen != nil {{
            // The boot window has done its job once the title is drawing: close
            // it then, not earlier, so a title that stops before its first
            // picture still shows why. MV_KEEP_BOOT_WINDOW=1 keeps it.
            BootView()
                .task {{
                    guard ProcessInfo.processInfo.environment["MV_KEEP_BOOT_WINDOW"] != "1" else {{ return }}
                    while !MetavisionShell.drawing {{
                        try? await Task.sleep(for: .milliseconds(250))
                    }}
                    try? await Task.sleep(for: .seconds(1))
                    dismissWindow(id: MetavisionShell.windowID)
                }}
        }} else {{
            MetavisionLibrary(chosen: $chosen)
        }}
    }}
}}

struct MetavisionLibrary: View {{
    @Binding var chosen: String?
    @State private var mode: String =
        UserDefaults.standard.string(forKey: "metavision.inputMode") ?? MetavisionHandsFree.Mode.auto.rawValue
    private let titles = MetavisionCatalog.embedded
    private let columns = [GridItem(.adaptive(minimum: 240), spacing: 16)]

    var body: some View {{
        NavigationStack {{
            ScrollView {{
                // Input mode, remembered; the title starts in it. Auto switches on
                // whether a hand is in view, Hands never goes hands-free, Hands-free
                // ignores tracked hands entirely (see docs/ACCESSIBILITY.md).
                Picker("Input", selection: $mode) {{
                    Text("Auto").tag(MetavisionHandsFree.Mode.auto.rawValue)
                    Text("Hands").tag(MetavisionHandsFree.Mode.hands.rawValue)
                    Text("Hands-free").tag(MetavisionHandsFree.Mode.handsfree.rawValue)
                }}
                .pickerStyle(.segmented)
                .accessibilityLabel("Input mode")
                .onChange(of: mode) {{ _, m in
                    if let mm = MetavisionHandsFree.Mode(rawValue: m) {{ MetavisionHandsFree.remember(mm) }}
                }}
                .padding(.horizontal)
                .padding(.top)

                if titles.isEmpty {{
                    Text("This build carries no titles.").padding()
                }}
                LazyVGrid(columns: columns, spacing: 16) {{
                    ForEach(titles) {{ t in
                        Button {{
                            MetavisionCatalog.fileLastRunLogs(next: t.id)
                            setenv("KL_TARGET", t.id, 1)   // read by kl_app_configure at boot
                            MetavisionCatalog.armMic(for: t.id)
                            chosen = t.id
                        }} label: {{
                            HStack(spacing: 14) {{
                                // The title's own icon, copied in by `metavision-device stage`
                                // (or `icons`); titles not staged yet show text only.
                                if let img = UIImage(contentsOfFile: MetavisionCatalog.iconPath(t.id)) {{
                                    Image(uiImage: img)
                                        .resizable()
                                        .interpolation(.high)
                                        .aspectRatio(contentMode: .fit)
                                        .frame(width: 56, height: 56)
                                        .clipShape(RoundedRectangle(cornerRadius: 12, style: .continuous))
                                        .accessibilityHidden(true)
                                }}
                                VStack(alignment: .leading, spacing: 6) {{
                                    Text(t.name).font(.headline).lineLimit(2)
                                    Text(t.engine).font(.caption).foregroundStyle(.secondary)
                                }}
                            }}
                            .frame(maxWidth: .infinity, minHeight: 84, alignment: .leading)
                            .padding()
                        }}
                        .buttonStyle(.bordered)
                    }}
                }}
                .padding()
            }}
            .navigationTitle("metavision")
        }}
    }}
}}
''')
EOF
fi
G="$K/visionos/gen_xcodeproj.py"
grep -q '"MetavisionLibrary.swift"' "$G" || {
    grep -q '"KleptonLauncher.swift", "KleptonHL1.swift"\]' "$G" || die "SWIFT list anchor not found in gen_xcodeproj.py"
    sed -i.bak 's|"KleptonLauncher.swift", "KleptonHL1.swift"\]|"KleptonLauncher.swift", "KleptonHL1.swift", "MetavisionLibrary.swift"]|' "$G" && rm -f "$G.bak"
}
if [ "${MV_LAUNCHER:-0}" = 1 ]; then
    A="$K/visionos/Sources/KleptonApp.swift"
    grep -q 'MetavisionRoot()' "$A" || {
        [ "$(grep -c 'WindowGroup { BootView() }' "$A")" = 1 ] || die "KleptonApp.swift root anchor not found"
        sed -i.bak 's|WindowGroup { BootView() }|WindowGroup(id: MetavisionShell.windowID) { MetavisionRoot() }|' "$A" && rm -f "$A.bak"
    }
    echo "overlay: launcher root = metavision library"
fi
M="$K/visionos/mkguest.sh"
grep -q 'dev.klepton.guest.${KLT_NAME' "$M" || {
    grep -q 'dev.klepton.guest.$ID_NAME' "$M" || die "framework bundle-id anchor not found in mkguest.sh"
    sed -i.bak 's|dev.klepton.guest.$ID_NAME|dev.klepton.guest.${KLT_NAME//_/-}.$ID_NAME|' "$M" && rm -f "$M.bak"
}
echo "overlay: library screen generated; guest framework IDs carry the target"

# 5b — older Oculus XR Plugin (1.x, Unity 2019.4): its OculusUnity hands the
# display surface to the native side through initComplete(Surface), not the
# newer surfaceCreated(Surface) that Klepton's initOculus calls. Without a
# surface the plugin never starts its display: ten OVRPlugin calls, then no
# SetupDisplayObjects and no frames. Same signature, so fall back to it.
J="$K/runtime/jni/kl_jni_services.c"
if ! grep -q 'metavision: older Oculus XR Plugin' "$J"; then
    python3 - "$J" <<'EOF'
import sys
p = sys.argv[1]; s = open(p).read()
old = ('        if (img)\n'
       '            fn = kl_sym(img, "Java_com_unity_oculus_OculusUnity_surfaceCreated");\n')
new = ('        if (img) {\n'
       '            fn = kl_sym(img, "Java_com_unity_oculus_OculusUnity_surfaceCreated");\n'
       '            // metavision: older Oculus XR Plugin (1.x) names it initComplete(Surface)\n'
       '            if (!fn && (fn = kl_sym(img, "Java_com_unity_oculus_OculusUnity_initComplete")))\n'
       '                fprintf(stderr, "  [jni] older Oculus XR Plugin: surface handed over through initComplete\\n");\n'
       '        }\n')
if s.count(old) != 1:
    sys.exit("overlay: kl_jni_services.c surfaceCreated anchor moved upstream")
open(p, "w").write(s.replace(old, new))
EOF
fi
echo "overlay: older Oculus XR Plugin surface handshake (initComplete)"

# 6 — hands-free input (eyes and voice), klepton-overlay/MetavisionHandsFree.swift
#
# When no hand or Sense controller tracks the right controller, it becomes a
# pointer aimed by the head, snapped to the gaze ray of each system select
# (Dwell Control, Voice Control, a pinch), and the spoken word "select" presses
# its trigger; the other buttons are spoken by name (see the Swift file).
# Modes auto / hands / handsfree (launcher picker, voice, MV_INPUT_MODE);
# handsfree ignores tracked hands entirely.
cp "$ROOT/klepton-overlay/MetavisionHandsFree.swift" "$ROOT/klepton-overlay/MetavisionHands.swift" \
   "$ROOT/klepton-overlay/MetavisionAutoplay.swift" "$ROOT/klepton-overlay/MetavisionShots.swift" \
   "$ROOT/klepton-overlay/MetavisionTargets.swift" "$K/visionos/Sources/"
grep -q '"MetavisionHandsFree.swift"' "$G" || {
    grep -q '"MetavisionLibrary.swift"\]' "$G" || die "SWIFT list anchor (MetavisionLibrary) not found"
    sed -i.bak 's|"MetavisionLibrary.swift"\]|"MetavisionLibrary.swift", "MetavisionHandsFree.swift", "MetavisionHands.swift", "MetavisionAutoplay.swift", "MetavisionShots.swift", "MetavisionTargets.swift"]|' "$G" && rm -f "$G.bak"
}
python3 - "$K/visionos" <<'EOF'
import sys
v = sys.argv[1]
def patch(path, old, new, marker):
    s = open(path).read()
    if marker in s:
        return
    if s.count(old) != 1:
        sys.exit(f"overlay: anchor moved upstream in {path}: {old[:70]!r}")
    open(path, "w").write(s.replace(old, new))

# Meta hand tracking: publish the hand skeleton every frame (MetavisionHands.swift).
patch(f"{v}/Sources/KleptonControllers.swift",
      "                at presentationTime: TimeInterval) {\n        pollButtons()\n",
      "                at presentationTime: TimeInterval) {\n        pollButtons()\n"
      "        MetavisionHands.publish(left: leftHand, right: rightHand)   // metavision: hand tracking\n",
      "metavision: hand tracking")

# Unattended test passes: scripted controller input (MetavisionAutoplay.swift).
patch(f"{v}/Sources/KleptonControllers.swift",
      "        reportPinch()\n",
      "        reportPinch()\n        MetavisionAutoplay.drive()   // metavision: autoplay\n",
      "metavision: autoplay")

# Auto-play's head motion: the head pose the title is given (not the display's).
patch(f"{v}/Sources/KleptonCompositor.swift",
      "            let (p, q) = Self.decompose(\n"
      "                Self.headFrom(anchor.originFromAnchorTransform, midpoint: eyeMidpointInDevice))\n",
      "            let (p, q) = MetavisionAutoplay.moveHead(Self.decompose(   // metavision: autoplay head\n"
      "                Self.headFrom(anchor.originFromAnchorTransform, midpoint: eyeMidpointInDevice)))\n",
      "metavision: autoplay head")
# ...and no per-instant prediction while it moves: that would be the real head.
patch(f"{v}/Sources/KleptonCompositor.swift",
      "        guard let out, let tracker = KleptonCompositor.headAtTracker else { return 0 }\n",
      "        guard !MetavisionAutoplay.movesHead,   // metavision: autoplay head prediction\n"
      "              let out, let tracker = KleptonCompositor.headAtTracker else { return 0 }\n",
      "metavision: autoplay head prediction")

# Test-pass screenshots of the eye the title drew (MetavisionShots.swift).
patch(f"{v}/Sources/KleptonCompositor.swift",
      "            let a = eyeSource(vi, stage)\n",
      "            let a = eyeSource(vi, stage)\n"
      "            if vi == viewIndices.first, let a {   // metavision: shots\n"
      "                MetavisionShots.offer(a.texture, slice: a.slice, flipY: a.flipY, queue: queue)\n"
      "            }\n",
      "metavision: shots")
# ...and auto-play's targets: what looks pressable in that eye (MetavisionTargets.swift),
# placed with the frustum, viewport and head pose the title rendered it with.
patch(f"{v}/Sources/KleptonCompositor.swift",
      "                MetavisionShots.offer(a.texture, slice: a.slice, flipY: a.flipY, queue: queue)\n",
      "                MetavisionShots.offer(a.texture, slice: a.slice, flipY: a.flipY, queue: queue)\n"
      "                if haveRendered {   // metavision: targets\n"
      "                    let e = vi == 0\n"
      "                    let t = e ? rendered.tangents.0 : rendered.tangents.1\n"
      "                    let r = e ? rendered.viewport.0 : rendered.viewport.1\n"
      "                    MetavisionTargets.offer(a.texture, slice: a.slice, flipY: a.flipY, queue: queue,\n"
      "                        viewport: SIMD4<Int32>(r.0, r.1, r.2, r.3), tangents: SIMD4<Float>(t.0, t.1, t.2, t.3),\n"
      "                        pose: (SIMD3<Float>(rendered.px, rendered.py, rendered.pz),\n"
      "                               simd_quatf(ix: rendered.qx, iy: rendered.qy, iz: rendered.qz, r: rendered.qw)))\n"
      "                }\n",
