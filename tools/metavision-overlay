// What a launch that died inside a library load left behind decides what this
// launch refuses. See tools/metavision-overlay step 136 for the whole story.
#include <errno.h>
#include <fcntl.h>
#include <sys/stat.h>
#include "kl_target.h"
#define KL_GUARD_MAX     16
#define KL_GUARD_REFUSED 32
static pthread_mutex_t g_guard_lock = PTHREAD_MUTEX_INITIALIZER;
static int   g_guard_state;                 // 0 not yet, 1 on, -1 off
static int   g_guard_fd = -1;               // read by kl_dl_guard_fault: a plain int
static char  g_guard_list[1024];            // the refused list's path
static char *g_guard_refused[KL_GUARD_REFUSED];
static unsigned g_guard_nrefused;
static char *g_guard_stack[KL_GUARD_MAX];   // libraries loading now, innermost last
static unsigned g_guard_depth;

static const char *kl_guard_base(const char *p) {
    const char *b = strrchr(p, '/');
    return b ? b + 1 : p;
}
// "libfoo.so", "libfoo" and "foo" are one library: Unity and IL2CPP ask for
// a plugin under each spelling.
static size_t kl_guard_stem(const char *b, const char **out) {
    if (!strncmp(b, "lib", 3)) b += 3;
    size_t n = strlen(b);
    if (n > 3 && !strcmp(b + n - 3, ".so")) n -= 3;
    *out = b;
    return n;
}
static int kl_guard_same(const char *a, const char *b) {
    const char *sa, *sb;
    size_t na = kl_guard_stem(kl_guard_base(a), &sa), nb = kl_guard_stem(kl_guard_base(b), &sb);
    return na && na == nb && !strncmp(sa, sb, na);
}
// The engine itself: refusing it cannot help, the title does not run without it.
static int kl_guard_essential(const char *name) {
    static const char *const core[] = {
        "libmain.so", "libunity.so", "libil2cpp.so", "libUE4.so", "libUnreal.so",
        "libc++_shared.so", "libmonobdwgc-2.0.so", "libmono.so", "libmonosgen-2.0.so",
    };
    for (unsigned i = 0; i < sizeof core / sizeof core[0]; i++)
        if (kl_guard_same(name, core[i])) return 1;
    const char *t = kl_driver_target_name();
    const kl_target *kt = t ? kl_target_lookup(t) : NULL;
    return kt && kt->entry_lib && kl_guard_same(name, kt->entry_lib);
}
static int kl_guard_listed_locked(const char *name) {
    for (unsigned i = 0; i < g_guard_nrefused; i++)
        if (kl_guard_same(name, g_guard_refused[i])) return 1;
    return 0;
}
static void kl_guard_init_locked(void) {
    if (g_guard_state) return;
    g_guard_state = -1;
    if (!kl_env_on("KL_DLOPEN_GUARD", 1)) {
        fprintf(stderr, "  [dl] load guard off (KL_DLOPEN_GUARD=0)\n");
        return;
    }
    const char *dir = kl_jni_files_dir();
    if (!dir || !*dir) return;
    mkdir(dir, 0755);
    char gp[1024];
    snprintf(gp, sizeof gp, "%s/.klepton-dlguard", dir);
    snprintf(g_guard_list, sizeof g_guard_list, "%s/.klepton-dlrefused", dir);
    if (kl_env_on("KL_DLOPEN_GUARD_RESET", 0)) {
        unlink(g_guard_list);
        unlink(gp);
        fprintf(stderr, "  [dl] load guard reset (KL_DLOPEN_GUARD_RESET=1): no library "
                        "is refused for killing a launch\n");
    }
    int fd = open(gp, O_RDWR | O_CREAT | O_CLOEXEC, 0644);
    if (fd < 0) {
        fprintf(stderr, "  [dl] load guard off: cannot open %s: %s\n", gp, strerror(errno));
        return;
    }
