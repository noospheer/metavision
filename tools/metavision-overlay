// CreatePlayer(api, useFastOesPath, showPosterFrame, int, bool)
static klj_val avp_create(void *env, void *self, const klj_val *a, int n) {
    (void)env;
    if (!kl_env_on("MV_VIDEO_PLUGIN", 1)) {
        KLJ_LOG_ONCE("video plugin: MV_VIDEO_PLUGIN=0 — CreatePlayer refused");
        return (klj_val){0};
    }
    pthread_once(&avp_media_once, avp_media_load);
    int api = n > 0 ? (int)(int32_t)a[0].j : 0;
    if (!M.ok || (api != 1 && api != 2)) return (klj_val){0};
    pthread_mutex_lock(&g_tab_lk);
    if (!g_iface_live || self != g_iface) { pthread_mutex_unlock(&g_tab_lk); return (klj_val){0}; }
    int index = -1;
    for (int i = 0; i < AVP_MAX && index < 0; i++) if (!g_slot[i]) index = i;
    if (index < 0) { pthread_mutex_unlock(&g_tab_lk); KLJ_LOG("video plugin: no free player"); return (klj_val){0}; }
    avp *p = calloc(1, sizeof *p);
    int16_t *ring = calloc(AVP_RING * 2, sizeof *ring);
    if (!p || !ring) { pthread_mutex_unlock(&g_tab_lk); free(p); free(ring); return (klj_val){0}; }
    pthread_mutex_init(&p->lk, NULL);
    p->ring = ring;
    p->index = index;
    p->alive = 1;
    p->api = api;
    p->fast_oes = n > 1 && a[1].j;
    p->poster = n > 2 && a[2].j;
    p->volume = 1.0f;
    p->rate = 1.0f;
    p->tex_ts_ns = INT64_MIN;
    p->self = klj_new_object_data(AVP_PLAYER, p);
    kl_jni_pin_object(p->self);        // the title keeps it as a global ref
    g_slot[index] = p;
    pthread_mutex_unlock(&g_tab_lk);
    KLJ_LOG("video plugin: CreatePlayer(api %d%s) -> player %d", api, p->fast_oes ? ", fast OES" : "", index);
    return (klj_val){.l = p->self};
}

static void avp_bury(avp *p) {
    avp_grave *g = calloc(1, sizeof *g);
    pthread_mutex_lock(&p->lk);
    if (g) {
        g->tex[0] = p->oes_tex;
        g->tex[1] = p->rgba_tex;
        g->fbo = p->fbo;
        g->st = p->st;
        g->surface = p->surface;
        g->window = p->window;
    }
    p->oes_tex = p->rgba_tex = p->fbo = 0;
    p->st = p->surface = p->window = NULL;
    p->gl_setup = 0;
    pthread_mutex_unlock(&p->lk);
    if (!g) return;
    pthread_mutex_lock(&g_tab_lk);
    g->next = g_graves;
    g_graves = g;
    pthread_mutex_unlock(&g_tab_lk);
}

static klj_val avp_destroy(void *env, void *self, const klj_val *a, int n) {
    (void)env; (void)self;
    int index = n > 0 ? (int)(int32_t)a[0].j : -1;
    avp *p = avp_at(index);
    if (!p) return (klj_val){0};
    avp_close(p);                      // Deinitialise
    pthread_mutex_lock(&g_tab_lk);
    if (g_slot[index] == p) g_slot[index] = NULL;
    pthread_mutex_unlock(&g_tab_lk);
    pthread_mutex_lock(&p->lk);
    p->alive = 0;
    p->deinit_flagged = 1;
    pthread_mutex_unlock(&p->lk);
    avp_bury(p);                       // GL objects go on the render thread
    p->deinitialised = 1;
    KLJ_LOG("video plugin: DestroyPlayer(%d)", index);
    return (klj_val){0};               // the struct stays: the title may still hold the object
}

