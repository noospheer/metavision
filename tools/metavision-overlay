        Il2CppObject *a = m_arr ? invoke(m_arr, NULL, "Selectable.all") : NULL;
        uint32_t n = a ? il.array_length(a) : 0;
        for (uint32_t i = 0; i < n && nc < MV_CAND; i++) {
            Il2CppObject *o = ((Il2CppObject **)((uint8_t *)a + ARR_DATA))[i];
            if (!o) continue;
            Il2CppClass *k = il.object_get_class(o);
            const char *kind = mv_kind(k), *ns = mvx.ns(k);
            if (!kind && ns && strncmp(ns, "UnityEngine", 11) && strcmp(ns, "TMPro") &&
