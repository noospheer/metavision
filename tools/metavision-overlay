# 24 — Unity's boot.config: secondary command buffers and graphics jobs off.
# Replaying a secondary command buffer whose draws begin a render pass faults
# in MoltenVK (MVKRenderSubpass::populateMTLRenderPassDescriptor, a NULL
# attachment). vulkan-disable-secondary-commandbuffers alone did not stop it —
# Unity records secondaries for graphics jobs — so gfx-enable-gfx-jobs and
# gfx-enable-native-gfx-jobs are forced to 0 too, replacing any value the title
# set, and Unity records straight into primaries. boot.config is read through both
# asset doors (Java AssetManager.open and the NDK's AAssetManager_open), so both
# serve a patched copy from the app's tmp folder. Harmless on GLES.
python3 - "$K/runtime" <<'PYEOF'
import sys
rt = sys.argv[1]
def patch(path, old, new, marker):
    s = open(path).read()
    if marker in s:
        return
    if s.count(old) != 1:
        sys.exit(f"overlay: anchor moved upstream in {path}: {old[:60]!r}")
    open(path, "w").write(s.replace(old, new))
N = f"{rt}/guest/kl_ndk.c"
patch(N, "static void *kl_AAssetManager_open(void *mgr, const char *fname, int mode) {\n",
      "// metavision: boot.config with the options metavision needs appended (step 24).\n"
      "// Returns the patched copy's path, or `path` itself when it is not a boot.config.\n"
      "const char *kl_mv_bootcfg(const char *path, char *buf, size_t cap);\n"
      "const char *kl_mv_bootcfg(const char *path, char *buf, size_t cap) {\n"
      "    static const char suffix[] = \"/bin/Data/boot.config\";\n"
      "    size_t n = strlen(path), sl = sizeof suffix - 1;\n"
      "    if (n < sl || strcmp(path + n - sl, suffix) != 0) return path;\n"
      "    static const char *const add[] = { \"vulkan-disable-secondary-commandbuffers=1\",\n"
      "                                       \"gfx-enable-gfx-jobs=0\", \"gfx-enable-native-gfx-jobs=0\" };\n"
      "    FILE *in = fopen(path, \"rb\");\n"
      "    if (!in) return path;\n"
      "    char body[65536]; size_t len = fread(body, 1, sizeof body - 1, in); fclose(in);\n"
      "    body[len] = 0;\n"
      "    const char *tmp = getenv(\"TMPDIR\");\n"
      "    snprintf(buf, cap, \"%s/mv-boot.config\", tmp && *tmp ? tmp : \"/tmp\");\n"
      "    FILE *out = fopen(buf, \"wb\");\n"
      "    if (!out) return path;\n"
      "    // Every line but the ones set here, then ours: a value the title set\n"
      "    // (gfx-enable-gfx-jobs=1) is replaced, not left to win.\n"
