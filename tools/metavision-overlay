// Track 1 exists only when the demuxer opened an AAC track.
static int mv_xa_on(klm_extractor *x) {
    return x && x->dm && kl_avdemux_audio_info(x->dm, NULL, NULL, NULL, NULL, NULL);
}
// The track whose sample is current: the earliest of the selected tracks (video
// on a tie), -1 when they are all spent. Nothing selected means the video track
// alone, which is what this extractor always served.
static int mv_xa_cur(klm_extractor *x) {
    unsigned sel = x->mv_sel_explicit ? x->mv_sel : 1u;
    long long tv = (sel & 1u) ? kl_avdemux_sample_time_us(x->dm) : -1;
    long long ta = ((sel & 2u) && mv_xa_on(x)) ? kl_avdemux_audio_sample_time_us(x->dm) : -1;
    if (tv < 0 && ta < 0) return -1;
    if (ta < 0) return 0;
    if (tv < 0) return 1;
    return ta < tv ? 1 : 0;
}
static void *mv_xa_format(klm_extractor *x) {
    int rate = 0, ch = 0;
    long long dur = 0;
    const unsigned char *asc = NULL;
    size_t asc_len = 0;
    if (!kl_avdemux_audio_info(x->dm, &rate, &ch, &dur, &asc, &asc_len)) return NULL;
    klm_format *f = klm_AMediaFormat_new();
    if (!f) return NULL;
    klm_AMediaFormat_setString(f, g_key_mime, "audio/mp4a-latm");
    klm_AMediaFormat_setInt32(f, g_key_sample_rate, rate);
    klm_AMediaFormat_setInt32(f, g_key_channel_count, ch);
    klm_AMediaFormat_setInt32(f, g_key_duration, (int32_t)dur);
    klm_AMediaFormat_setInt32(f, "max-input-size", 8192);   // an AAC packet is <= 768 bytes a channel
    klm_AMediaFormat_setString(f, g_key_language, "und");
    mv_fmt_set_blob(f, "csd-0", asc, asc_len);
    return f;
}

