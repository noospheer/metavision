# 57 — file locks are translated, not refused. SQLite takes its database locks
# with fcntl(F_SETLK); refused (EINVAL), every open reported "disk I/O error"
# and a title waited forever on a database it could not check. Linux arm64's
# struct flock is {short type, short whence, off_t start, off_t len, pid_t pid}
# and Darwin's {off_t start, off_t len, pid_t pid, short type, short whence};
# the lock types differ too (Linux RD/WR/UN 0/1/2, Darwin 1/3/2). The call is
# made on a Darwin copy and F_GETLK's answer is written back. Linux's
# open-file-description locks (36/37/38) are taken as the process locks they
# coincide with for a single-process guest.
python3 - "$K/runtime/libc/kl_libc.c" <<'PYEOF'
import sys
p = sys.argv[1]
s = open(p).read()
marker = "metavision: file locks translated (step 57)"
if marker not in s:
    old = ('    case LX_F_GETLK: case LX_F_SETLK: case LX_F_SETLKW:\n'
           '        warn_once("fcntl file locking (struct flock layout differs) — refused");\n'
           '        errno = EINVAL;\n'
           '        return -1;\n')
    if s.count(old) != 1:
        sys.exit(f"overlay: anchor moved upstream in {p}: {old[:60]!r}")
    s = s.replace(old,
        '    case LX_F_GETLK: case LX_F_SETLK: case LX_F_SETLKW:   // ' + marker + '\n'
        '    case 36: case 37: case 38: {                          // F_OFD_GETLK / SETLK / SETLKW\n'
        '        struct lx_flock { short type, whence; int pad; int64_t start, len; int pid, pad2; };\n'
        '        struct lx_flock *lf = (struct lx_flock *)arg;\n'
        '        if (!lf) { errno = EFAULT; return -1; }\n'
        '        static const short to_d[3] = { F_RDLCK, F_WRLCK, F_UNLCK };\n'
        '        if (lf->type < 0 || lf->type > 2) { errno = EINVAL; return -1; }\n'
        '        struct flock df = { .l_start = lf->start, .l_len = lf->len, .l_pid = lf->pid,\n'
        '                            .l_type = to_d[lf->type], .l_whence = lf->whence };\n'
        '        int dc = (cmd == LX_F_GETLK || cmd == 36) ? F_GETLK\n'
        '               : (cmd == LX_F_SETLK || cmd == 37) ? F_SETLK : F_SETLKW;\n'
