      "            size_t k = strcspn(add[i], \"=\");\n"
      "            if (ll > k && strncmp(line, add[i], k + 1) == 0) ours = 1;\n"
      "        }\n"
      "        if (!ours) { fwrite(line, 1, ll, out); fputc('\\n', out); }\n"
      "        line = nl ? nl + 1 : line + ll;\n"
      "    }\n"
      "    for (size_t i = 0; i < sizeof add / sizeof add[0]; i++) fprintf(out, \"%s\\n\", add[i]);\n"
      "    fclose(out);\n"
      "    static int said;\n"
      "    if (!said++) fprintf(stderr, \"  [mv] boot.config: secondary command buffers and graphics jobs off\\n\");\n"
      "    return buf;\n"
      "}\n\n"
      "static void *kl_AAssetManager_open(void *mgr, const char *fname, int mode) {\n",
