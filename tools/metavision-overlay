    if (!on) return;
    double now = mv_now();
    if (!t0) { t0 = now; next = now + kl_env_uint("MV_AUTOPLAY_UI_FROM", 10); }
    if (bound) mv_release(now, t0, 0);          // every frame: a release is due _HOLD_MS after its press
    if (now < next) return;
