#!/usr/bin/env bash
# metavision-overlay — apply metavision's build-time changes to a Klepton tree.
#
# Run on a THROWAWAY checkout (the CI runner's, or a copy): it edits files in
# vendor/klepton so that its own build picks up what metavision adds. The
# submodule in the repo is never committed with these changes.
#
#   1. targets.py   <- build/klepton-targets.py (upstream table + generated rows),
#                   and runtime/kl_target_table.h regenerated from it
#   2. Makefile     RUNTIME_SHIP gains shims/mv_shims.c, so the shim layer is
#                   compiled into libklepton.a with the runtime's own flags
#   3. gen_xcodeproj.py  the app links with -u _mv_shims_install: the shims are
#                   reached only through a constructor, and a static archive's
#                   member that nothing references is otherwise not linked
#   4. kl_app.c     multi-guest bundles: titles load from Frameworks/<target>/
#   5. launcher     generated library screen (root only with MV_LAUNCHER=1);
#                   guest framework IDs carry the target
#   6. guests       staged guest trees symlinked in (metavision-targets link)
#
# Idempotent; each step checks its anchor and fails loudly if upstream moved it.
#
# usage: tools/metavision-overlay [KLEPTON_DIR]     (default: vendor/klepton)
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
K=$(cd "${1:-$ROOT/vendor/klepton}" && pwd)
SHIMS_REL=$(python3 -c "import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))" "$ROOT/shims" "$K")

die() { echo "overlay: $*" >&2; exit 1; }

# 1 — target table
[ -f "$ROOT/build/klepton-targets.py" ] || die "build/klepton-targets.py missing: run tools/metavision-targets emit"
cp "$ROOT/build/klepton-targets.py" "$K/visionos/targets.py"
echo "overlay: targets.py <- generated table ($(python3 "$K/visionos/targets.py" --list | grep -c '^mv_') mv_ targets)"
# ...and the runtime's own copy of it. kl_target_table.h is committed upstream,
# so without this the app knows no mv_ target and stops at "missing guest target".
(cd "$K" && python3 visionos/targets.py --c-table > runtime/kl_target_table.h)
echo "overlay: runtime/kl_target_table.h regenerated ($(grep -c 'KL_TARGET_ROW("mv_' "$K/runtime/kl_target_table.h") mv_ rows)"

# 2 — shims into the shipping runtime
if ! grep -q 'mv_shims.c' "$K/Makefile"; then
    grep -q '^RUNTIME_SHIP := ' "$K/Makefile" || die "RUNTIME_SHIP not found in Makefile"
    # After the (possibly multi-line) RUNTIME_SHIP definition: the first line
    # that does not end in a backslash closes it.
    awk -v add="RUNTIME_SHIP += $SHIMS_REL/mv_shims.c" '
        { print }
        /^RUNTIME_SHIP := / { inside = 1 }
        inside && !/\\$/ { print add; inside = 0 }
    ' "$K/Makefile" > "$K/Makefile.mv" && mv "$K/Makefile.mv" "$K/Makefile"
    grep -q '^RUNTIME_INC' "$K/Makefile" || die "RUNTIME_INC not found in Makefile"
    sed -i.bak "s|^RUNTIME_INC \(:\?=\) |RUNTIME_INC \1 -I$SHIMS_REL |" "$K/Makefile" && rm -f "$K/Makefile.bak"
fi
echo "overlay: Makefile RUNTIME_SHIP += $SHIMS_REL/mv_shims.c"

# 3 — keep the constructor-only shim object in the link
G="$K/visionos/gen_xcodeproj.py"
if ! grep -q '_mv_shims_install' "$G"; then
    grep -q 'OTHER_LDFLAGS = "-lz ' "$G" || die "OTHER_LDFLAGS anchor not found in gen_xcodeproj.py"
    sed -i.bak 's|OTHER_LDFLAGS = "-lz |OTHER_LDFLAGS = "-Wl,-u,_mv_shims_install -lz |' "$G" && rm -f "$G.bak"
fi
echo "overlay: app links with -u _mv_shims_install"

# 4 — multi-guest bundles (the metavision launcher)
#
# A launcher embeds many titles, and two Unity titles both ship libunity, so
# each title's translations live in Frameworks/<target>/ instead of flat in
# Frameworks/. When that folder exists, kl_app.c loads the title from it,
# keeps ANGLE and MoltenVK on the shared Frameworks/, and gives the title its
# own Android files directory (otherwise every title would share one, and
# with it each other's saves). A single-title app has no such folder and is
# unchanged.
A="$K/visionos/Sources/kl_app.c"
if ! grep -q 'metavision: multi-guest' "$A"; then
    python3 - "$A" <<'EOF'
import sys
p = sys.argv[1]; s = open(p).read()
def rep(old, new):
    global s
    if s.count(old) != 1:
        sys.exit(f"overlay: kl_app.c anchor moved upstream: {old[:60]!r}")
    s = s.replace(old, new)
rep('static char g_dylibs[1024];',
    'static char g_dylibs[1024];\nstatic char g_shared_fw[1024];   // metavision: multi-guest — ANGLE/MoltenVK stay here')
rep('    snprintf(g_dylibs, sizeof g_dylibs, "%s/Frameworks", resources);\n',
    '    snprintf(g_dylibs, sizeof g_dylibs, "%s/Frameworks", resources);\n'
    '    snprintf(g_shared_fw, sizeof g_shared_fw, "%s", g_dylibs);\n'
    '    {   // metavision: multi-guest — a launcher keeps each title in Frameworks/<target>/\n'
    '        char per[1100];\n'
    '        snprintf(per, sizeof per, "%s/%s", g_shared_fw, g_target->name);\n'
    '        if (have(per)) snprintf(g_dylibs, sizeof g_dylibs, "%s", per);\n'
    '    }\n')
rep('    snprintf(g_files,  sizeof g_files,  "%s/android-files", container);\n',
    '    if (strcmp(g_dylibs, g_shared_fw) != 0)   // metavision: multi-guest — per-title files\n'
    '    {   snprintf(g_files, sizeof g_files, "%s/%s", container, g_target->tree);\n'
    '        mkdir(g_files, 0755);   /* the title folder may not exist before its assets do */\n'
    '        snprintf(g_files, sizeof g_files, "%s/%s/android-files", container, g_target->tree); }\n'
    '    else\n'
    '        snprintf(g_files, sizeof g_files, "%s/android-files", container);\n')
rep('    setenv("KL_ANGLE_DIR", g_dylibs, 0);', '    setenv("KL_ANGLE_DIR", g_shared_fw, 0);')
rep('    setenv("KL_MVK_DIR", g_dylibs, 0);', '    setenv("KL_MVK_DIR", g_shared_fw, 0);')
# A hand-launched app has no environment, and Klepton's diagnostics are all
# environment switches. Documents/klepton.env (KEY=VALUE lines, # comments)
# is read before anything else in configure; metavision-device env writes it.
rep('int kl_app_configure(const char *resources, const char *container) {\n'
    '    if (!resources || !container) return missing("path", "(null)");\n',
    'int kl_app_configure(const char *resources, const char *container) {\n'
    '    if (!resources || !container) return missing("path", "(null)");\n'
    '    {   // metavision: Documents/klepton.env\n'
    '        char ep[1200], line[1024];\n'
    '        snprintf(ep, sizeof ep, "%s/klepton.env", container);\n'
    '        FILE *ef = fopen(ep, "r");\n'
    '        while (ef && fgets(line, sizeof line, ef)) {\n'
    '            char *nl = strchr(line, \'\\n\'); if (nl) *nl = 0;\n'
    '            char *eq = strchr(line, \'=\');\n'
    '            if (line[0] == \'#\' || !eq) continue;\n'
    '            *eq = 0; setenv(line, eq + 1, 1);\n'
    '        }\n'
    '        if (ef) fclose(ef);\n'
    '    }\n')
open(p, "w").write(s)
EOF
fi
echo "overlay: kl_app.c loads a launcher's titles from Frameworks/<target>/"

# 5 — the launcher's library screen
#
# MetavisionLibrary.swift is generated from the target table: one tile per
# title this bundle actually embeds (Frameworks/<target>/ present). Picking a
# tile sets KL_TARGET and shows Klepton's BootView, which boots that title.
# The file is compiled into every app; only MV_LAUNCHER=1 makes it the root
# window, so single-title apps keep Klepton's own root.
#
# Guest framework bundle IDs also gain the target name: they were
# dev.klepton.guest.<lib>, identical for every Unity title, and one bundle may
# not embed two frameworks with the same identifier.
S="$K/visionos/Sources/MetavisionLibrary.swift"
if [ -f "$ROOT/build/guests/targets.json" ]; then
    python3 - "$ROOT/build/guests/targets.json" "$S" <<'EOF'
import json, sys
rows = json.load(open(sys.argv[1]))
engine = {"unity": "Unity", "ue4": "Unreal Engine 4"}
def lit(s):   # a Swift string literal; JSON's escapes are Swift's apart from \u, avoided here
    return json.dumps(s, ensure_ascii=False)
entries = ",\n".join(f'        MetavisionTitle(id: {lit(k)}, name: {lit(v.get("display") or k)}, engine: {lit(engine.get(v["kind"], v["kind"]))})'
                     for k, v in sorted(rows.items(), key=lambda kv: (kv[1].get("display") or kv[0]).lower()))
open(sys.argv[2], "w").write(f'''// GENERATED by tools/metavision-overlay from the target table. Do not edit.
//
// The metavision launcher's root: a library of the titles this bundle embeds.
// A process boots one title (its libraries stay mapped), so choosing another
// means closing the app and opening it again.
import SwiftUI
import Foundation

struct MetavisionTitle: Identifiable, Hashable {{
    let id: String
    let name: String
    let engine: String
}}

enum MetavisionCatalog {{
    static let all: [MetavisionTitle] = [
{entries}
    ]

    /// Only the titles whose translations this bundle carries.
    static var embedded: [MetavisionTitle] {{
        let fw = Bundle.main.bundleURL.appendingPathComponent("Frameworks")
        return all.filter {{ FileManager.default.fileExists(atPath: fw.appendingPathComponent($0.id).path) }}
    }}
}}

struct MetavisionRoot: View {{
    @State private var chosen: String? = nil

    var body: some View {{
        if chosen != nil {{
            BootView()
        }} else {{
            MetavisionLibrary(chosen: $chosen)
        }}
    }}
}}

struct MetavisionLibrary: View {{
    @Binding var chosen: String?
    private let titles = MetavisionCatalog.embedded
    private let columns = [GridItem(.adaptive(minimum: 240), spacing: 16)]

    var body: some View {{
        NavigationStack {{
            ScrollView {{
                if titles.isEmpty {{
                    Text("This build carries no titles.").padding()
                }}
                LazyVGrid(columns: columns, spacing: 16) {{
                    ForEach(titles) {{ t in
                        Button {{
                            setenv("KL_TARGET", t.id, 1)   // read by kl_app_configure at boot
                            chosen = t.id
                        }} label: {{
                            VStack(alignment: .leading, spacing: 6) {{
                                Text(t.name).font(.headline).lineLimit(2)
                                Text(t.engine).font(.caption).foregroundStyle(.secondary)
                            }}
                            .frame(maxWidth: .infinity, minHeight: 84, alignment: .leading)
                            .padding()
                        }}
                        .buttonStyle(.bordered)
                    }}
                }}
                .padding()
            }}
            .navigationTitle("metavision")
        }}
    }}
}}
''')
EOF
fi
G="$K/visionos/gen_xcodeproj.py"
grep -q '"MetavisionLibrary.swift"' "$G" || {
    grep -q '"KleptonLauncher.swift", "KleptonHL1.swift"\]' "$G" || die "SWIFT list anchor not found in gen_xcodeproj.py"
    sed -i.bak 's|"KleptonLauncher.swift", "KleptonHL1.swift"\]|"KleptonLauncher.swift", "KleptonHL1.swift", "MetavisionLibrary.swift"]|' "$G" && rm -f "$G.bak"
}
if [ "${MV_LAUNCHER:-0}" = 1 ]; then
    A="$K/visionos/Sources/KleptonApp.swift"
    grep -q 'WindowGroup { MetavisionRoot() }' "$A" || {
        [ "$(grep -c 'WindowGroup { BootView() }' "$A")" = 1 ] || die "KleptonApp.swift root anchor not found"
        sed -i.bak 's|WindowGroup { BootView() }|WindowGroup { MetavisionRoot() }|' "$A" && rm -f "$A.bak"
    }
    echo "overlay: launcher root = metavision library"
fi
M="$K/visionos/mkguest.sh"
grep -q 'dev.klepton.guest.${KLT_NAME' "$M" || {
    grep -q 'dev.klepton.guest.$ID_NAME' "$M" || die "framework bundle-id anchor not found in mkguest.sh"
    sed -i.bak 's|dev.klepton.guest.$ID_NAME|dev.klepton.guest.${KLT_NAME//_/-}.$ID_NAME|' "$M" && rm -f "$M.bak"
}
echo "overlay: library screen generated; guest framework IDs carry the target"

# 6 — guests
if [ -f "$ROOT/build/guests/targets.json" ]; then
    python3 - "$ROOT/build/guests" "$K" <<'EOF'
import json, os, sys
guests, k = sys.argv[1], sys.argv[2]
n = 0
for slug in json.load(open(os.path.join(guests, "targets.json"))):
    for name in (slug, slug + ".apk"):
        src, dst = os.path.join(guests, name), os.path.join(k, name)
        if os.path.exists(src) and not os.path.lexists(dst):
            os.symlink(src, dst); n += 1
print(f"overlay: linked {n} staged guest paths")
EOF
fi
