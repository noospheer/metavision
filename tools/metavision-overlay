    int e = p->last_error;
    p->last_error = 0;
    return e;
}
static int64_t avp_position_locked(avp *p) {
    int64_t ms = clk_locked(p) / 1000;
    if (ms < 0) ms = 0;
    if (p->dur_ms > 0 && ms > p->dur_ms) ms = p->dur_ms;
    return ms;
}
