                fprintf(stderr, "[mv-autoplay-ui] guarded '%s'%s%s%s: no scripted tap reaches it\n", \
                        x_->lab[0] ? x_->lab : x_->nm, ev_[0] ? " (" : "", ev_, ev_[0] ? ")" : ""); \
            }                                                                                \
            mvud[di_].unsafe_ = 1; nskip++;                                                  \
            snprintf(skip, sizeof skip, "%s", x_->lab[0] ? x_->lab : x_->nm); break;         \
        }                                                                                    \
