# 31 — kl_env_* is async-signal-safe. Darwin's getenv takes __environ_lock (an
# os_unfair_lock). bionic sem_post is the one semaphore call a signal handler may
# make (Boehm's stop-the-world suspend handler does), and klb_sem_post asks
# kl_env_on("KL_TRACE_SIG") on every call. When the GC signal lands on a thread
# that is already inside getenv, the handler's getenv locks the same lock again,
# and libplatform kills the process ("Trying to recursively lock an
# os_unfair_lock"). The lookup now walks environ without that lock, and
# sem_post/pthread_kill read their trace flag once.
python3 - "$K/runtime" <<'PYEOF'
import sys
rt = sys.argv[1]
def patch(path, old, new, marker):
    s = open(path).read()
    if marker in s:
        return
    if s.count(old) != 1:
        sys.exit(f"overlay: anchor moved upstream in {path}: {old[:60]!r}")
    open(path, "w").write(s.replace(old, new))
patch(f"{rt}/kl_env.c", "#include <strings.h>\n",
      "#include <strings.h>\n\n"
      "// metavision: lock-free environment lookup (step 31). Darwin's getenv takes\n"
      "// __environ_lock; these helpers are reached from guest signal handlers\n"
      "// (sem_post inside a GC suspend handler), where re-taking that lock on a\n"
      "// thread interrupted inside getenv is a fatal recursive-lock abort.\n"
      "extern char **environ;\n"
      "static const char *kl_env_get(const char *name) {\n"
      "    size_t n = strlen(name);\n"
      "    for (char **e = environ; e && *e; e++)\n"
      "        if (strncmp(*e, name, n) == 0 && (*e)[n] == '=') return *e + n + 1;\n"
      "    return NULL;\n"
      "}\n"
      "#define getenv(n) kl_env_get(n)\n",
      "metavision: lock-free environment lookup")
P = f"{rt}/libc/kl_pthread.c"
patch(P, '    if (kl_env_on("KL_TRACE_SIG", 0)) {\n        static _Atomic int n;\n',
         '    static int mv_trace = -1;   // metavision: read once (step 31), this runs in signal handlers\n'
         '    if (mv_trace < 0) mv_trace = kl_env_on("KL_TRACE_SIG", 0);\n'
         '    if (mv_trace) {\n        static _Atomic int n;\n',
         "metavision: read once (step 31)")
patch(P, '    if (kl_env_on("KL_TRACE_SIG", 0))\n        fprintf(stderr, "  [sig] pthread_kill(',
         '    static int mv_trace_kill = -1;   // metavision: read once (step 31)\n'
         '    if (mv_trace_kill < 0) mv_trace_kill = kl_env_on("KL_TRACE_SIG", 0);\n'
