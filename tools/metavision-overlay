                unsigned lo;
                if (jhex4(&q, &lo) && lo >= 0xDC00 && lo < 0xE000) {
                    *p = q;
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                }
            }
            jutf8(&b, cp);
            break;
        case 0: free(b.p); return NULL;
        default: sb_put(&b, &e, 1); break;
        }
    }
    if (**p != '"') { free(b.p); return NULL; }
    (*p)++;
    return sb_take(&b);
}
static jv *jparse(const char **p, int depth) {
    if (depth > 100) return NULL;
    jws(p);
    char c = **p;
    if (c == '{' || c == '[') {
        char close = c == '{' ? '}' : ']';
        jv *v = jnew(c == '{' ? 'o' : 'a');
        (*p)++;
        jws(p);
        if (**p == close) { (*p)++; return v; }
        for (;;) {
            char *key = NULL;
            if (c == '{') {
                jws(p);
                key = jparse_str(p);
                jws(p);
                if (!key || **p != ':') { free(key); jfree(v); return NULL; }
                (*p)++;
            }
            jv *e = jparse(p, depth + 1);
            if (!e) { free(key); jfree(v); return NULL; }
            v->v = realloc(v->v, (size_t)(v->len + 1) * sizeof *v->v);
            v->v[v->len] = e;
            if (c == '{') {
                v->k = realloc(v->k, (size_t)(v->len + 1) * sizeof *v->k);
                v->k[v->len] = key;
            }
            v->len++;
            jws(p);
            if (**p == ',') { (*p)++; continue; }
            if (**p == close) { (*p)++; return v; }
            jfree(v);
            return NULL;
        }
    }
    if (c == '"') {
        char *s = jparse_str(p);
        if (!s) return NULL;
        jv *v = jnew('s');
        v->s = s;
        return v;
    }
    if (!strncmp(*p, "true", 4))  { *p += 4; jv *v = jnew('b'); v->n = 1; return v; }
    if (!strncmp(*p, "false", 5)) { *p += 5; return jnew('b'); }
    if (!strncmp(*p, "null", 4))  { *p += 4; return jnew('z'); }
    if (c == '-' || (c >= '0' && c <= '9')) {
        char *end;
        double d = strtod(*p, &end);
        if (end == *p) return NULL;
        jv *v = jnew('n');
        v->n = d;
        v->s = strndup(*p, (size_t)(end - *p));
        *p = end;
        return v;
    }
    return NULL;
}
static jv *jparse_all(const char *text) {
    if (!text) return NULL;
    const char *p = text;
    return jparse(&p, 0);
}
static jv *jget(const jv *o, const char *k) {
    if (!o || o->t != 'o') return NULL;
    for (int i = 0; i < o->len; i++) if (!strcmp(o->k[i], k)) return o->v[i];
    return NULL;
}
static const char *jgets(const jv *o, const char *k) {
    jv *v = jget(o, k);
    return v && v->t == 's' ? v->s : NULL;
}

// ------------------------------------------------------------- base64, URLs
static const char b64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
static void sb_b64(sb *b, const unsigned char *d, size_t n) {
    for (size_t i = 0; i < n; i += 3) {
        unsigned v = (unsigned)d[i] << 16 | (i + 1 < n ? (unsigned)d[i + 1] << 8 : 0) | (i + 2 < n ? d[i + 2] : 0);
        char t[4] = { b64[v >> 18 & 63], b64[v >> 12 & 63], i + 1 < n ? b64[v >> 6 & 63] : '=', i + 2 < n ? b64[v & 63] : '=' };
        sb_put(b, t, 4);
    }
}
static unsigned char *unb64(const char *s, size_t *n) {
    size_t len = strlen(s);
    unsigned char *out = malloc(len / 4 * 3 + 3);
    unsigned v = 0; int bits = 0; size_t k = 0;
    for (; *s; s++) {
        const char *q = strchr(b64, *s);
        int c = *s == '-' ? 62 : *s == '_' ? 63 : (q && *s ? (int)(q - b64) : -1);
        if (c < 0) continue;
        v = v << 6 | (unsigned)c; bits += 6;
        if (bits >= 8) { bits -= 8; out[k++] = (unsigned char)(v >> bits); }
    }
    *n = k;
    return out;
}
static void sb_urlseg(sb *b, const char *s) {   // a path: '/' and ':' kept, the rest percent-encoded
    for (const unsigned char *p = (const unsigned char *)s; *p; p++) {
        if ((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') || (*p >= '0' && *p <= '9') ||
            *p == '-' || *p == '.' || *p == '_' || *p == '~' || *p == '/' || *p == ':')
            sb_put(b, (const char *)p, 1);
        else
            sb_addf(b, "%%%02X", *p);
    }
}

// ------------------------------------------------------------- timestamps
static void sb_ts(sb *b, int64_t sec, int32_t nanos) {
    time_t t = (time_t)sec;
    struct tm tm;
    gmtime_r(&t, &tm);
    sb_addf(b, "\"%04d-%02d-%02dT%02d:%02d:%02d.%09dZ\"", tm.tm_year + 1900, tm.tm_mon + 1,
            tm.tm_mday, tm.tm_hour, tm.tm_min, tm.tm_sec, (int)nanos);
}
static int ts_parse(const char *s, int64_t *sec, int32_t *nanos) {
    int Y, M, D, h, m, x;
    if (!s || sscanf(s, "%d-%d-%dT%d:%d:%d", &Y, &M, &D, &h, &m, &x) != 6) return 0;
    struct tm tm = {0};
    tm.tm_year = Y - 1900; tm.tm_mon = M - 1; tm.tm_mday = D;
    tm.tm_hour = h; tm.tm_min = m; tm.tm_sec = x;
    int64_t t = (int64_t)timegm(&tm);
    int32_t ns = 0;
    const char *f = strchr(s, '.');
    const char *zone = s + strlen(s);
    if (f) {
        f++;
        int digits = 0;
        for (; *f >= '0' && *f <= '9'; f++)
            if (digits < 9) { ns = ns * 10 + (*f - '0'); digits++; }
        for (; digits < 9; digits++) ns *= 10;
        zone = f;
    } else {
        const char *T = strchr(s, 'T');
        zone = T ? T + 9 : zone;
    }
    if (zone && (*zone == '+' || *zone == '-')) {
        int zh = 0, zm = 0;
        if (sscanf(zone + 1, "%d:%d", &zh, &zm) >= 1) t -= (*zone == '+' ? 1 : -1) * (zh * 3600 + zm * 60);
    }
    *sec = t; *nanos = ns;
    return 1;
}

