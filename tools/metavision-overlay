static void *mv_fbapp_find(const char *name) {
    for (int i = 0; i < MV_FBAPP_MAX; i++)
        if (mv_fbapps[i] && strcmp(mv_fbapp_of(mv_fbapps[i])->name, name) == 0) return mv_fbapps[i];
    return NULL;
}
static klj_val mv_FbApp_initialize(const char *name, void *options) {
    pthread_mutex_lock(&mv_fbapps_lock);
    void *app = mv_fbapp_find(name);
    if (!app && mv_fbo_of(options)) {
        for (int i = 0; i < MV_FBAPP_MAX; i++) {
            if (mv_fbapps[i]) continue;
            mv_fbapp *d = calloc(1, sizeof *d);
            d->name = strdup(name);
            d->options = mv_fbo_new(MV_FBO_CLASS, mv_fbo_of(options));
            kl_jni_pin_object(d->options);
            d->collect = 1;
            app = kl_jni_new_object(MV_FBAPP_CLASS);
            klj_as_object(app)->data = d;
            kl_jni_pin_object(app);
            mv_fbapps[i] = app;
            break;
        }
    }
    pthread_mutex_unlock(&mv_fbapps_lock);
    KLJ_LOG("FirebaseApp.initializeApp(\"%s\") -> %s", name, app ? "app" : "null");
    return (klj_val){.l = app};
