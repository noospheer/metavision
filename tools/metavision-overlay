//
// A compressed audio sample buffer usually holds several AAC packets; each one
// is a sample of its own to the extractor, timed from the buffer's pts by the
// frames each packet carries. csd-0 comes out of the track's magic cookie (an
// esds ES_Descriptor, or a bare AudioSpecificConfig) and is built from the
// stream description when neither parses.
static int mv_a_is_aac(AVAssetTrack *t) {
    CMFormatDescriptionRef fmt = (__bridge CMFormatDescriptionRef)t.formatDescriptions.firstObject;
    if (!fmt) return 0;
    FourCharCode sub = CMFormatDescriptionGetMediaSubType(fmt);
    return sub == kAudioFormatMPEG4AAC || sub == kAudioFormatMPEG4AAC_HE ||
           sub == kAudioFormatMPEG4AAC_HE_V2;
}

static AVAssetTrack *mv_first_aac_track(AVAsset *asset) {
    __block NSArray<AVAssetTrack *> *all = nil;
    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
    [asset loadTracksWithMediaType:AVMediaTypeAudio
                 completionHandler:^(NSArray<AVAssetTrack *> *tracks, NSError *err) {
        (void)err;
        all = tracks;
        dispatch_semaphore_signal(sem);
    }];
    dispatch_semaphore_wait(sem, DISPATCH_TIME_FOREVER);
    for (AVAssetTrack *t in all)
        if (mv_a_is_aac(t)) return t;
    return nil;
}

static int mv_desc_len(const uint8_t *p, size_t n, size_t *o, size_t *len) {
    size_t l = 0;
    for (int i = 0; i < 4; i++) {
        if (*o >= n) return 0;
        uint8_t b = p[(*o)++];
        l = (l << 7) | (b & 0x7f);
        if (!(b & 0x80)) break;
    }
    *len = l;
    return 1;
}

static int mv_asc_from_cookie(const uint8_t *p, size_t n, uint8_t *asc, size_t cap,
                              size_t *asc_len) {
    if (!p || !n) return 0;
    if (n <= 16 && p[0] != 0x03 && p[0] != 0x00) {     // a bare AudioSpecificConfig
        if (n > cap) return 0;
        memcpy(asc, p, n); *asc_len = n;
        return 1;
    }
    size_t o = 0, len = 0;
    if (n > 4 && p[0] != 0x03 && p[4] == 0x03) o = 4;  // full-box version/flags first
    if (o >= n || p[o++] != 0x03 || !mv_desc_len(p, n, &o, &len)) return 0;
    if (o + 3 > n) return 0;
    o += 2;                                            // ES_ID
    uint8_t fl = p[o++];
    if (fl & 0x80) o += 2;                             // dependsOn_ES_ID
    if (fl & 0x40) { if (o >= n) return 0; o += 1 + p[o]; }   // URL
    if (fl & 0x20) o += 2;                             // OCR_ES_Id
    if (o >= n || p[o++] != 0x04 || !mv_desc_len(p, n, &o, &len)) return 0;
    o += 13;                                           // DecoderConfigDescriptor body
    if (o >= n || p[o++] != 0x05 || !mv_desc_len(p, n, &o, &len)) return 0;
    if (!len || len > cap || o + len > n) return 0;
    memcpy(asc, p + o, len); *asc_len = len;
    return 1;
}

static size_t mv_asc_synth(int rate, int ch, int obj, uint8_t *asc) {
    static const int rates[13] = { 96000, 88200, 64000, 48000, 44100, 32000, 24000,
                                   22050, 16000, 12000, 11025, 8000, 7350 };
    int idx = 4;
    for (int i = 0; i < 13; i++) if (rates[i] == rate) idx = i;
    asc[0] = (uint8_t)((obj << 3) | (idx >> 1));
    asc[1] = (uint8_t)(((idx & 1) << 7) | ((ch & 0xf) << 3));
    return 2;
}

static void mv_a_drop(kl_avdemux *m) {
    free(m->a_data); m->a_data = NULL;
    free(m->a_pk);   m->a_pk = NULL;
    m->a_npkt = m->a_pkt = 0;
}

static int mv_a_fill(kl_avdemux *m, CMSampleBufferRef sb) {
    CMBlockBufferRef bb = CMSampleBufferGetDataBuffer(sb);
    if (!bb) return 0;
    size_t len = CMBlockBufferGetDataLength(bb);
    CMItemCount n = CMSampleBufferGetNumSamples(sb);
    if (!len || n <= 0) return 0;
    unsigned char *data = malloc(len);
    struct mv_apk *pk = calloc((size_t)n, sizeof *pk);
    if (!data || !pk || CMBlockBufferCopyDataBytes(bb, 0, len, data) != noErr) {
        free(data); free(pk); return 0;
    }
    const AudioStreamPacketDescription *pd = NULL;
    size_t pdsz = 0;
    if (CMSampleBufferGetAudioStreamPacketDescriptionsPtr(sb, &pd, &pdsz) != noErr) pd = NULL;
    size_t npd = pd ? pdsz / sizeof *pd : 0;
    CMTime t0 = CMSampleBufferGetPresentationTimeStamp(sb);
    long long us0 = CMTIME_IS_VALID(t0) ? (long long)(CMTimeGetSeconds(t0) * 1e6) : 0;
    long long frames = 0;
    size_t next = 0;
    long k = 0;
    for (CMItemCount i = 0; i < n; i++) {
        size_t o, sz;
        if (npd == (size_t)n)  { o = (size_t)pd[i].mStartOffset; sz = pd[i].mDataByteSize; }
        else if (n == 1)       { o = 0; sz = len; }
        else                   { o = next; sz = CMSampleBufferGetSampleSize(sb, i); }
        if (!sz || o + sz > len) break;
        next = o + sz;
        long long us = us0 + frames * 1000000LL / m->a_rate;
        pk[k].off = o; pk[k].size = sz;
        pk[k].pts_us = us < 0 ? 0 : us;      // encoder priming: Unity refuses negative times
        frames += (npd == (size_t)n && pd[i].mVariableFramesInPacket)
                      ? pd[i].mVariableFramesInPacket : (UInt32)m->a_fpp;
        k++;
    }
    if (!k) { free(data); free(pk); return 0; }
    mv_a_drop(m);
    m->a_data = data; m->a_pk = pk; m->a_npkt = k; m->a_pkt = 0;
    return 1;
}

static void mv_a_pull(kl_avdemux *m) {
    @autoreleasepool {
        AVAssetReaderTrackOutput *out = (__bridge AVAssetReaderTrackOutput *)m->a_out;
        for (;;) {
            CMSampleBufferRef sb = out ? [out copyNextSampleBuffer] : NULL;
            if (!sb) { m->a_eos = 1; mv_a_drop(m); return; }
            int ok = mv_a_fill(m, sb);
            CFRelease(sb);
            if (ok) return;
        }
    }
}

static int mv_a_start(kl_avdemux *m, CMTime from) {
    @autoreleasepool {
        AVAsset *asset = (__bridge AVAsset *)m->asset;
        AVAssetTrack *track = (__bridge AVAssetTrack *)m->a_track;
        NSError *err = nil;
        AVAssetReader *r = [AVAssetReader assetReaderWithAsset:asset error:&err];
        if (!r) return 0;
        AVAssetReaderTrackOutput *o =
            [AVAssetReaderTrackOutput assetReaderTrackOutputWithTrack:track outputSettings:nil];
        o.alwaysCopiesSampleData = NO;
        if (![r canAddOutput:o]) return 0;
        [r addOutput:o];
        if (CMTIME_IS_VALID(from) && CMTimeGetSeconds(from) > 0)
            r.timeRange = CMTimeRangeMake(from, kCMTimePositiveInfinity);
        if (![r startReading]) return 0;
        if (m->a_reader) CFBridgingRelease(m->a_reader);
        if (m->a_out)    CFBridgingRelease(m->a_out);
        m->a_reader = (void *)CFBridgingRetain(r);
        m->a_out    = (void *)CFBridgingRetain(o);
        m->a_eos = 0;
        mv_a_drop(m);
        return 1;
    }
}

static void mv_a_close(kl_avdemux *m) {
    if (m->a_out)    CFBridgingRelease(m->a_out);
    if (m->a_reader) CFBridgingRelease(m->a_reader);
    if (m->a_track)  CFBridgingRelease(m->a_track);
    m->a_out = m->a_reader = m->a_track = NULL;
    m->a_on = 0;
    mv_a_drop(m);
}

static void mv_a_open(kl_avdemux *m) {
    if (!kl_env_on("MV_VIDEO_AUDIO", 1) || !m->asset) return;
    @autoreleasepool {
        AVAssetTrack *t = mv_first_aac_track((__bridge AVAsset *)m->asset);
        if (!t) return;
        CMAudioFormatDescriptionRef fmt =
            (__bridge CMAudioFormatDescriptionRef)t.formatDescriptions.firstObject;
        const AudioStreamBasicDescription *sd =
            fmt ? CMAudioFormatDescriptionGetStreamBasicDescription(fmt) : NULL;
        if (!sd || sd->mSampleRate <= 0 || !sd->mChannelsPerFrame) return;
        m->a_rate = (int)(sd->mSampleRate + 0.5);
        m->a_ch   = (int)sd->mChannelsPerFrame;
        m->a_fpp  = sd->mFramesPerPacket ? (int)sd->mFramesPerPacket : 1024;
        size_t cl = 0;
        const void *ck = CMAudioFormatDescriptionGetMagicCookie(fmt, &cl);
        const char *how = "from the cookie";
        if (!mv_asc_from_cookie(ck, cl, m->a_asc, sizeof m->a_asc, &m->a_asc_len)) {
            int obj = (sd->mFormatFlags >= 1 && sd->mFormatFlags <= 4) ? (int)sd->mFormatFlags : 2;
            m->a_asc_len = mv_asc_synth(m->a_rate, m->a_ch, obj, m->a_asc);
            how = "built from the stream description";
        }
        m->a_track = (void *)CFBridgingRetain(t);
        if (!mv_a_start(m, kCMTimeZero)) {
            fprintf(stderr, "  [avdemux] %s: audio reader would not start — video only\n", m->path);
            mv_a_close(m);
            return;
        }
        mv_a_pull(m);
        m->a_on = 1;
        fprintf(stderr, "  [avdemux] %s: audio/mp4a-latm %d Hz, %d ch, csd-0 %zu bytes (%s)\n",
                m->path, m->a_rate, m->a_ch, m->a_asc_len, how);
    }
}

int kl_avdemux_audio_info(kl_avdemux *m, int *rate, int *channels, long long *dur,
                          const unsigned char **asc, size_t *asc_len) {
    if (!m || !m->a_on) return 0;
    if (rate)     *rate = m->a_rate;
    if (channels) *channels = m->a_ch;
    if (dur)      *dur = m->duration_us;
    if (asc)      *asc = m->a_asc;
    if (asc_len)  *asc_len = m->a_asc_len;
    return 1;
}

long long kl_avdemux_audio_sample_time_us(kl_avdemux *m) {
    if (!m || !m->a_on || m->a_eos || m->a_pkt >= m->a_npkt) return -1;
    return m->a_pk[m->a_pkt].pts_us;
}

long kl_avdemux_audio_read(kl_avdemux *m, unsigned char *buf, unsigned long cap) {
    if (kl_avdemux_audio_sample_time_us(m) < 0) return -1;
    const struct mv_apk *k = &m->a_pk[m->a_pkt];
    if (buf && cap) memcpy(buf, m->a_data + k->off, k->size < cap ? k->size : cap);
    return (long)k->size;               // full size, AMediaExtractor convention
}

int kl_avdemux_audio_advance(kl_avdemux *m) {
    if (!m || !m->a_on || m->a_eos) return 0;
    if (++m->a_pkt >= m->a_npkt) mv_a_pull(m);
    return m->a_eos ? 0 : 1;
}

int kl_avdemux_audio_seek_us(kl_avdemux *m, long long us) {
    if (!m || !m->a_on) return 0;
    if (!mv_a_start(m, CMTimeMake(us, 1000000))) { m->a_eos = 1; return 0; }
    mv_a_pull(m);
    // The reader starts on the buffer holding `us`; begin at the packet that does.
    while (!m->a_eos && m->a_pkt + 1 < m->a_npkt && m->a_pk[m->a_pkt + 1].pts_us <= us)
        m->a_pkt++;
    return m->a_eos ? 0 : 1;
}

