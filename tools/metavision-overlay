// Cursors: from values, or from a snapshot (its values for the query's orders, then its name).
static klj_val fs_cursor(void *self, void *arg, int end, int before) {
    fs_query *q = fs_q_of(self);
    if (!q) { kl_jni_throw("java/lang/IllegalArgumentException"); RET(NULL); }
    mvfs *f;
    void *obj = fs_q_derive(self, &f);
    sb b = {0};
    sb_put(&b, "", 0);
    mvfs *snap = fs_of(arg, FS_DSNAP);
    int bad = 0;
    if (snap) {
        int k = 0;
        for (const char *p = q->order_paths; p && *p && !bad; k++) {
            const char *e = strchr(p, '\n');
            char *one = strndup(p, e ? (size_t)(e - p) : strlen(p));
            if (k) sb_put(&b, ",", 1);
            if (!strcmp(one, "__name__")) {
                sb_add(&b, "{\"referenceValue\":\"");
                sb_docname(&b, f->db, snap->path);
                sb_add(&b, "\"}");
            } else {
                // a plain dotted path (quoted segments are not split here)
                char *copy = strdup(one), *segs[64];
                int ns = 0;
                for (char *save = NULL, *t = strtok_r(copy, ".", &save); t && ns < 64; t = strtok_r(NULL, ".", &save)) segs[ns++] = t;
                int found;
                void *v = fs_walk(snap, segs, ns, &found);
                bad = fs_val_json(&b, v, f->db) < 0;
                free(copy);
            }
            free(one);
            p = e ? e + 1 : NULL;
        }
        if (!q->order_paths || !strstr(q->order_paths, "__name__")) {
            if (k) sb_put(&b, ",", 1);
            sb_add(&b, "{\"referenceValue\":\"");
            sb_docname(&b, f->db, snap->path);
            sb_add(&b, "\"}");
            f->q.name_order = 1;
        }
    } else {
        bad = fs_list_json(&b, arg, f->db) < 0;
    }
    if (bad) { free(b.p); kl_jni_throw("java/lang/IllegalArgumentException"); RET(NULL); }
    char **slot = end ? &f->q.end : &f->q.start;
    free(*slot);
    *slot = sb_take(&b);
    if (end) f->q.end_before = before; else f->q.start_before = before;
    RET(obj);
}
