        mvuh.fam = p->fam; mvuh.kind = p->kind; mvuh.touch = p->touch; mvuh.at = now + hold; mvuh.live = 1;
        snprintf(mvuh.what, sizeof mvuh.what, "%s", p->lab[0] ? p->lab : p->nm);
    }
    guard_at = now + 0.6;
    mvu_coverage(t);
}
