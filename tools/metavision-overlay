enum { FS_DB = 1, FS_SETTINGS, FS_SETB, FS_COLL, FS_DOC, FS_QUERY, FS_DSNAP, FS_QSNAP,
       FS_CHANGE, FS_META, FS_TASK, FS_CB, FS_EXC, FS_ENUM, FS_REG, FS_LISTENER, FS_TS,
       FS_BLOB, FS_GEO, FS_DOUBLE, FS_PATH, FS_FV, FS_SETOPT, FS_PLAIN, FS_RUNNABLE,
       FS_BATCH, FS_AGGQ, FS_AGGS, FS_TXO };

// A query's shape, copied and extended by every refinement.
typedef struct {
    char *coll;        // the collection path, or the collection id of a group query
    int   group;
    char *filters;     // ","-joined filter objects
    int   nfilters;
    char *order_paths; // "\n"-joined encoded field paths of the orderBy calls
    char *order_dirs;  // one 'A' or 'D' per order
    long long limit;
    int   last;        // limitToLast
    char *start, *end; // cursor values (the contents of "values":[...]), or NULL
    int   start_before, end_before;
    int   name_order;  // a snapshot cursor carries the document name: order by it too
} fs_query;

typedef struct {
    char   *db, *project, *appid, *host;
    int     ssl, persist, net;
    int64_t cache;
} fs_dbinfo;

typedef struct mvfs {
    int    kind;
    void  *db;            // the FirebaseFirestore it belongs to (pinned for ever)
    char  *path;          // DOC, COLL, DSNAP: the path below documents/
    fs_query q;           // QUERY, COLL, AGGQ
    fs_dbinfo *dbi;       // DB
    void **held; int nheld;
    int64_t a, b;         // CB: fn, data. LISTENER: C++ firestore, listener. TS: seconds, nanos.
                          // ENUM: ordinal. RUNNABLE: data. AGGS: count. EXC: code. TXO: attempts
    double  x, y;         // DOUBLE: value. GEO: latitude, longitude
    int     i, j, k;      // per kind (commented where used)
    char   *s, *s2;       // per kind
    unsigned char *bytes; size_t nbytes;   // BLOB; PATH: segments, NUL-separated (k of them)
    void  *o1, *o2, *o3;  // per kind; always also in held
    int    state;         // TASK: 0 pending, 1 succeeded, 2 failed, 3 cancelled
    void **cbs; int ncbs; // TASK: JniResultCallbacks waiting (held)
    void **deps; int ndeps; // TASK: continuation tasks (held)
} mvfs;

static pthread_mutex_t fs_lock = PTHREAD_MUTEX_INITIALIZER;
static pthread_cond_t  fs_cond = PTHREAD_COND_INITIALIZER;

static void fs_q_free(fs_query *q) {
    free(q->coll); free(q->filters); free(q->order_paths);
    free(q->order_dirs); free(q->start); free(q->end);
}
static void fs_free(void *p) {   // the payload, at recycle (its holds went at retire)
    mvfs *f = p;
    if (!f) return;
    free(f->path); fs_q_free(&f->q);
    free(f->held); free(f->cbs); free(f->deps);
    free(f->s); free(f->s2); free(f->bytes);
    free(f);
}
// java/util/ArrayList: a klj_list (what List.size/get/iterator read) whose items it holds.
static void fs_list_free(void *p) {
    klj_list *l = p;
    if (!l) return;
    free(l->items);
    free(l);
}
static void fs_box_free(void *p) { free(p); }

// Step 146 calls this as each object is retired (g_lock held): what a host
// object of this file held is let go.
void mv_fs_retire_locked(klj_object *o) {
    if (!o || !o->data) return;
    if (o->destroy == fs_free) {
        mvfs *f = o->data;
        for (int i = 0; i < f->nheld; i++) klj_release_locked(f->held[i]);
        for (int i = 0; i < f->ncbs; i++) klj_release_locked(f->cbs[i]);
        for (int i = 0; i < f->ndeps; i++) klj_release_locked(f->deps[i]);
        f->nheld = f->ncbs = f->ndeps = 0;
    } else if (o->destroy == fs_list_free) {
        // Retired once (its magic is gone), so released once. The items stay
        // listed: an iterator taken from a list the guest has already deleted
        // (the SDK iterates map.keySet().iterator() from a temporary) still
        // walks it, and its elements are still held by whoever else holds them.
        klj_list *l = o->data;
        for (int i = 0; i < l->count; i++) klj_release_locked(l->items[i]);
    }
}

static void *fs_new(const char *cls, int kind, mvfs **out) {
    mvfs *f = calloc(1, sizeof *f);
    f->kind = kind;
    void *obj = kl_jni_new_object(cls);
    klj_object *o = klj_as_object(obj);
    o->data = f;
    o->destroy = fs_free;
    if (out) *out = f;
    return obj;
}
static mvfs *fs_of(void *obj, int kind) {
    klj_object *o = klj_as_object(obj);
    if (!o || o->destroy != fs_free || !o->data) return NULL;
    mvfs *f = o->data;
    return !kind || f->kind == kind ? f : NULL;
}
static void fs_hold_in(mvfs *f, void *obj) {   // f keeps obj
    if (!obj) return;
    klj_hold(obj);
    f->held = realloc(f->held, (size_t)(f->nheld + 1) * sizeof *f->held);
    f->held[f->nheld++] = obj;
}
static int fs_is_class_obj(void *self) {
    klj_object *o = klj_as_object(self);
    return o && strcmp(o->cls, KLJ_CLASS_CLASS) == 0;
}
static const char *fs_cls(void *obj) {
    klj_object *o = klj_as_object(obj);
    return o ? o->cls : "";
}
static klj_array *fs_arr(void *obj, char kind) {   // a Java array of that kind, or NULL
    klj_object *o = klj_as_object(obj);
    klj_array *arr = o && o->cls[0] == '[' ? o->data : NULL;
    return arr && arr->kind == kind ? arr : NULL;
}

// --- lists
static void *fs_list_new(void) {
    klj_list *l = calloc(1, sizeof *l);
    void *obj = kl_jni_new_object(C_LIST);
