static void *fs_enum_objs[EN_N][18];
static void *fs_enum(int e, int ord) {
    if (e < 0 || e >= EN_N || ord < 0 || ord >= 18 || !fs_enums[e].names[ord]) return NULL;
    pthread_mutex_lock(&fs_lock);
    void *obj = fs_enum_objs[e][ord];
