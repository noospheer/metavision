        obj = fs_new(fs_enums[e].cls, FS_ENUM, &f);
        f->a = ord;
        f->i = e;
        kl_jni_pin_object(obj);
        fs_enum_objs[e][ord] = obj;
    }
    pthread_mutex_unlock(&fs_lock);
    return obj;
}
