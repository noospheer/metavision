        d->ssl = s->i; d->persist = s->j; d->cache = s->a;
        pthread_mutex_unlock(&fs_lock);
        if (strcmp(d->host, "firestore.googleapis.com")) KLJ_LOG("Firestore: host set to %s (ssl %d)", d->host, d->ssl);
