    }
    mvud[p->di].tries++; mvud[p->di].last = now;
    fprintf(stderr, "[mv-autoplay-ui] t=%.1fs pressed '%s' (%s %s go=%s via %s, try %u, %u candidates, %u skipped)\n",
            t, p->lab[0] ? p->lab : p->nm, mvu_fam[p->fam], p->kn, p->nm, how, mvud[p->di].tries, nc, nskip);
