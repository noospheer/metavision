    s = sub(s, "static void klfb_ShaderSource(uint32_t shader, int32_t count,\n",
        "// " + marker + "\n"
        "#include <float.h>\n"
        "static int mv_ident_char(char c) {\n"
        "    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||\n"
        "           c == '_' || c == '.';\n"
        "}\n"
        "static int mv_rewrite_denorms(char *buf, size_t cap, uint32_t shader) {\n"
        "    const char *v = strstr(buf, \"#version \");\n"
        "    if (!v || v[9] < '3' || v[9] > '9' || !strstr(v, \" es\")) return 0;   // ESSL 3.00+\n"
        "    int n = 0;\n"
        "    size_t len = strlen(buf);\n"
        "    for (size_t i = 0; i < len; i++) {\n"
        "        char c = buf[i];\n"
        "        if (!((c >= '0' && c <= '9') || c == '.')) continue;\n"
        "        if (i > 0 && mv_ident_char(buf[i - 1])) continue;   // inside a name or number\n"
        "        size_t j = i, e = 0;\n"
        "        while (j < len && ((buf[j] >= '0' && buf[j] <= '9') || buf[j] == '.')) j++;\n"
        "        if (j < len && (buf[j] == 'e' || buf[j] == 'E')) {\n"
        "            e = j++;\n"
        "            if (j < len && (buf[j] == '-' || buf[j] == '+')) j++;\n"
        "            while (j < len && buf[j] >= '0' && buf[j] <= '9') j++;\n"
        "        }\n"
        "        size_t end = j;\n"
        "        if (end < len && (buf[end] == 'f' || buf[end] == 'F')) end++;\n"
        "        if (!e || (end < len && mv_ident_char(buf[end]))) { i = j; continue; }\n"
        "        char tok[64];\n"
        "        if (j - i >= sizeof tok) { i = j; continue; }\n"
        "        memcpy(tok, buf + i, j - i); tok[j - i] = 0;\n"
        "        float f = strtof(tok, NULL);\n"
        "        if (f == 0.0f || fabsf(f) >= FLT_MIN) { i = j; continue; }\n"
        "        // A leading minus that is a sign (not subtraction) goes into the bits.\n"
        "        size_t from = i;\n"
