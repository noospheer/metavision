    } while (0)

    // umg: buttons, check boxes, sliders and combo boxes shown with a listener
    static const struct { int c, k; const char *name; int p[3]; } kinds[4] = {
        { C_BUTTON, K_BUTTON, "Button",         { P_B_CLICK, P_B_PRESS, P_B_REL } },
        { C_CHECK,  K_CHECK,  "CheckBox",       { P_CHECK, -1, -1 } },
        { C_SLIDER, K_SLIDER, "Slider",         { P_SLIDE, -1, -1 } },
        { C_COMBO,  K_COMBO,  "ComboBoxString", { P_COMBO, -1, -1 } },
    };
    for (int k = 0; k < 4; k++) {
        unsigned n = mvu_all(kinds[k].c, buf, MVU_BUF);
        nw[k] = n;
        for (unsigned i = 0; i < n && nc < MVU_CAND; i++) {
            void *w = buf[i];
            int any = 0;
            for (int j = 0; j < 3; j++) if (kinds[k].p[j] >= 0 && mvu_bound(w, kinds[k].p[j])) any = 1;
            if (!any || !mvu_shown(w, roots, nr)) continue;
