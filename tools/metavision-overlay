    }
    unsigned nwi = mvu_all(C_WINTER, buf, MVU_BUF);

    #define ADD(obj, press_, fam_, kind_, kn_) do {                                          \
        mvu_cand *x_ = &c[nc]; memset(x_, 0, sizeof *x_);                                    \
        x_->o = (obj); x_->press = (press_); x_->fam = (uint8_t)(fam_); x_->kind = (uint8_t)(kind_); \
        snprintf(x_->kn, sizeof x_->kn, "%s", (kn_));                                        \
        found[fam_]++;                                                                       \
        int di_ = mvud_get(x_->o, fam_);                                                     \
        if (di_ < 0) break;                                                                  \
        x_->di = (int16_t)di_;                                                               \
        if (mvud[di_].unsafe_) { nskip++; break; }                                           \
        if (mvud[di_].tries >= maxt || (mvud[di_].tries && now - mvud[di_].last < gap)) break; \
        mvu_names(x_, ev_, sizeof ev_);                                                      \
        x_->lang = mvu_lang(x_->lab, x_->nm);                                                \
        if (mv_unsafe(x_->lab) || mv_unsafe(x_->nm) || mv_unsafe(x_->kn) || ev_[0]) {        \
            if ((fam_) == MVU_UMG && guard) {                                                \
