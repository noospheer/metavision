static void mv_fmt_set_blob(klm_format *f, const char *key, const void *p, size_t n) {
    if (!f || !key || !p || !n) return;
    int i = klm_fmt_slot(f, key);
    if (i < 0) return;
    char *b = malloc(n);
    if (!b) return;
    memcpy(b, p, n);
    free(f->kv[i].sval);
    f->kv[i].sval = b;
    f->kv[i].ival = (int32_t)n;
    f->kv[i].is_str = 2;
}
static int mv_fmt_blob(klm_format *f, const char *key, const uint8_t **p, size_t *n) {
    if (!f) return 0;
    for (int i = 0; i < f->n; i++)
        if (!strcmp(f->kv[i].key, key) && f->kv[i].is_str == 2) {
            *p = (const uint8_t *)f->kv[i].sval;
            *n = (size_t)f->kv[i].ival;
