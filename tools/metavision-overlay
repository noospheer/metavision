}
static void *fs_settings_new(const char *cls, int kind, fs_dbinfo *from) {
    mvfs *s;
    void *obj = fs_new(cls, kind, &s);
    s->s = strdup(from && from->host ? from->host : "firestore.googleapis.com");
    s->i = from ? from->ssl : 1;
    s->j = from ? from->persist : 1;
    s->a = from ? from->cache : 100 * 1024 * 1024;
    return obj;
}
B(fs_FF_getSettings) { (void)env; (void)a; (void)n; RET(fs_settings_new(C_SET, FS_SETTINGS, fs_dbi(self))); }
B(fs_FF_setSettings) {
