#define MVU_CAND 256
#define MVU_BUF 8192
void kl_mprobe_ue4_tick(void) {
    static int on = -1, bound, guard;
    static double t0, first, next, every, hold, gap, guard_at;
    static unsigned maxt;
    static kl_image *im;
    if (!on) return;
    if (on < 0) {
        im = kl_find_image("libUE4.so");
        if (!im || !kl_env_on("MV_AUTOPLAY_UI", kl_env_on("MV_AUTOPLAY", 0))) { on = 0; return; }   // not an Unreal title, or not a test run
        every = kl_env_uint("MV_AUTOPLAY_UI_EVERY", 4); if (!every) every = 4;
        hold  = kl_env_uint("MV_AUTOPLAY_UI_HOLD_MS", 300) / 1000.0;
        gap   = kl_env_uint("MV_AUTOPLAY_UI_GAP", 12);
        maxt  = kl_env_uint("MV_AUTOPLAY_UI_MAX", 3);
        guard = kl_env_on("MV_AUTOPLAY_UI_GUARD", 1);
