    }
    case K_ACTOR: {
        mvu_key k; memset(&k, 0, sizeof k); memcpy(k.b, ue.lmb, 8);   // EKeys::LeftMouseButton's name, no details
        ue.over(NULL, p->press); ue.clicked(p->press, &k);
