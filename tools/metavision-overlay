static klj_val avp_s_reset(void *env, void *self, const klj_val *a, int n) {
    (void)env; (void)self; (void)a; (void)n;
    // A new context: every player's GL objects again (the old names died with it).
    for (int i = 0; i < AVP_MAX; i++) {
        avp *p = avp_at(i);
        if (!p) continue;
        pthread_mutex_lock(&p->lk);
        p->oes_tex = p->rgba_tex = p->fbo = 0;
        p->rgba_w = p->rgba_h = 0;
        p->gl_setup = 0;
        p->want_target = p->has_video;
        pthread_mutex_unlock(&p->lk);
        avp_render_setup(p);
    }
    return (klj_val){0};
}

