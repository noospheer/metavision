            line[strcspn(line, "\r\n")] = '\0';
            if (!*line || kl_guard_listed_locked(line)) continue;
            g_guard_refused[g_guard_nrefused++] = strdup(line);
            fprintf(stderr, "  [dl] %s refused: it killed an earlier launch during load "
                            "(KL_DLOPEN_GUARD_RESET=1 retries it)\n", line);
