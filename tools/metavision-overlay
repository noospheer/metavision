}
static void fs_list_add(void *list, void *item) {
    klj_object *o = klj_as_object(list);
    if (!o || o->destroy != fs_list_free) return;
    klj_list *l = o->data;
    if (item) klj_hold(item);
    l->items = realloc(l->items, (size_t)(l->count + 1) * sizeof *l->items);
    l->items[l->count++] = item;
}

// --- boxes, in the runtime's own shape (klj_pref), so its accessors unbox them
static void *fs_box(const char *cls, char kind, int64_t v) {
