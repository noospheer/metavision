static fs_query *fs_q_of(void *obj) {
    mvfs *f = fs_of(obj, 0);
    return f && (f->kind == FS_QUERY || f->kind == FS_COLL || f->kind == FS_AGGQ) ? &f->q : NULL;
}
static void fs_q_copy(fs_query *d, const fs_query *s) {
    d->coll = fs_strdup(s->coll); d->group = s->group;
    d->filters = fs_strdup(s->filters); d->nfilters = s->nfilters;
    d->order_paths = fs_strdup(s->order_paths); d->order_dirs = fs_strdup(s->order_dirs);
    d->limit = s->limit; d->last = s->last;
    d->start = fs_strdup(s->start); d->end = fs_strdup(s->end);
    d->start_before = s->start_before; d->end_before = s->end_before;
    d->name_order = s->name_order;
}
static void *fs_q_derive(void *from, mvfs **out) {
    mvfs *src = fs_of(from, 0);
    mvfs *f;
    void *obj = fs_new(C_QUERY, FS_QUERY, &f);
    f->db = src ? src->db : NULL;
    fs_query *q = fs_q_of(from);
    if (q) fs_q_copy(&f->q, q);
    *out = f;
    return obj;
}
static void fs_append(char **list, const char *sep, const char *item) {
    sb b = {0};
    if (*list) { sb_add(&b, *list); sb_add(&b, sep); }
    sb_add(&b, item);
    free(*list);
    *list = sb_take(&b);
}
// A where-clause value: a document id string against __name__ means that document.
static int fs_filter_value(sb *b, fs_query *q, mvfs *path, void *v, void *db) {
    if (path->i && v && !strcmp(fs_cls(v), KLJ_CLASS_STRING) && !q->group) {
        char *p = fs_join(q->coll, klj_str(v));
        sb_add(b, "{\"referenceValue\":\"");
        sb_docname(b, db, p);
        sb_add(b, "\"}");
        free(p);
        return 0;
    }
    return fs_val_json(b, v, db);
}
static klj_val fs_where(void *self, void *fp, void *v, const char *op, int list) {
    fs_query *q = fs_q_of(self);
    mvfs *path = fs_of(fp, FS_PATH);
    if (!q || !path) { kl_jni_throw("java/lang/IllegalArgumentException"); RET(NULL); }
    mvfs *f;
    void *obj = fs_q_derive(self, &f);
    sb b = {0};
    int isnull = !v, isnan = 0;
    mvfs *dv = fs_of(v, FS_DOUBLE);
    if (dv && isnan(dv->x)) isnan = 1;
    int eq = !strcmp(op, "EQUAL"), ne = !strcmp(op, "NOT_EQUAL");
    if (!list && (isnull || isnan) && (eq || ne)) {
        sb_add(&b, "{\"unaryFilter\":{\"op\":\"");
        sb_add(&b, isnull ? (eq ? "IS_NULL" : "IS_NOT_NULL") : (eq ? "IS_NAN" : "IS_NOT_NAN"));
        sb_add(&b, "\",\"field\":{\"fieldPath\":");
        sb_jstr(&b, path->s);
        sb_add(&b, "}}}");
    } else {
        sb_add(&b, "{\"fieldFilter\":{\"field\":{\"fieldPath\":");
        sb_jstr(&b, path->s);
        sb_add(&b, "},\"op\":\"");
        sb_add(&b, op);
        sb_add(&b, "\",\"value\":");
        int bad;
        if (list) {
            sb_add(&b, "{\"arrayValue\":{\"values\":[");
            klj_list *l = fs_list_of(v);
            bad = !l;
            for (int i = 0; l && i < l->count && !bad; i++) {
                if (i) sb_put(&b, ",", 1);
                bad = fs_filter_value(&b, q, path, l->items[i], f->db) < 0;
            }
            sb_add(&b, "]}}");
        } else bad = fs_filter_value(&b, q, path, v, f->db) < 0;
        sb_add(&b, "}}");
        if (bad) {
            free(b.p);
            KLJ_LOG("Firestore: where() with a value Firestore cannot compare -> IllegalArgumentException");
            kl_jni_throw("java/lang/IllegalArgumentException");
            RET(NULL);
        }
    }
    fs_append(&f->q.filters, ",", b.p);
    f->q.nfilters++;
    free(b.p);
    RET(obj);
}
