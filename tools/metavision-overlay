    // the candidates' objects stay reachable for the whole tick.
    mv_cand c[MV_CAND];
    unsigned nc = 0, nskip = 0, found[MVF_N] = { 0 }, trig = 0;
    char skip[96] = "";
    #define ADD(obj, fam_, kind_) do {                                                     \
        mv_cand *x_ = &c[nc]; x_->o = (obj); x_->fam = (uint8_t)(fam_); x_->kind = (kind_); \
        mv_names(x_->o, x_->lab, sizeof x_->lab, x_->go, sizeof x_->go);                   \
        x_->id = mv_id(x_->o); found[fam_]++;                                              \
        int di_ = mvd_get(x_->id, fam_);                                                   \
        if (di_ < 0) break;                                                                \
        x_->di = (int16_t)di_;                                                             \
        if (mv_unsafe(x_->lab) || mv_unsafe(x_->go)) {                                     \
            mvd[di_].unsafe_ = 1; nskip++;                                                 \
            snprintf(skip, sizeof skip, "%s", x_->lab[0] ? x_->lab : x_->go); break;       \
        }                                                                                  \
        if (mvd[di_].tries >= maxt || (mvd[di_].tries && now - mvd[di_].last < gap)) break; \
        nc++;                                                                              \
    } while (0)

    // ui: Unity UI's own list, as step 52, plus a title's own Selectables
