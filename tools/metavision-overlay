// The image's PT_TLS, once.
static mv_tls_mod *mv_tls_module(kl_image *img) {
    static struct { kl_image *img; mv_tls_mod *mod; } seen[64];
    static unsigned n;
    for (unsigned i = 0; i < n; i++) if (seen[i].img == img) return seen[i].mod;
    unsigned phn = 0;
    const Elf64_Phdr *ph = kl_phdrs(img, &phn);
    for (unsigned i = 0; ph && i < phn; i++) {
        if (ph[i].p_type != 7 /* PT_TLS */) continue;
        mv_tls_mod *m = calloc(1, sizeof *m);
        if (!m || pthread_key_create(&m->key, free) != 0) return NULL;
        m->init = img->base + ph[i].p_vaddr;
        m->filesz = ph[i].p_filesz;
        m->memsz = ph[i].p_memsz;
        m->align = ph[i].p_align;
        if (n < 64) { seen[n].img = img; seen[n].mod = m; n++; }
        return m;
    }
    return NULL;
}

