// metavision: TLSDESC — a module's TLS block per thread, and the descriptor resolver.
typedef struct { pthread_key_t key; const uint8_t *init; size_t filesz, memsz, align; } mv_tls_mod;
typedef struct { mv_tls_mod *mod; uint64_t off; } mv_tls_arg;

void *mv_tlsdesc_addr(mv_tls_arg *a);
void *mv_tlsdesc_addr(mv_tls_arg *a) {
    mv_tls_mod *m = a->mod;
    uint8_t *b = pthread_getspecific(m->key);
    if (!b) {
        size_t al = m->align < 16 ? 16 : m->align;
        void *p = NULL;
        if (posix_memalign(&p, al, m->memsz ? m->memsz : 1) != 0) abort();
        b = p;
        if (m->filesz) memcpy(b, m->init, m->filesz);
        if (m->memsz > m->filesz) memset(b + m->filesz, 0, m->memsz - m->filesz);
        pthread_setspecific(m->key, b);
    }
    return b + a->off;
}

