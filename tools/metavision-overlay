// Through the guest's own GL door (kl_egl_sym), so whatever the runtime
// tracks about GL objects and bindings sees these calls as well.
static int avp_gl_load(void) {
    if (G.tried) return G.ok;
    G.tried = 1;
    int ok = 1;
#define GR(n) do { *(void **)&G.n = kl_egl_sym("gl" #n); if (!G.n) ok = 0; } while (0)
    GR(GenTextures); GR(DeleteTextures); GR(BindTexture); GR(TexParameteri); GR(TexStorage2D);
    GR(GenFramebuffers); GR(DeleteFramebuffers); GR(BindFramebuffer); GR(FramebufferTexture2D);
    GR(CheckFramebufferStatus); GR(Viewport); GR(GetIntegerv); GR(GetBooleanv); GR(IsEnabled);
    GR(Enable); GR(Disable); GR(ColorMask); GR(ActiveTexture); GR(BindSampler); GR(CreateShader);
    GR(ShaderSource); GR(CompileShader); GR(GetShaderiv); GR(GetShaderInfoLog); GR(DeleteShader);
    GR(CreateProgram); GR(AttachShader); GR(LinkProgram); GR(GetProgramiv); GR(DeleteProgram);
    GR(UseProgram); GR(GetUniformLocation); GR(Uniform1i); GR(UniformMatrix4fv);
    GR(GenVertexArrays); GR(BindVertexArray); GR(DrawArrays);
#undef GR
    G.ok = ok;
    if (!ok) KLJ_LOG("video plugin: GL entry points missing — no video texture");
    return ok;
}

static const char avp_vs[] =
    "#version 300 es\n"
    "uniform mat4 u_m;\n"
    "out vec2 v_uv;\n"
    "void main() {\n"
    "    vec2 p = vec2(float(gl_VertexID & 1), float(gl_VertexID >> 1));\n"
    "    v_uv = (u_m * vec4(p, 0.0, 1.0)).xy;\n"
    "    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
    "}\n";
static const char avp_fs[] =
    "#version 300 es\n"
    "precision mediump float;\n"
    "uniform sampler2D u_tex;\n"
    "in vec2 v_uv;\n"
    "out vec4 o;\n"
    "void main() { o = texture(u_tex, v_uv); }\n";

static uint32_t avp_shader(uint32_t kind, const char *src) {
    uint32_t s = G.CreateShader(kind);
    G.ShaderSource(s, 1, &src, NULL);
    G.CompileShader(s);
    int32_t ok = 0;
    G.GetShaderiv(s, GL_COMPILE_STATUS_, &ok);
    if (!ok) {
        char log[512] = "";
        G.GetShaderInfoLog(s, sizeof log, NULL, log);
        KLJ_LOG("video plugin: blit shader did not compile: %s", log);
        G.DeleteShader(s);
        return 0;
    }
    return s;
}
static int avp_prog(void) {
    if (G.prog) return 1;
    if (G.prog_failed || !avp_gl_load()) return 0;
    uint32_t vs = avp_shader(GL_VERTEX_SHADER_, avp_vs), fs = avp_shader(GL_FRAGMENT_SHADER_, avp_fs);
    uint32_t p = (vs && fs) ? G.CreateProgram() : 0;
    int32_t ok = 0;
    if (p) {
        G.AttachShader(p, vs);
        G.AttachShader(p, fs);
        G.LinkProgram(p);
        G.GetProgramiv(p, GL_LINK_STATUS_, &ok);
    }
    if (vs) G.DeleteShader(vs);
    if (fs) G.DeleteShader(fs);
    if (!ok) {
        if (p) G.DeleteProgram(p);
        G.prog_failed = 1;
        KLJ_LOG("video plugin: blit program did not link — the RGBA path shows nothing");
        return 0;
    }
    G.prog = p;
    G.u_m = G.GetUniformLocation(p, "u_m");
    G.u_tex = G.GetUniformLocation(p, "u_tex");
    G.GenVertexArrays(1, &G.vao);   // empty: the quad comes from gl_VertexID
    return 1;
}

static void avp_tex_params(uint32_t tex) {
    int32_t prev = 0;
    G.GetIntegerv(GL_TEXTURE_BINDING_2D_, &prev);
    G.BindTexture(GL_TEXTURE_2D_, tex);
    G.TexParameteri(GL_TEXTURE_2D_, GL_TEXTURE_MIN_FILTER_, GL_LINEAR_);
    G.TexParameteri(GL_TEXTURE_2D_, GL_TEXTURE_MAG_FILTER_, GL_LINEAR_);
    G.TexParameteri(GL_TEXTURE_2D_, GL_TEXTURE_WRAP_S_, GL_CLAMP_TO_EDGE_);
    G.TexParameteri(GL_TEXTURE_2D_, GL_TEXTURE_WRAP_T_, GL_CLAMP_TO_EDGE_);
    G.BindTexture(GL_TEXTURE_2D_, (uint32_t)prev);
}

